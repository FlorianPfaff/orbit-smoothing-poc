<?xml version="1.0" encoding="UTF-8" ?>
<groops>
	<global>
		<time label="timeStart">58849</time>
		<time label="timeEnd">timeStart+2</time>
		<filename label="groopsDataDir">/itsg/groops/data</filename>
	</global>
	<program comment="daily">
		<LoopPrograms>
			<loop>
				<timeIntervals>
					<timeIntervals>
						<uniformSampling>
							<timeStart link="timeStart"/>
							<timeEnd link="timeEnd"/>
							<sampling>1</sampling>
						</uniformSampling>
					</timeIntervals>
					<variableLoopTimeStart>loopTime</variableLoopTimeStart>
					<variableLoopTimeEnd>loopTimeEnd</variableLoopTimeEnd>
				</timeIntervals>
			</loop>
			<continueAfterError>0</continueAfterError>
			<processCountPerIteration>0</processCountPerIteration>
			<parallelLog>1</parallelLog>
			<program comment="data/{loopTime:%D}/gracefo">
				<FileCreateDirectories>
					<directory>data/{loopTime:%D}/gracefo</directory>
				</FileCreateDirectories>
			</program>
			<program comment="data/{loopTime:%D}/gracefo/gracefo1_variational_{loopTime:%D}.dat">
				<PreprocessingVariationalEquation>
					<outputfileVariational>data/{loopTime:%D}/gracefo/gracefo1_variational_{loopTime:%D}.dat</outputfileVariational>
					<inputfileSatelliteModel>{groopsDataDir}/satelliteModel/gracefo1_satelliteModel.xml</inputfileSatelliteModel>
					<inputfileOrbit>data/{loopTime:%D}/gracefo/gracefo1_orbit_{loopTime:%D}.dat</inputfileOrbit>
					<inputfileStarCamera>data/{loopTime:%D}/gracefo/gracefo1_starCamera_{loopTime:%D}.dat</inputfileStarCamera>
					<forces>
						<gravityfield>
							<potentialCoefficients>
								<inputfilePotentialCoefficients>{groopsDataDir}/potential/goco06s/GOCO06s_static_2010-01-01.gfc</inputfilePotentialCoefficients>
								<minDegree>0</minDegree>
								<maxDegree>120</maxDegree>
								<factor>1.0</factor>
								<setSigmasToZero>0</setSigmasToZero>
							</potentialCoefficients>
						</gravityfield>
						<tides>
							<astronomicalTide>
								<useMoon>1</useMoon>
								<useSun>1</useSun>
								<usePlanets>1</usePlanets>
								<useEarth>1</useEarth>
								<c20Earth>-4.84166854896119e-04</c20Earth>
								<factor>1.0</factor>
							</astronomicalTide>
						</tides>
						<tides>
							<earthTide>
								<inputfileEarthtide>{groopsDataDir}/tides/earthAnelastic2003.xml</inputfileEarthtide>
								<includePermanentTide>0</includePermanentTide>
								<factor>1.0</factor>
							</earthTide>
						</tides>
						<tides>
							<doodsonHarmonicTide>
								<inputfileTides>{groopsDataDir}/tides/oceanTide_fes2014b_n180_version20170520.dat</inputfileTides>
								<inputfileAdmittance>{groopsDataDir}/tides/oceanTide_fes2014b_admittance_linear_linear.txt</inputfileAdmittance>
								<minDegree>2</minDegree>
								<nodeCorr>0</nodeCorr>
								<factor>1.0</factor>
							</doodsonHarmonicTide>
						</tides>
						<miscAccelerations>
							<relativisticEffect>
								<beta>1.0</beta>
								<gamma>1.0</gamma>
								<J>9.8e8</J>
								<GM>3.986004415e+14</GM>
								<factor>1.0</factor>
							</relativisticEffect>
						</miscAccelerations>
						<miscAccelerations>
							<atmosphericDrag>
								<thermosphere>
									<jb2008>
										<inputfileSolfsmy>{groopsDataDir}/thermosphere/jb2008/SOLFSMY.TXT</inputfileSolfsmy>
										<inputfileDtc>{groopsDataDir}/thermosphere/jb2008/DTCFILE.TXT</inputfileDtc>
										<inputfileMagnetic3hAp>{groopsDataDir}/thermosphere/hwm14/apActivity.txt</inputfileMagnetic3hAp>
										<hwm14DataDirectory>{groopsDataDir}/thermosphere/hwm14</hwm14DataDirectory>
									</jb2008>
								</thermosphere>
								<earthRotation>7.29211585531e-5</earthRotation>
								<considerTemperature>1</considerTemperature>
								<considerWind>1</considerWind>
								<factor>1.0</factor>
							</atmosphericDrag>
						</miscAccelerations>
						<miscAccelerations>
							<radiationPressure>
								<solarflux>1367</solarflux>
								<eclipse>
									<conical/>
								</eclipse>
								<inputfileAlbedoTimeSeries>{groopsDataDir}/earthRadiationPressure/CERES_SYN1deg_albedo_climatology.dat</inputfileAlbedoTimeSeries>
								<inputfileLongwaveFluxTimeSeries>{groopsDataDir}/earthRadiationPressure/CERES_SYN1deg_longwaveFlux_climatology.dat</inputfileLongwaveFluxTimeSeries>
								<factorSolarRadation>1.0</factorSolarRadation>
								<factorEarthRadation>1.0</factorEarthRadation>
								<factorThermalRadiation>1.0</factorThermalRadiation>
							</radiationPressure>
						</miscAccelerations>
					</forces>
					<earthRotation>
						<file>
							<inputfileEOP>{groopsDataDir}/earthRotation/timeSeries_EOP_rapid_IAU2000_desai.dat</inputfileEOP>
							<interpolationDegree>3</interpolationDegree>
						</file>
					</earthRotation>
					<ephemerides>
						<jpl>
							<inputfileEphemerides>{groopsDataDir}/tides/ephemerides_JPL_DE432.dat</inputfileEphemerides>
							<origin>
								<earth/>
							</origin>
						</jpl>
					</ephemerides>
					<gradientfield>
						<potentialCoefficients>
							<inputfilePotentialCoefficients>{groopsDataDir}/potential/goco06s/GOCO06s_static_2010-01-01.gfc</inputfilePotentialCoefficients>
							<minDegree>0</minDegree>
							<maxDegree>10</maxDegree>
							<factor>1.0</factor>
							<setSigmasToZero>0</setSigmasToZero>
						</potentialCoefficients>
					</gradientfield>
					<integrationDegree>7</integrationDegree>
					<useEnke>
						<GM>3.986004415e+14</GM>
					</useEnke>
				</PreprocessingVariationalEquation>
			</program>
			<program comment="data/{loopTime:%D}/gracefo/gracefo1_variational_{loopTime:%D}.dat">
				<PreprocessingVariationalEquationOrbitFit>
					<outputfileVariational>data/{loopTime:%D}/gracefo/gracefo1_variational_{loopTime:%D}.dat</outputfileVariational>
					<inputfileVariational>data/{loopTime:%D}/gracefo/gracefo1_variational_{loopTime:%D}.dat</inputfileVariational>
					<inputfileOrbit>data/{loopTime:%D}/gracefo/gracefo1_orbit_{loopTime:%D}.dat</inputfileOrbit>
					<ephemerides>
						<jpl>
							<inputfileEphemerides>{groopsDataDir}/tides/ephemerides_JPL_DE432.dat</inputfileEphemerides>
							<origin>
								<earth/>
							</origin>
						</jpl>
					</ephemerides>
					<stochasticPulse>
						<uniformSampling>
							<timeStart>loopTime+20/1440</timeStart>
							<timeEnd>loopTimeEnd-20/1440</timeEnd>
							<sampling>20/1440</sampling>
						</uniformSampling>
					</stochasticPulse>
					<integrationDegree>7</integrationDegree>
					<interpolationDegree>7</interpolationDegree>
					<iterationCount>10</iterationCount>
				</PreprocessingVariationalEquationOrbitFit>
			</program>
		</LoopPrograms>
	</program>
</groops>
