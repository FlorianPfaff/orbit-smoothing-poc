+def wide_tangent_closure_failure_evidence(log, execution, previous_states, *, derivative_profile):
+    """Recognize the measured returned-state residual exhaustion, not arbitrary errors.
+
+    This exact native binary's physical-correction solver uses tolerance 2e-12
+    and 120 iterations. Its failed result is never accepted. A typed exception
+    is recoverable only within minimize's candidate evaluation; the same error
+    at initialization, confirmation or covariance remains fatal. The terminal
+    receipt does not identify ill-conditioning versus an arithmetic floor.
+    """
+    if (derivative_profile != "synthetic_complete_v1" or not isinstance(execution, dict)
+            or type(execution.get("returncode")) is not int or execution["returncode"] != 1
+            or execution.get("timed_out") is not False or previous_states is None
+            or execution.get("native_binary_sha256") !=
+               "28c725765201e4702875ec8407d3bc497aa4bdfa3092a305b15a3233cfbd675d"
+            or not isinstance(log, str) or len(log) > 65536):
+        return None
+    lines = [line.strip() for line in re.sub(r"\x1b\[[0-9;]*m", "", log).splitlines() if line.strip()]
+    if (len(lines) < 4 or lines[0] != "=== Starting GROOPS ==="
+            or lines[-1] != "=== Finished GROOPS with error ==="
+            or lines.count("****** Error ******") != 1
+            or [line for line in lines if line.startswith("--- ")] !=
+               ["--- PreprocessingVariationalEquation ---"]
+            or not any("preprocessingVariationalEquation.cpp:" in line and "(computeArc)" in line
+                       for line in lines)):
+        return None
+    trace = lines[lines.index("****** Error ******") + 1:-2]
+    frames = (r"in .*/config/config\.cpp:[0-9]+ \(run\)",
+              r"in .*/programs/preprocessing/preprocessingVariationalEquation\.cpp:[0-9]+ \(run\)",
+              r"in .*/parallel/parallel\.h:[0-9]+ \(forEachInterval\)",
+              r"in .*/programs/preprocessing/preprocessingVariationalEquation\.cpp:[0-9]+ \(computeArc\)")
+    if len(trace) != len(frames) or any(re.fullmatch(pattern, line) is None for pattern, line in zip(frames, trace)):
+        return None
+    number = r"(?:0|[1-9][0-9]*)(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"
+    match = re.fullmatch(
+        r"wide tangent returned double state did not meet true residual tolerance: relative_residual=(" + number +
+        r"), tolerance=(" + number + r"), iterations=120, solve_role=physical_correction, column=0, duration_seconds=(" +
+        number + r")", lines[-2])
+    if match is None:
+        return None
+    relative, tolerance, duration = (float(value) for value in match.groups())
+    if (not np.isfinite([relative, tolerance, duration]).all() or tolerance != 2e-12
+            or relative <= tolerance or duration <= 0):
+        return None
+    try:
+        states = np.asarray(previous_states, dtype=float)
+    except (TypeError, ValueError):
+        return None
+    if states.ndim != 2 or states.shape[1] != 6 or len(states) < 2 or not np.isfinite(states).all():
+        return None
+    return {"schema": "orbit-poc-numerical-trial-closure-v1",
+            "failure_kind": "wide_returned_binary64_residual_exhaustion",
+            "terminal_native_error": lines[-2], "relative_residual": relative,
+            "tolerance": tolerance, "iterations": 120, "solve_role": "physical_correction",
+            "column": 0, "duration_seconds": duration, "preceding_closure_finite": True,
+            "samples": len(states), "recoverable_only_during_trial": True,
+            "failed_state_accepted": False, "native_thresholds_unchanged": True,
+            "numerical_cause": "not determined by terminal residual receipt"}
+
