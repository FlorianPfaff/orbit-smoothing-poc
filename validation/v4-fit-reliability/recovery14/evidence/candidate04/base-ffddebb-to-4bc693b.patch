@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef ORBIT_POC_NUISANCE_FIXED_DYNAMICS_H
+#define ORBIT_POC_NUISANCE_FIXED_DYNAMICS_H
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include "misc/orbitPoc/nuisancePerformance.h"
+
+// The physical coordinates in an inner nuisance correction are exactly zero.
+// Do not confuse this predicate with a small-update or convergence threshold.
+namespace orbitPocNuisanceV41
+{
+inline bool enabled()
+{
+  const char *raw=std::getenv("ORBIT_POC_NUISANCE_FIXED_DYNAMICS");
+  const std::string value=raw?raw:"0";
+  if(value=="0")return false;
+  if(value=="1")return true;
+  throw std::invalid_argument("ORBIT_POC_NUISANCE_FIXED_DYNAMICS must be 0 or 1");
+}
+struct FiniteDesignCertificate
+{
+  std::uint64_t rows=0,columns=0;
+  bool validated=false;
+};
+inline FiniteDesignCertificate certifyKnownFinite(std::uint64_t rows,std::uint64_t columns,bool validated)
+{
+  if(!validated)throw std::runtime_error("Fixed-dynamics optimization requires a finite immutable design");
+  return {rows,columns,true};
+}
+template<class Matrix> inline FiniteDesignCertificate certifyFinite(const Matrix &matrix)
+{
+  // Native matrices are column major. This check is once per immutable design,
+  // never once per nuisance trial; the bounded backing supplies its sealed
+  // ingestion certificate instead of making individual coefficient reads.
+  for(std::uint64_t j=0;j<matrix.columns();j++)
+    for(std::uint64_t i=0;i<matrix.rows();i++)
+      if(!std::isfinite(matrix(i,j)))throw std::runtime_error("Nonfinite immutable dynamic design");
+  return certifyKnownFinite(matrix.rows(),matrix.columns(),true);
+}
+template<class Matrix> inline void requireCertificate(const FiniteDesignCertificate &certificate,const Matrix &matrix)
+{
+  if(!certificate.validated||certificate.rows!=matrix.rows()||certificate.columns!=matrix.columns())
+    throw std::runtime_error("Missing or mismatched finite dynamic-design certificate");
+}
+template<class Vector> inline bool exactZero(const Vector &correction)
+{
+  bool zero=true;
+  for(std::uint64_t i=0;i<correction.rows();i++)
+  {
+    if(!std::isfinite(correction(i)))throw std::runtime_error("Nonfinite physical correction");
+    zero=zero&&(correction(i)==0.);
+  }
+  return zero;
+}
+inline bool &recoveringFixedDynamics(){static bool value=false;return value;}
+struct Counters
+{
+  std::uint64_t omittedRecoveryDesigns=0,skippedZeroProducts=0;
+};
+inline Counters &counters(){static Counters value;return value;}
+
+// Scope only the conditional-recovery pass. The full weighted row build,
+// original-coordinate rank certificate, proposal and covariance stay intact.
+class RecoveryScope
+{
+  bool active=false;
+public:
+  template<class Names,class Vector,class IsDynamic>
+  RecoveryScope(bool profileStep,const Names &names,const Vector &correction,IsDynamic isDynamic)
+  {
+    if(!profileStep||!enabled())return;
+    if(recoveringFixedDynamics())throw std::logic_error("Nested fixed-dynamics recovery");
+    if(names.size()!=correction.rows())throw std::runtime_error("Nuisance correction coordinate count differs");
+    for(std::uint64_t i=0;i<names.size();i++)
+      if(isDynamic(names[i])&&(!std::isfinite(correction(i))||correction(i)!=0.))
+        throw std::runtime_error("Nuisance recovery contains a nonzero physical correction");
+    active=true;recoveringFixedDynamics()=true;
+  }
+  RecoveryScope(const RecoveryScope &)=delete;
+  RecoveryScope &operator=(const RecoveryScope &)=delete;
+  ~RecoveryScope(){if(active)recoveringFixedDynamics()=false;}
+};
+template<class Validate,class Compute> inline auto dynamicDesign(std::uint64_t columns,Validate &&validate,Compute &&compute)->decltype(compute())
+{
+  if(recoveringFixedDynamics())
+  {
+    // Preserve native time, stencil, endpoint and remainder validation.
+    validate();counters().omittedRecoveryDesigns++;
+    using Result=decltype(compute());
+    return Result(3,columns);
+  }
+  return orbitPocNuisancePerformance::dynamicDesign(columns,std::forward<Validate>(validate),std::forward<Compute>(compute));
+}
+inline void writeCounters(const std::string &path)
+{
+  if(!enabled())return;
+  std::ofstream out(path);
+  out<<"{\"schema\":\"orbit-poc-nuisance-fixed-dynamics-v1\",\"omitted_recovery_designs\":"<<counters().omittedRecoveryDesigns
+     <<",\"parent_skipped_zero_products\":"<<counters().skippedZeroProducts
+     <<",\"scope\":\"cumulative_parent_process_only_excludes_forked_trial_counters\"}\n";
+  if(!out)throw std::runtime_error("Cannot record fixed-dynamics optimization counters");
+}
+}
+#endif
