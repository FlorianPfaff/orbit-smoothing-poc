@@ -0,0 +1,125 @@
+"""Admission and immutable layered-source reentry; no compiler is launched."""
+import importlib.util
+import json
+from pathlib import Path
+import sys
+
+import pytest
+
+from tests.test_v4_candidate_build_controls import ROOT, setup, snapshot
+
+FLAGS = ["--numerics", "--segmented", "--wide-tangent-candidate",
+         "--nuisance-performance", "--variational-memory-candidate", "--reliability-v41"]
+RECEIPTS = ["orbit-poc-extension.json", "orbit-poc-segmented-extension.json",
+            "orbit-poc-wide-tangent-extension.json", "orbit-poc-nuisance-performance-extension.json",
+            "orbit-poc-variational-memory-extension.json", "orbit-poc-nuisance-v41-extension.json",
+            "orbit-poc-design-storage-v41-extension.json"]
+
+
+def fixture(tmp_path, monkeypatch, *, installed=False, flags=FLAGS):
+    builder, source, build, calls, reads, before = setup(tmp_path, monkeypatch, flags=flags)
+
+    def read(command, **kwargs):
+        reads.append(command)
+        if command[-2:] == ["rev-parse", "HEAD"]:
+            return builder.COMMIT + "\n"
+        assert command[-3:] == ["status", "--porcelain", "--untracked-files=all"]
+        return ""
+
+    monkeypatch.setattr(builder.subprocess, "check_output", read)
+    extension = ROOT / "groops/extension/apply_extension.py"
+    if installed:
+        for name in RECEIPTS:
+            (source / name).write_text(json.dumps({"name": name}))
+        builder.reliability_profile(source, extension, verify=False)
+    return builder, source, build, calls, reads, extension
+
+
+@pytest.mark.parametrize("missing", FLAGS[:-1])
+def test_prerequisites_fail_before_source_access(tmp_path, monkeypatch, missing):
+    b, s, _, calls, reads, _ = fixture(tmp_path, monkeypatch, flags=[x for x in FLAGS if x != missing])
+    before = snapshot(s)
+    with pytest.raises(SystemExit):
+        b.main()
+    assert not calls and not reads and snapshot(s) == before
+
+
+def test_fresh_installs_all_layers_once_and_seals_final_source(tmp_path, monkeypatch):
+    b, s, _, calls, _, extension = fixture(tmp_path, monkeypatch)
+    installers = ["apply_extension.py", "native_segmented.py", "native_tangent_wide.py",
+                  "native_nuisance_performance.py", "native_variational_memory.py",
+                  "native_nuisance_v41.py", "native_design_storage_v41.py"]
+
+    def run(command, **kwargs):
+        calls.append([str(x) for x in command])
+        name = Path(str(command[1])).name
+        if name in installers:
+            (s / RECEIPTS[installers.index(name)]).write_text(json.dumps({"name": name}))
+            (s / "source/preserved.cpp").write_text(name)
+
+    monkeypatch.setattr(b, "run", run)
+    b.main()
+    assert [Path(c[1]).name for c in calls[:-1]] == installers
+    assert calls[-1][:2] == ["cmake", "-S"]
+    b.reliability_profile(s, extension, verify=True)
+    before = snapshot(s)
+    calls.clear()
+    b.main()
+    assert len(calls) == 1 and calls[0][0] == "cmake"
+    assert snapshot(s) == before
+
+
+@pytest.mark.parametrize("damage", ["source", "receipt", "missing_receipt", "inputs", "seal", "partial", "downgrade"])
+def test_reentry_refuses_drift_without_reinstalling(tmp_path, monkeypatch, damage):
+    b, s, build, calls, _, _ = fixture(tmp_path, monkeypatch, installed=True,
+        flags=FLAGS[:-1] if damage == "downgrade" else FLAGS)
+    if damage == "source":
+        (s / "source/preserved.cpp").write_text("changed")
+    elif damage == "receipt":
+        (s / RECEIPTS[2]).write_text("{}")
+    elif damage == "missing_receipt":
+        (s / RECEIPTS[2]).unlink()
+    elif damage == "inputs":
+        monkeypatch.setattr(b, "reliability_inputs", lambda extension: {"different": "implementation"})
+    elif damage == "seal":
+        (s / b.V41_PROFILE).write_text("{}")
+    elif damage == "partial":
+        (s / b.V41_PROFILE).unlink()
+    before = snapshot(s)
+    with pytest.raises(ValueError):
+        b.main()
+    assert not calls and not build.exists() and snapshot(s) == before
+
+
+def test_new_profile_refuses_existing_campaign_checkout(tmp_path, monkeypatch):
+    b, s, _, calls, _, _ = fixture(tmp_path, monkeypatch)
+    (s / "orbit-poc-nuisance-performance-extension.json").write_text("{}")
+    before = snapshot(s)
+    with pytest.raises(ValueError, match="clean pinned upstream"):
+        b.main()
+    assert not calls and snapshot(s) == before
+
+
+def test_profile_rejects_symlink_receipt(tmp_path, monkeypatch):
+    b, s, _, calls, _, _ = fixture(tmp_path, monkeypatch, installed=True)
+    target = tmp_path / "receipt.json"
+    target.write_bytes((s / RECEIPTS[2]).read_bytes())
+    (s / RECEIPTS[2]).unlink()
+    (s / RECEIPTS[2]).symlink_to(target)
+    with pytest.raises(ValueError, match="unsafe"):
+        b.main()
+    assert not calls
+
+
+@pytest.mark.parametrize("option", ["--source-dir", "--build-dir"])
+def test_cli_rejects_symlink_directory_before_resolution(tmp_path, monkeypatch, option):
+    b, s, build, calls, reads, _ = fixture(tmp_path, monkeypatch)
+    alias = tmp_path / "alias"
+    target = s if option == "--source-dir" else tmp_path
+    alias.symlink_to(target, target_is_directory=True)
+    argv = list(sys.argv)
+    argv[argv.index(option)+1] = str(alias if option == "--source-dir" else alias / "build")
+    monkeypatch.setattr(sys, "argv", argv)
+    with pytest.raises(ValueError, match="Symlink"):
+        b.main()
+    assert not calls and not reads and not build.exists()
