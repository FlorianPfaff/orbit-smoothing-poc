@@ -0,0 +1,47 @@
+"""Independent path counterexamples for the v4.1 build profile (no native work)."""
+from pathlib import Path
+
+import pytest
+
+from tests.test_v41_build_controls import RECEIPTS, fixture
+
+
+@pytest.mark.parametrize("surface", ["source_file", "source_directory", "installer_file", "installer_directory"])
+def test_sealed_profile_rejects_external_symlink_backing(tmp_path, monkeypatch, surface):
+    builder, source, _, _, _, _ = fixture(tmp_path, monkeypatch)
+    extension_root = tmp_path / "extension"
+    extension_root.mkdir()
+    extension = extension_root / "apply_extension.py"
+    extension.write_text("# isolated installer fixture\n")
+    (extension_root / "empty").mkdir()
+    (source / "source/empty").mkdir()
+    for name in RECEIPTS:
+        (source / name).write_text("{}")
+    builder.reliability_profile(source, extension, verify=False)
+    if surface == "source_file":
+        original = source / "source/preserved.cpp"
+    elif surface == "source_directory":
+        original = source / "source/empty"
+    elif surface == "installer_file":
+        original = extension
+    else:
+        original = extension_root / "empty"
+    external = tmp_path / ("external-" + surface)
+    if original.is_dir():
+        original.rmdir()
+        external.mkdir()
+    else:
+        external.write_bytes(original.read_bytes())
+        original.unlink()
+    original.symlink_to(external)
+    with pytest.raises(ValueError, match="[Ss]ymlink|unsafe|[Ii]dentity|regular"):
+        builder.reliability_profile(source, extension, verify=True)
+
+
+@pytest.mark.parametrize("name", ["orbit-poc-reliability-v41-build-profile.json", "orbit-poc-nuisance-v41-extension.json", "orbit-poc-design-storage-v41-extension.json"])
+def test_dangling_candidate_receipt_blocks_every_installer(tmp_path, monkeypatch, name):
+    builder, source, _, calls, _, _ = fixture(tmp_path, monkeypatch)
+    (source / name).symlink_to(tmp_path / "absent-receipt.json")
+    with pytest.raises(ValueError):
+        builder.main()
+    assert calls == []
