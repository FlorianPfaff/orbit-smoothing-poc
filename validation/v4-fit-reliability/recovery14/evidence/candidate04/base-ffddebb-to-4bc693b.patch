+"""Fixed-coordinate work elimination: source contract and component guards.
+
+The component executable is deliberately selected by its own runtime flag;
+building it is not evidence of a complete native fit or accepted covariance.
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+EXTENSION = ROOT / "groops/extension"
+SPEC = importlib.util.spec_from_file_location("native_nuisance_v41", EXTENSION / "native_nuisance_v41.py")
+MODULE = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(MODULE)
+
+
+def _sources():
+    """Minimal exact upstream contracts, no unrelated mocked native behavior."""
+    return {
+        MODULE.DYNAMIC: '''// ORBIT_POC_NUISANCE_PERFORMANCE_V1
+            para->VelDesign.emplace_back(variationalEquation.VelDesign);
+orbitPocNuisancePerformance::dynamicDesign(para->PosDesign.at(arcNo).columns(),
+                [&](){para->polynomial.at(arcNo).interpolateOffset({eqn.timeRecv}, para->PosDesign.at(arcNo).column(0,0), {eqn.receiver->timeRemainder(eqn.idEpoch)}, 3);},
+                [&](){return nativeInterpolation();});
+          para->pos.at(arcNo) += para->PosDesign.at(arcNo) * dx;
+          para->vel.at(arcNo) += para->VelDesign.at(arcNo) * dx;
+          const Vector pos = actualClockDependentPositionInterpolation();
+          const Vector vel = actualClockDependentVelocityInterpolation();
+''',
+        MODULE.DECLARATION: '''#include "base/import.h"
+    std::vector<Matrix>            PosDesign, VelDesign;
+''',
+        MODULE.PROCESSING: '''// ORBIT_POC_TRANSACTIONAL_NUISANCE_V31
+// ORBIT_POC_NUISANCE_PERFORMANCE_V1
+      Double maximumJointObservationInfluence=0;
+      GnssDesignMatrix A(normalEquationInfo);
+      for(UInt epoch:normalEquationInfo.idEpochs)
+            {
+              localUpdates.push_back({eqn.receiver->observation(trans,epoch),local,influence});
+            }
+      auto observationFingerprint=[](){};
+      orbitPocNuisancePerformance::writeSearch(stem+".nuisance_performance.json",search,rowBuildPerformance);
+''',
+    }
+
+
+@pytest.fixture
+def native_tree(tmp_path):
+    for name, text in _sources().items():
+        path = tmp_path / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    (tmp_path / MODULE.HEADER).parent.mkdir(parents=True, exist_ok=True)
+    return tmp_path
+
+
+def test_installer_keeps_geometry_refresh_and_full_paths(native_tree):
+    manifest = MODULE.apply(native_tree)
+    cpp = (native_tree / MODULE.DYNAMIC).read_text()
+    assert cpp.count("para->PosDesign.at(arcNo) * dx") == 1
+    assert cpp.count("para->VelDesign.at(arcNo) * dx") == 1
+    assert cpp.index("actualClockDependentPositionInterpolation()") > cpp.index("skippedZeroProducts+=2")
+    assert cpp.index("actualClockDependentVelocityInterpolation()") > cpp.index("skippedZeroProducts+=2")
+    assert "exactZero(dx)" in cpp and "requireCertificate" in cpp
+    assert "para->pos.at(arcNo) += Vector(para->pos.at(arcNo).rows());" in cpp
+    processing = (native_tree / MODULE.PROCESSING).read_text()
+    assert 'RecoveryScope fixedDynamics(mode=="profile_step"' in processing
+    assert processing.index("} // fixed physical coordinates") < processing.index("auto observationFingerprint")
+    assert manifest["runtime_default"] == "0"
+    assert manifest["full_rank_linearizations_and_covariance"] == "unchanged"
+    assert manifest["cold_checks_and_correctness_thresholds"] == "unchanged"
+
+
+def test_installer_reentry_verifies_bytes(native_tree):
+    first = MODULE.apply(native_tree)
+    snapshot = {name: (native_tree / name).read_bytes() for name in first["installed_files"]}
+    assert MODULE.apply(native_tree) == first
+    assert snapshot == {name: (native_tree / name).read_bytes() for name in snapshot}
+
+
+@pytest.mark.parametrize("name", [MODULE.DYNAMIC, MODULE.DECLARATION, MODULE.PROCESSING, MODULE.HEADER])
+def test_installer_rejects_modified_installed_file(native_tree, name):
+    MODULE.apply(native_tree)
+    path = native_tree / name
+    path.write_text(path.read_text() + "// changed\n")
+    with pytest.raises(ValueError, match="file changed"):
+        MODULE.apply(native_tree)
+
+
+@pytest.mark.parametrize("name", [MODULE.DYNAMIC, MODULE.DECLARATION, MODULE.PROCESSING])
+@pytest.mark.parametrize("duplicate", [False, True])
+def test_installer_prevalidates_all_source_anchors(native_tree, name, duplicate):
+    path = native_tree / name
+    path.write_text(path.read_text() * 2 if duplicate else "changed source\n")
+    before = {p: p.read_bytes() for p in native_tree.rglob("*") if p.is_file()}
+    with pytest.raises(ValueError):
+        MODULE.apply(native_tree)
+    assert before == {p: p.read_bytes() for p in native_tree.rglob("*") if p.is_file()}
+
+
+@pytest.mark.parametrize("name", [MODULE.DYNAMIC, MODULE.DECLARATION, MODULE.PROCESSING])
+def test_installer_rejects_unattributed_partial_source(native_tree, name):
+    path = native_tree / name
+    path.write_text("// " + MODULE.MARKER + "\n" + path.read_text())
+    with pytest.raises(ValueError, match="partial"):
+        MODULE.apply(native_tree)
+
+
+def test_installer_rejects_unattributed_header(native_tree):
+    (native_tree / MODULE.HEADER).write_text("different\n")
+    with pytest.raises(ValueError, match="helper"):
+        MODULE.apply(native_tree)
+
+
+@pytest.fixture(scope="module")
+def fixed_dynamics_probe(tmp_path_factory):
+    if os.environ.get("ORBIT_POC_V41_COMPONENT_TESTS") != "1":
+        pytest.skip("select ORBIT_POC_V41_COMPONENT_TESTS=1 for compiled component guards")
+    directory = tmp_path_factory.mktemp("nuisance-v41-component")
+    include = directory / "misc/orbitPoc"
+    include.mkdir(parents=True)
+    shutil.copyfile(EXTENSION / "nuisancePerformance.h", include / "nuisancePerformance.h")
+    source = directory / "probe.cpp"
+    source.write_text(r'''
+#include <cassert>
+#include <limits>
+#include <vector>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "nuisanceFixedDynamics.h"
+namespace v41=orbitPocNuisanceV41;
+struct Matrix {
+  unsigned r,c; std::vector<double> a;
+  Matrix(unsigned rows,unsigned columns):r(rows),c(columns),a(r*c){}
+  unsigned rows()const{return r;} unsigned columns()const{return c;}
+  double operator()(unsigned i,unsigned j)const{return a.at(i+r*j);}
+  double &operator()(unsigned i,unsigned j){return a.at(i+r*j);}
+  double operator()(unsigned i)const{return a.at(i);}
+};
+int main(int argc,char **argv) {
+  assert(argc==2);const std::string mode=argv[1];
+  setenv("ORBIT_POC_NUISANCE_FIXED_DYNAMICS","1",1);
+  Matrix x(3,1),design(3,3);design(0,0)=2.;
+  std::vector<bool> names={true,false,true};
+  auto dynamic=[](bool value){return value;};
+  if(mode=="default") {unsetenv("ORBIT_POC_NUISANCE_FIXED_DYNAMICS");assert(!v41::enabled());return 0;}
+  if(mode=="invalid_switch") {setenv("ORBIT_POC_NUISANCE_FIXED_DYNAMICS","x",1);try{v41::enabled();}catch(const std::invalid_argument&){return 0;}return 1;}
+  if(mode=="zero") {x(0,0)=-0.;assert(v41::exactZero(x));x(2,0)=std::numeric_limits<double>::denorm_min();assert(!v41::exactZero(x));return 0;}
+  if(mode=="nonfinite_correction") {x(1,0)=std::numeric_limits<double>::quiet_NaN();try{v41::exactZero(x);}catch(const std::runtime_error&){return 0;}return 1;}
+  if(mode=="signed_zero_add") {double z=-0.;z+=0.;assert(!std::signbit(z));x(0,0)=-0.;assert(v41::exactZero(x));return 0;}
+  if(mode=="nonfinite_design") {design(2,2)=std::numeric_limits<double>::infinity();try{v41::certifyFinite(design);}catch(const std::runtime_error&){return 0;}return 1;}
