+// Real native Matrix, Polynomial, BLAS and piecewise API; no numerical stubs.
+#include "misc/orbitPoc/designRowsV41.h"
+#include "misc/orbitPoc/piecewisePolynomial.h"
+#include <dirent.h>
+#include <signal.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+
+void require(bool valid,const char *message){if(!valid)throw std::runtime_error(message);}
+template<class Function> void rejects(Function function)
+{bool rejected=false;try{function();}catch(const std::exception&){rejected=true;}require(rejected,"expected explicit rejection");}
+Matrix values(UInt rows,UInt columns)
+{
+  Matrix data(rows,columns);
+  for(UInt column=0;column<columns;column++)for(UInt row=0;row<rows;row++)
+    data(row,column)=std::sin(0.13*(row+1)*(column+1))+std::cos(0.01*row)+0.001*row*column;
+  return data;
+}
+OrbitPoc::DesignRows stored(const Matrix &matrix,UInt block)
+{
+  auto rows=OrbitPoc::DesignRows::disk(matrix.rows(),matrix.columns(),block);
+  for(UInt first=0;first<matrix.rows();first+=block)
+    rows.append(matrix.row(first,std::min(block,matrix.rows()-first)));
+  rows.seal();return rows;
+}
+double difference(const_MatrixSliceRef a,const_MatrixSliceRef b)
+{
+  require(a.rows()==b.rows()&&a.columns()==b.columns(),"comparison shapes differ");
+  double error=0.;for(UInt row=0;row<a.rows();row++)for(UInt column=0;column<a.columns();column++)
+    error=std::max(error,std::abs(a(row,column)-b(row,column)));
+  return error;
+}
+double magnitude(const_MatrixSliceRef a)
+{double value=0.;for(UInt i=0;i<a.rows();i++)for(UInt j=0;j<a.columns();j++)value=std::max(value,std::abs(a(i,j)));return value;}
+int ownedFile()
+{
+  DIR *directory=::opendir("/proc/self/fd");require(directory,"cannot enumerate fixture descriptors");int found=-1;
+  while(auto *entry=::readdir(directory))
+  {
+    if(entry->d_name[0]=='.')continue;
+    char target[4096];const std::string name="/proc/self/fd/"+std::string(entry->d_name);
+    const ssize_t length=::readlink(name.c_str(),target,sizeof(target)-1);
+    if(length<=0)continue;target[length]=0;
+    if(std::string(target).find("/orbit-design-")!=std::string::npos)
+    {require(found<0,"fixture expected one owned store");found=std::stoi(entry->d_name);}
+  }
+  ::closedir(directory);require(found>=0,"fixture owned store missing");return found;
+}
+void run(const std::string &kind,UInt block)
+{
+  if(kind=="parser"){std::cout<<"{\"block\":"<<OrbitPoc::DesignStorage::blockEpochs()<<",\"disk\":"<<(OrbitPoc::DesignStorage::enabled()?"true":"false")<<"}\n";return;}
+  if(kind=="allocation_failure")
+  {
+    struct rlimit original{};require(::getrlimit(RLIMIT_FSIZE,&original)==0,"getrlimit failed");
+    const auto signal=::signal(SIGXFSZ,SIG_IGN);struct rlimit bounded=original;bounded.rlim_cur=1024;
+    require(::setrlimit(RLIMIT_FSIZE,&bounded)==0,"setrlimit failed");
+    rejects([](){auto store=OrbitPoc::DesignRows::disk(1024,4,8);});
+    require(::setrlimit(RLIMIT_FSIZE,&original)==0,"restore limit failed");::signal(SIGXFSZ,signal);
+    std::cout<<"{\"rejected_without_fallback\":true}\n";return;
+  }
+  if(kind=="short_read"||kind=="corruption")
+  {
+    const Matrix data=values(48,7);auto store=stored(data,12);const int descriptor=ownedFile();
+    require((::fcntl(descriptor,F_GETFL)&O_ACCMODE)==O_RDONLY,"sealed descriptor is writable");
+    const int writer=::open(("/proc/self/fd/"+std::to_string(descriptor)).c_str(),O_WRONLY);
+    require(writer>=0,"fault fixture cannot reopen owned inode");
+    if(kind=="short_read")require(::ftruncate(writer,0)==0,"truncate fault failed");
+    else{const Double wrong=1e30;require(::pwrite(writer,&wrong,sizeof(wrong),0)==sizeof(wrong),"corruption fault failed");}
+    ::close(writer);rejects([&](){store.row(0,3);});
+    std::cout<<"{\"detected_fault\":true}\n";return;
+  }
+  if(kind=="lifecycle")
+  {
+    const Matrix data=values(96,7);int descriptor=-1;
+    {
+      auto store=stored(data,12);descriptor=ownedFile();
+      struct stat metadata{};require(::fstat(descriptor,&metadata)==0&&metadata.st_nlink==0,"scratch file not unlinked");
+      const Matrix before=store.row(4,9);auto alias=store;
+      store=OrbitPoc::DesignRows();require(difference(alias.row(4,9),before)==0,"alias lost original bytes");
+      const pid_t child=::fork();require(child>=0,"fork failed");
+      if(child==0)
+      {
+        int result=0;try{require(difference(alias.row(78,12),data.row(78,12))==0,"fork child row mismatch");alias=OrbitPoc::DesignRows();}catch(...){result=3;}
+        ::_exit(result);
+      }
+      int status=0;require(::waitpid(child,&status,0)==child&&WIFEXITED(status)&&WEXITSTATUS(status)==0,"fork child failed");
+      require(difference(alias.row(3,27),data.row(3,27))==0,"child altered parent file/cache state");
+    }
+    require(::fcntl(descriptor,F_GETFD)<0&&errno==EBADF,"owned descriptor leaked");
+    std::cout<<"{\"fork_alias_cleanup\":true}\n";return;
+  }
+  if(kind=="preseal_fork")
+  {
+    const Matrix data=values(24,5);
+    auto store=OrbitPoc::DesignRows::disk(24,5,12);
+    store.append(data.row(0,12));
+    const pid_t child=::fork();require(child>=0,"pre-seal fork failed");
+    if(child==0)
+    {
+      int result=0;
+      try
+      {
+        // The inherited writable descriptor must not authorize mutation. The
+        // append shape is otherwise valid, so this exercises the owner guard.
+        rejects([&](){store.append(data.row(12,12));});
+        rejects([&](){store.row(0,3);});
+      }
+      catch(...){result=3;}
+      ::_exit(result);
+    }
+    int status=0;
+    require(::waitpid(child,&status,0)==child&&WIFEXITED(status)&&WEXITSTATUS(status)==0,
+            "child mutated or accepted an unsealed inherited store");
+    store.append(data.row(12,12));
+    const pid_t sealingChild=::fork();require(sealingChild>=0,"pre-seal owner fork failed");
+    if(sealingChild==0)
+    {
+      int result=0;
+      // All rows now exist, so a seal would otherwise be valid. This checks
+      // the seal owner guard independently of the incomplete-write guard.
+      try{rejects([&](){store.seal();});}catch(...){result=3;}
+      ::_exit(result);
+    }
+    require(::waitpid(sealingChild,&status,0)==sealingChild&&WIFEXITED(status)&&WEXITSTATUS(status)==0,
+            "child accepted seal of an inherited complete design");
+    store.seal();
+    require(store.finiteValidated()&&difference(store.row(0,24),data)==0,
+            "pre-seal child changed parent design bytes or lifecycle");
+    std::cout<<"{\"preseal_fork_mutations_rejected\":true}\n";return;
+  }
+  if(kind=="invalid")
+  {
+    const Matrix good=values(24,5);
+    auto store=OrbitPoc::DesignRows::disk(24,5,12);
+    rejects([&](){store.row(0,3);});rejects([&](){store.seal();});
+    rejects([&](){store.append(good.row(0,6));});
+    Matrix bad=good.row(0,12);bad(3,2)=std::numeric_limits<double>::infinity();
+    rejects([&](){store.append(bad);});rejects([&](){OrbitPoc::DesignRows heap(bad);});
+    store.append(good.row(0,12));store.append(good.row(12,12));store.seal();
+    rejects([&](){store.append(good.row(0,12));});rejects([&](){store.seal();});
+    rejects([&](){store.row(23,2);});rejects([&](){store.column(0,1);});rejects([&](){store.denseMatrix();});
+    require(store.finiteValidated()&&difference(store.row(0,24),good)==0,"negative test damaged accepted store");
+    std::cout<<"{\"state_errors_rejected\":true}\n";return;
+  }
+  const UInt epochs=97,columns=11;
+  const Matrix position=values(3*epochs,columns),velocity=values(3*epochs,columns)*0.123;
+  auto pos=stored(position,3*block),vel=stored(velocity,3*block);
+  require(pos.finiteValidated()&&vel.finiteValidated(),"sealed finite certificate missing");
+  double maxRows=0,maxInterpolation=0,maxProduct=0,maxCovariance=0;
+  if(kind=="rows"||kind=="products")
+  {
+    for(UInt first=0;first<position.rows();first+=7)
+      maxRows=std::max(maxRows,difference(pos.row(first,std::min(UInt(19),position.rows()-first)),position.row(first,std::min(UInt(19),position.rows()-first))));
+    require(maxRows==0,"native row bytes changed");
+    const Matrix rhs=values(columns,1);const Matrix expected=position*rhs;
+    maxProduct=difference(pos*rhs,expected);
+    Matrix sum=values(position.rows(),1),reference=sum;matMult(1.,position,rhs,reference);pos.addProduct(rhs,sum);
+    maxProduct=std::max(maxProduct,difference(sum,reference));
+    require(maxProduct<=5e-14*std::max(1.,magnitude(reference)),"blocked product differs excessively");
+  }
+  else if(kind=="interpolation"||kind=="covariance")
+  {
+    std::vector<Time> times;
+    for(UInt i=0;i<epochs;i++)times.emplace_back(60000,Double(5*i)/86400.);
+    const std::vector<Time> boundaries{times.at(12),times.at(24),times.at(48)},pulses{times.at(24),times.at(48)};
+    OrbitPocPiecewisePolynomial polynomial(times,7,boundaries,pulses);
+    std::vector<Time> query{times.at(0),Time(60000,17.3/86400.),times.at(12),times.at(24),Time(60000,239.9/86400.),times.at(48),times.at(80)};
+    const std::vector<long double> offsets{0,1e-9L,-1e-9L,0,1e-9L,-1e-9L,0};
+    for(bool jump:{false,true})
+    {
+      const auto &full=jump?velocity:position;const auto &disk=jump?vel:pos;
+      maxInterpolation=std::max(maxInterpolation,difference(polynomial.interpolateOffset(query,disk,offsets,3,jump),polynomial.interpolateOffset(query,full,offsets,3,jump)));
+      for(UInt i=0;i<query.size();i++)
+        maxInterpolation=std::max(maxInterpolation,difference(polynomial.interpolateOffset({query.at(i)},disk,{offsets.at(i)},3,jump),polynomial.interpolateOffset({query.at(i)},full,{offsets.at(i)},3,jump)));
+      require(polynomial.interpolateOffset(query,disk.column(0,0),offsets,3,jump).columns()==0,"zero-column validation changed");
+    }
+    require(maxInterpolation==0,"native interpolation binary64 values changed");
+    Matrix factor=values(columns,columns),covariance=factor*factor.trans();for(UInt i=0;i<columns;i++)covariance(i,i)+=2.;
+    const Matrix expected=OrbitPoc::cartesianCovarianceRows(position,velocity,covariance);
+    const Matrix actual=OrbitPoc::storedCartesianCovariance(pos,vel,covariance);
+    maxCovariance=difference(actual,expected)/std::max(1.,magnitude(expected));
+    const Matrix observationExpected=OrbitPoc::storedObservationCovariance(polynomial,query,OrbitPoc::DesignRows(position),OrbitPoc::DesignRows(velocity),covariance);
+    const Matrix observationActual=OrbitPoc::storedObservationCovariance(polynomial,query,pos,vel,covariance);
+    maxCovariance=std::max(maxCovariance,difference(observationActual,observationExpected)/std::max(1.,magnitude(observationExpected)));
+    require(maxCovariance<1e-12,"selected Cartesian covariance error exceeds component tolerance");
+  }
+  else throw std::runtime_error("unknown native design fixture case");
+  pos.report("fixture_complete");vel.report("fixture_complete");
+  std::cout<<std::setprecision(17)<<"{\"row_max_error\":"<<maxRows<<",\"interpolation_max_error\":"<<maxInterpolation
+           <<",\"product_max_error\":"<<maxProduct<<",\"covariance_relative_error\":"<<maxCovariance<<"}\n";
+}
+int main(int argc,char **argv)
+{
+  if(argc!=3)return 2;
+  try{run(argv[1],std::stoul(argv[2]));return 0;}
+  catch(const std::exception &error){std::cerr<<error.what()<<'\n';return 3;}
+}
