+/***********************************************/
+
+Double GnssParametrizationLeoDynamicOrbits::updateParameter(const GnssNormalEquationInfo &normalEquationInfo, const_MatrixSliceRef x, const_MatrixSliceRef /*Wz*/)
+{
+  try
+  {
+    Double maxChange = 0;
+    Gnss::InfoParameterChange info("mm");
+    for(auto para : parameters)
+      if(para && para->index && para->recv->isMyRank())
+      {
+        para->stateCovariance.clear(); // invalidate covariance after any parameter update
+        para->parameterCovariance = Matrix();
+        const Vector dx = x.row(normalEquationInfo.index(para->index), para->x.rows());
+        para->x += dx;
+
+        for(UInt arcNo=0; arcNo<para->times.size(); arcNo++)
+        {
+          para->pos.at(arcNo) += para->PosDesign.at(arcNo) * dx;
+          para->vel.at(arcNo) += para->VelDesign.at(arcNo) * dx;
+
+          std::vector<Time> times;std::vector<long double> queryRemainders;
+          for(UInt idEpoch=para->startEpoch.at(arcNo); idEpoch<=para->endEpoch.at(arcNo); idEpoch++)
+            if(para->recv->useable(idEpoch))
+              {times.push_back(para->recv->timeCorrected(idEpoch));queryRemainders.push_back(para->recv->timeRemainder(idEpoch));}
+
+          std::vector<long double> coordinateLow;
+          const Vector pos = para->polynomial.at(arcNo).interpolateOffset(times, para->pos.at(arcNo), queryRemainders, 3, FALSE, nullptr, &coordinateLow);
+          para->recv->orbitPocPositionRemainder.resize(para->recv->times.size());
+          const Vector vel = para->polynomial.at(arcNo).interpolateOffset(times, para->vel.at(arcNo), queryRemainders, 3, TRUE/*velocity jumps*/);
+          UInt i=0;
+          for(UInt idEpoch=para->startEpoch.at(arcNo); idEpoch<=para->endEpoch.at(arcNo); idEpoch++)
+            if(para->recv->useable(idEpoch))
+            {
+              const Vector3d dpos = Vector3d(pos.row(3*i, 3)) - para->recv->pos.at(idEpoch);
+              para->recv->pos.at(idEpoch) = Vector3d(pos.row(3*i, 3));
+              para->recv->orbitPocPositionRemainder.at(idEpoch)=Vector3d(static_cast<Double>(coordinateLow.at(3*i)),static_cast<Double>(coordinateLow.at(3*i+1)),static_cast<Double>(coordinateLow.at(3*i+2)));
+              para->recv->vel.at(idEpoch) = Vector3d(vel.row(3*i, 3));
+              if(info.update(1e3*dpos.r()))
+                info.info = "position receiver ("+para->recv->name()+", "+times.at(i).dateTimeStr()+")";
+              i++;
+            }
+        }
+      }
+    info.synchronizeAndPrint(normalEquationInfo.comm, 1e-3, maxChange);
+    return maxChange;
+  }
+  catch(std::exception &e)
+  {
+    GROOPS_RETHROW(e)
+  }
+}
+
+/***********************************************/
+
+
+// ORBIT_COMPARISON_MARGINAL_COVARIANCE_V1
+void GnssParametrizationLeoDynamicOrbits::updateCovariance(const GnssNormalEquationInfo &normalEquationInfo, const MatrixDistributed &covariance)
+{
+  try
+  {
+    if((fileNameCovariance.empty() && fileNameParameterCovariance.empty() && fileNameCovarianceObservationEpochs.empty()) || !isEnabled(normalEquationInfo, name))
+      return;
+    if(Parallel::size(normalEquationInfo.comm) != 1)
+      throw(Exception("Native LEO covariance extension supports serial execution only"));
+
+    for(auto para : parameters)
+      if(para && para->index && para->recv->isMyRank())
+      {
+        const UInt count = para->x.rows();
+        const UInt first = normalEquationInfo.index(para->index);
+        if(first+count > covariance.parameterCount())
+          throw(Exception("Orbit parameter range exceeds full inverse dimension"));
+        Matrix parameterCovariance(count, count);
+        // These entries are extracted AFTER inversion of the full native normal
+        // matrix. Clocks, float ambiguities and other fitted blocks have already
+        // been marginalized. Never invert an orbit-only normal submatrix here.
+        for(UInt i=0; i<count; i++)
+          for(UInt j=i; j<count; j++)
+          {
+            const UInt blockI = covariance.index2block(first+i);
+            const UInt blockJ = covariance.index2block(first+j);
+            if(!covariance.isBlockUsed(blockI, blockJ) || !covariance.isMyRank(blockI, blockJ))
+              throw(Exception("Full inverse is missing a required orbit covariance block"));
+            const Matrix &block = covariance.N(blockI, blockJ);
+            const UInt row = first+i-covariance.blockIndex(blockI);
+            const UInt col = first+j-covariance.blockIndex(blockJ);
+            if(row >= block.rows() || col >= block.columns())
+              throw(Exception("Full inverse orbit covariance block has incomplete storage"));
+            const Double value = block(row, col);
+            if(!std::isfinite(value))
+              throw(Exception("Nonfinite native orbit parameter covariance"));
+            parameterCovariance(i,j) = parameterCovariance(j,i) = value;
+          }
+
+        para->parameterCovariance = parameterCovariance; // ORBIT_COMPARISON_PARAMETER_COVARIANCE_V1
+        if(fileNameCovariance.empty()) continue;
+        para->stateCovariance.clear();
+        for(UInt arcNo=0; arcNo<para->times.size(); arcNo++)
+        {
+          const UInt epochs = para->times.at(arcNo).size();
+          const Matrix &pos = para->PosDesign.at(arcNo);
+          const Matrix &vel = para->VelDesign.at(arcNo);
+          if(pos.rows() != 3*epochs || vel.rows() != 3*epochs || pos.columns() != count || vel.columns() != count)
+            throw(Exception("Position/velocity variational designs do not match orbit parameters"));
+          // Batched matrix products preserve all state/dynamic cross terms and
+          // avoid a large separate covariance product at every epoch.
+          const Matrix posCov = pos * parameterCovariance;
+          const Matrix velCov = vel * parameterCovariance;
+          Matrix rows(epochs, 36);
+          for(UInt epoch=0; epoch<epochs; epoch++)
+          {
+            Matrix design(6, count), weighted(6, count);
+            copy(pos.row(3*epoch, 3), design.row(0, 3));
+            copy(vel.row(3*epoch, 3), design.row(3, 3));
+            copy(posCov.row(3*epoch, 3), weighted.row(0, 3));
+            copy(velCov.row(3*epoch, 3), weighted.row(3, 3));
+            const Matrix stateCovariance = weighted * design.trans();
+            for(UInt i=0; i<6; i++)
+              for(UInt j=0; j<6; j++)
+              {
+                const Double value = 0.5*(stateCovariance(i,j)+stateCovariance(j,i));
+                if(!std::isfinite(value) || ((i == j) && (value <= 0)))
+                  throw(Exception("Invalid native Cartesian covariance"));
+                rows(epoch, 6*i+j) = value;
+              }
+          }
+          para->stateCovariance.push_back(rows);
+        }
+      }
+  }
+  catch(std::exception &e)
+  {
+    GROOPS_RETHROW(e)
+  }
+}
+
+/***********************************************/
+
+void GnssParametrizationLeoDynamicOrbits::writeResults(const GnssNormalEquationInfo &normalEquationInfo, const std::string &suffix) const
+{
+  try
+  {
+    if(!isEnabled(normalEquationInfo, name))
+      return;
+
+
+    // ORBIT_POC_SEGMENTED_COVARIANCE_QUERIES_V4. This is independent of all
+    // dense covariance output options and does not authorize covariance.
+    const char *queryOption=std::getenv("ORBIT_POC_SEGMENTED_COVARIANCE_QUERIES");
+    if(queryOption && std::string(queryOption)!="0" && std::string(queryOption)!="1")
+      throw(Exception("Segmented covariance query export must be 0 or 1"));
+    if(queryOption && std::string(queryOption)=="1")
+    {
+      if(!orbitPocRowQr().enabled()||orbitPocRowQr().artifactStem().empty()||orbitPocRowQr().isCostOnly())
+        throw(Exception("Segmented covariance queries require an ordinary native QR factor"));
+      using namespace OrbitPoc::SegmentedExport;
+      const std::string path=orbitPocRowQr().artifactStem()+".segmented_covariance_queries.jsonl";
+      std::ofstream out(path);out.precision(17);if(!out)throw(Exception("cannot open segmented covariance query export"));
+      out<<"{\"kind\":\"metadata\",\"schema\":\"orbit-poc-segmented-covariance-queries-v1\",\"factor_stem\":";
+      string(out,orbitPocRowQr().artifactStem());out<<",\"write_suffix\":";string(out,suffix);
+      out<<",\"coordinates\":\"Cartesian_SI\",\"row_order\":\"position_xyz_velocity_xyz\",\"post_pulse_velocity\":true,\"covariance_produced\":false}\n";
+      UInt trajectoryCount=0,observationCount=0;
+      for(auto para:parameters)
+        if(para&&para->index&&para->recv->isMyRank())
+        {
+          const UInt first=normalEquationInfo.index(para->index),count=para->x.rows();
+          std::vector<Bool> covered(gnss->times.size(),FALSE);UInt trajectoryIndex=0;
+          for(UInt arcNo=0;arcNo<para->times.size();arcNo++)
+          {
+            const auto &times=para->times.at(arcNo);
+            if(times.empty())throw(Exception("empty native trajectory query arc"));
+            for(UInt i=0;i<times.size();i++,trajectoryIndex++,trajectoryCount++)
+            {
+              const std::vector<Weight> identity={{i,1.L,0.L}};
+              stateQuery(out,"trajectory",para->recv->idRecv(),arcNo,trajectoryIndex,first,count,times[i],identity,identity);
+            }
+            for(UInt i=0;i<gnss->times.size();i++)
+              if(!covered[i]&&gnss->times[i]>=times.front()&&gnss->times[i]<=times.back())
+              {
+                const auto position=para->polynomial.at(arcNo).orbitPocStencil(gnss->times[i]);
+                const auto velocity=para->polynomial.at(arcNo).orbitPocStencil(gnss->times[i],0.L,TRUE);
+                stateQuery(out,"nominal_observation",para->recv->idRecv(),arcNo,i,first,count,gnss->times[i],position,velocity);
+                covered[i]=TRUE;observationCount++;
+              }
+          }
+          for(Bool valid:covered)if(!valid)throw(Exception("A nominal GNSS covariance query lies outside every native arc"));
+        }
+      if(!trajectoryCount||!observationCount)throw(Exception("empty segmented covariance query support"));
+      out<<"{\"kind\":\"complete\",\"trajectory_count\":"<<trajectoryCount<<",\"nominal_observation_count\":"<<observationCount<<"}\n";
+      if(!out)throw(Exception("segmented covariance query export failed"));
+    }
+
+    if(!fileNameOrbit.empty())
+    {
+      VariableList fileNameVariableList;
+      fileNameVariableList.setVariable("station", "***");
+      logStatus<<"write receiver orbits to files <"<<fileNameOrbit(fileNameVariableList).appendBaseName(suffix)<<">"<<Log::endl;
+      for(auto para : parameters)
+        if(para && para->index && para->recv->isMyRank())
+        {
+          std::vector<OrbitArc> arcList;
+          for(UInt arcNo=0; arcNo<para->times.size(); arcNo++)
+          {
+            OrbitArc arc;
+            for(UInt idEpoch=0; idEpoch<para->times.at(arcNo).size(); idEpoch++)
+            {
+              OrbitEpoch epoch;
+              epoch.time     = para->times.at(arcNo).at(idEpoch);
+              epoch.position = Vector3d(para->pos.at(arcNo).row(3*idEpoch, 3));
+              epoch.velocity = Vector3d(para->vel.at(arcNo).row(3*idEpoch, 3));
+              arc.push_back(epoch);
+            }
+            arcList.push_back(arc);
+          }
+          fileNameVariableList.setVariable("station", para->recv->name());
+          InstrumentFile::write(fileNameOrbit(fileNameVariableList).appendBaseName(suffix), arcList);
+          if(!fileNameOrbitNative.empty())
+            InstrumentFile::write(fileNameOrbitNative(fileNameVariableList).appendBaseName(suffix),arcList);
+        }
+    }
+
+
+    // ORBIT_COMPARISON_MARGINAL_COVARIANCE_V1: MJD, then row-major 6x6 SI covariance.
+    if(!fileNameCovariance.empty())
+    {
+      VariableList fileNameVariableList;
+      fileNameVariableList.setVariable("station", "***");
+      logStatus<<"write marginalized Cartesian covariance <"<<fileNameCovariance(fileNameVariableList).appendBaseName(suffix)<<">"<<Log::endl;
+      for(auto para : parameters)
+        if(para && para->index && para->recv->isMyRank())
+        {
+          if(para->stateCovariance.size() != para->times.size())
+            throw(Exception("Run computeCovarianceMatrix after the final parameter update before covariance output"));
+          UInt count = 0;
+          for(const auto &times : para->times)
+            count += times.size();
+          Matrix output(count, 37);
+          UInt row = 0;
+          for(UInt arcNo=0; arcNo<para->times.size(); arcNo++)
+            for(UInt epoch=0; epoch<para->times.at(arcNo).size(); epoch++, row++)
+            {
+              output(row, 0) = para->times.at(arcNo).at(epoch).mjd();
+              for(UInt column=0; column<36; column++)
+                output(row, column+1) = para->stateCovariance.at(arcNo)(epoch, column);
+            }
+          fileNameVariableList.setVariable("station", para->recv->name());
+          writeFileMatrix(fileNameCovariance(fileNameVariableList).appendBaseName(suffix), output);
+        }
+    }
+
+
+    // ORBIT_COMPARISON_PARAMETER_COVARIANCE_V1: exact native parameter ordering.
+    if(!fileNameParameterCovariance.empty())
+    {
+      VariableList fileNameVariableList;
+      for(auto para : parameters)
+        if(para && para->index && para->recv->isMyRank())
+        {
+          if(para->parameterCovariance.rows() != para->x.rows())
+            throw(Exception("Run computeCovarianceMatrix after final parameter update before parameter covariance output"));
+          fileNameVariableList.setVariable("station", para->recv->name());
+          writeFileMatrix(fileNameParameterCovariance(fileNameVariableList).appendBaseName(suffix), para->parameterCovariance);
+        }
+    }
+
+
+    // ORBIT_COMPARISON_OBSERVATION_COVARIANCE_V1: evaluate designs, then J P J^T.
+    if(!fileNameCovarianceObservationEpochs.empty())
+    {
+      VariableList fileNameVariableList;
+      for(auto para : parameters)
+        if(para && para->index && para->recv->isMyRank())
+        {
+          const UInt count = para->x.rows();
+          if(para->parameterCovariance.rows() != count)
+            throw(Exception("Run computeCovarianceMatrix after final update before observation covariance output"));
+          Matrix output(gnss->times.size(), 37);
+          std::vector<Bool> covered(gnss->times.size(), FALSE);
+          for(UInt arcNo=0; arcNo<para->times.size(); arcNo++)
+          {
+            std::vector<Time> query;
+            std::vector<UInt> indices;
+            for(UInt i=0; i<gnss->times.size(); i++)
+              if(!covered.at(i) && gnss->times.at(i) >= para->times.at(arcNo).front() &&
+                                  gnss->times.at(i) <= para->times.at(arcNo).back())
+              {
+                query.push_back(gnss->times.at(i));
+                indices.push_back(i);
+                covered.at(i) = TRUE;
+              }
+            if(query.empty()) continue;
+            const Matrix pos = para->polynomial.at(arcNo).interpolate(query, para->PosDesign.at(arcNo), 3);
+            const Matrix vel = para->polynomial.at(arcNo).interpolate(query, para->VelDesign.at(arcNo), 3, TRUE/*velocity jumps*/);
+            const Matrix posCov = pos * para->parameterCovariance;
+            const Matrix velCov = vel * para->parameterCovariance;
+            for(UInt epoch=0; epoch<query.size(); epoch++)
+            {
+              Matrix design(6, count), weighted(6, count);
+              copy(pos.row(3*epoch, 3), design.row(0, 3));
+              copy(vel.row(3*epoch, 3), design.row(3, 3));
+              copy(posCov.row(3*epoch, 3), weighted.row(0, 3));
+              copy(velCov.row(3*epoch, 3), weighted.row(3, 3));
+              const Matrix stateCovariance = weighted * design.trans();
+              output(indices.at(epoch), 0) = query.at(epoch).mjd();
+              for(UInt i=0; i<6; i++)
+                for(UInt j=0; j<6; j++)
+                {
+                  const Double value = 0.5*(stateCovariance(i,j)+stateCovariance(j,i));
+                  if(!std::isfinite(value) || ((i == j) && (value <= 0)))
+                    throw(Exception("Invalid native Cartesian covariance at GNSS epoch"));
+                  output(indices.at(epoch), 1+6*i+j) = value;
+                }
+            }
+          }
+          for(Bool valid : covered)
+            if(!valid)
+              throw(Exception("A nominal GNSS covariance epoch lies outside every variational arc"));
+          fileNameVariableList.setVariable("station", para->recv->name());
+          writeFileMatrix(fileNameCovarianceObservationEpochs(fileNameVariableList).appendBaseName(suffix), output);
+        }
+    }
+
+    if(!fileNameParameter.empty())
+    {
+      VariableList fileNameVariableList;
+      fileNameVariableList.setVariable("station", "***");
+      logStatus<<"write estimated receiver parameters to files <"<<fileNameParameter(fileNameVariableList).appendBaseName(suffix)<<">"<<Log::endl;
+      for(auto para : parameters)
+        if(para && para->index && para->recv->isMyRank())
+        {
+          fileNameVariableList.setVariable("station", para->recv->name());
+          writeFileMatrix(fileNameParameter(fileNameVariableList).appendBaseName(suffix), para->x);
+        }
+    }
+  }
+  catch(std::exception &e)
+  {
+    GROOPS_RETHROW(e)
+  }
+}
