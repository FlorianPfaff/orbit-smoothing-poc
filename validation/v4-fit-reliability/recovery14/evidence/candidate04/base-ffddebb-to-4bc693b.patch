+#!/usr/bin/env python3
+"""Bound GNSS derivative storage without changing the native tangent operator.
+
+Install last, after nuisance v4.1. A separate selected v4.1 runtime enables disk
+storage; existing runtime defaults and physical/statistical configuration stay
+unchanged. Native Matrix ownership and interpolation arithmetic are untouched.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+MARKER = "ORBIT_POC_DESIGN_STORAGE_V41"
+MANIFEST = "orbit-poc-design-storage-v41-extension.json"
+DYNAMIC = "source/gnss/gnssParametrization/gnssParametrizationLeoDynamicOrbits.cpp"
+DECLARATION = "source/gnss/gnssParametrization/gnssParametrizationLeoDynamicOrbits.h"
+POLYNOMIAL = "source/misc/orbitPoc/piecewisePolynomial.h"
+HEADER = "source/misc/orbitPoc/designRowsV41.h"
+
+
+def _replace(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError("Design-storage v4.1 anchor mismatch: " + old[:100])
+    return text.replace(old, new, 1)
+
+
+def _declaration(text):
+    if "ORBIT_POC_NUISANCE_FIXED_DYNAMICS_V41" not in text:
+        raise ValueError("Design-storage requires nuisance v4.1 first")
+    text = _replace(text, '#include "base/import.h"', '#include "base/import.h"\n#include "misc/orbitPoc/designRowsV41.h"')
+    text = _replace(text, "    std::vector<Matrix>            PosDesign, VelDesign;",
+                    "    std::vector<OrbitPoc::DesignRows> PosDesign, VelDesign;")
+    return "// " + MARKER + "\n" + text
+
+
+def _polynomial(text):
+    # Only source parameter types change. The exact existing selection, native
+    # polynomial, Twofold, pulse-side and relative-time code bodies stay intact.
+    for name in ("interpolate", "interpolateOffset"):
+        old = f"  Matrix {name}(const std::vector<Time> &timesNew, const_MatrixSliceRef A,"
+        new = f"  template<class Rows> Matrix {name}(const std::vector<Time> &timesNew, const Rows &A,"
+        text = _replace(text, old, new)
+    text = _replace(text, '#include "base/polynomial.h"', '#include "base/polynomial.h"\n#include "misc/orbitPoc/designRowsV41.h"')
+    # Preserve native MatrixSlice aliasing on the compatibility path. A generic
+    # provider row() materializes its bounded disk slice; applying that method
+    # to heap storage would introduce an unnecessary per-observation deep copy.
+    text = _replace(text, "\n};\n#endif", """
+  // ORBIT_POC_DESIGN_STORAGE_DISPATCH_V41
+  Matrix interpolate(const std::vector<Time> &timesNew,const OrbitPoc::DesignRows &A,
+                     UInt rowsPerEpoch=1,Bool valuesJump=FALSE)const
+  {
+    if(!A.isDisk())return interpolate(timesNew,A.denseMatrix(),rowsPerEpoch,valuesJump);
+    return interpolate<OrbitPoc::DesignRows>(timesNew,A,rowsPerEpoch,valuesJump);
+  }
+  Matrix interpolateOffset(const std::vector<Time> &timesNew,const OrbitPoc::DesignRows &A,
+                     const std::vector<long double> &offsetSeconds,UInt rowsPerEpoch=1,Bool valuesJump=FALSE,
+                     std::vector<long double> *preciseValues=nullptr,std::vector<long double> *coordinateRemainders=nullptr)const
+  {
+    if(!A.isDisk())return interpolateOffset(timesNew,A.denseMatrix(),offsetSeconds,rowsPerEpoch,valuesJump,preciseValues,coordinateRemainders);
+    return interpolateOffset<OrbitPoc::DesignRows>(timesNew,A,offsetSeconds,rowsPerEpoch,valuesJump,preciseValues,coordinateRemainders);
+  }
+};
+#endif""")
+    return "// " + MARKER + "\n" + text
+
+
+def _dynamic(text):
+    if "ORBIT_POC_NUISANCE_FIXED_DYNAMICS_V41" not in text:
+        raise ValueError("Design-storage requires nuisance v4.1 first")
+    text = _replace(text,
+        "auto variationalEquation = file.integrateArc(arc.times.front(), arc.times.back(), TRUE/*computePosition*/, TRUE/*computeVelocity*/);",
+        "auto variationalEquation = OrbitPoc::integrateStoredDesigns(file,arc.times);")
+    for member in ("PosDesign", "VelDesign"):
+        old = f"orbitPocNuisanceV41::certifyFinite(para->{member}.back())"
+        new = f"orbitPocNuisanceV41::certifyKnownFinite(para->{member}.back().rows(),para->{member}.back().columns(),para->{member}.back().finiteValidated())"
+        text = _replace(text, old, new)
+    for member, output in (("PosDesign", "pos"), ("VelDesign", "vel")):
+        text = _replace(text, f"matMult(1.,variationalEquation.{member},orbitPocReference,para->{output}.back());",
+                        f"variationalEquation.{member}.addProduct(orbitPocReference,para->{output}.back());")
+    # Covariance remains the full nuisance-marginalized dynamic covariance.
+    # Change only the storage of its Cartesian products, after certification.
+    begin = "          const Matrix &pos = para->PosDesign.at(arcNo);"
+    end = "          para->stateCovariance.push_back(rows);"
+    if text.count(begin) != 1 or text.count(end) != 1:
+        raise ValueError("Design-storage native covariance bounds mismatch")
+    first, last = text.index(begin), text.index(end) + len(end)
+    text = text[:first] + """          if(para->PosDesign.at(arcNo).rows()!=3*epochs || para->VelDesign.at(arcNo).rows()!=3*epochs ||
+             para->PosDesign.at(arcNo).columns()!=count || para->VelDesign.at(arcNo).columns()!=count)
+            throw(Exception("Position/velocity variational designs do not match orbit parameters"));
+          para->stateCovariance.push_back(OrbitPoc::storedCartesianCovariance(
+              para->PosDesign.at(arcNo),para->VelDesign.at(arcNo),parameterCovariance));""" + text[last:]
+    begin = "            const Matrix pos = para->polynomial.at(arcNo).interpolate(query, para->PosDesign.at(arcNo), 3);"
+    end = """          }
+          for(Bool valid : covered)"""
+    if text.count(begin) != 1 or text.count(end) != 1:
+        raise ValueError("Design-storage observation covariance bounds mismatch")
+    first, last = text.index(begin), text.index(end)
+    text = text[:first] + """            const Matrix covarianceRows=OrbitPoc::storedObservationCovariance(para->polynomial.at(arcNo),query,
+                para->PosDesign.at(arcNo),para->VelDesign.at(arcNo),para->parameterCovariance);
+            for(UInt epoch=0;epoch<query.size();epoch++)
+            {
+              output(indices.at(epoch),0)=query.at(epoch).mjd();
+              copy(covarianceRows.row(epoch,1),output.slice(indices.at(epoch),1,1,36));
+            }
+""" + text[last:]
+    # Finite/boundary checks remain in native interpolation, even when a cost
+    # build elides derivatives. No source is replaced following construction.
+    anchor = """          const Vector pos = para->polynomial.at(arcNo).interpolateOffset(times, para->pos.at(arcNo), queryRemainders, 3, FALSE, nullptr, &coordinateLow);"""
+    text = _replace(text, anchor, """          para->PosDesign.at(arcNo).report("parameter_update");
+          para->VelDesign.at(arcNo).report("parameter_update");
+""" + anchor)
+    return "// " + MARKER + "\n" + text
+
+
+def _sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _ordinary(path, absent=False):
+    if any(parent.is_symlink() for parent in (path, *path.parents)):
+        raise ValueError("Symlink in design-storage installation")
+    if not path.is_file() and not (absent and not path.exists()):
+        raise ValueError("Nonregular design-storage installation file")
+
+
+def apply(source):
+    root = Path(source).absolute()
+    here = Path(__file__).resolve().parent
+    inputs = {name: _sha((here / name).read_bytes()) for name in
+              ("native_design_storage_v41.py", "designRowsV41.h")}
+    files = {DYNAMIC, DECLARATION, POLYNOMIAL, HEADER}
+    for name in files | {MANIFEST}:
+        _ordinary(root / name, absent=name in {HEADER, MANIFEST})
+    if (root / MANIFEST).exists():
+        old = json.loads((root / MANIFEST).read_text())
+        if old.get("schema") != "orbit-poc-design-storage-v41-install-v1" or old.get("installer_inputs") != inputs or set(old.get("installed_files", {})) != files:
+            raise ValueError("Design-storage installation identity differs")
+        for name, digest in old["installed_files"].items():
+            if _sha((root / name).read_bytes()) != digest:
+                raise ValueError("Installed design-storage source changed")
+        return old
+    original = {name: (root / name).read_bytes() for name in (DYNAMIC, DECLARATION, POLYNOMIAL)}
+    if any(MARKER.encode() in value for value in original.values()):
+        raise ValueError("Unattributed partial design-storage installation")
+    header = (here / "designRowsV41.h").read_bytes()
+    if (root / HEADER).exists() and (root / HEADER).read_bytes() != header:
+        raise ValueError("Unattributed design-storage helper")
+    updated = {DYNAMIC: _dynamic(original[DYNAMIC].decode()).encode(),
+               DECLARATION: _declaration(original[DECLARATION].decode()).encode(),
+               POLYNOMIAL: _polynomial(original[POLYNOMIAL].decode()).encode(), HEADER: header}
+    result = {"schema": "orbit-poc-design-storage-v41-install-v1", "runtime_default": "memory",
+              "runtime_environment": "ORBIT_POC_GNSS_DESIGN_STORAGE", "values": ["memory", "disk"],
+              "required_disk_scratch": "ORBIT_POC_GNSS_DESIGN_SCRATCH",
+              "block_epochs_environment": "ORBIT_POC_GNSS_DESIGN_BLOCK_EPOCHS",
+              "block_epochs_default": 64, "block_epochs_range": [1, 4096],
+              "cache_blocks_per_design": 2, "maximum_loaded_rows_bytes": 64 * 1024 * 1024,
+              "scope": "native_GNSS_dynamic_design_storage_and_bounded_products",
+              "operator_and_interpolation": "same_native_chronological_operator_and_piecewise_body",
+              "arithmetic_note": "Row-block BLAS shapes differ; existing numerical equivalence gates remain mandatory",
+              "priors_weights_coordinates_and_thresholds": "unchanged",
+              "scratch_accounting": "preallocated_unlinked_owned_files_in_native_process_tree; no_RSS_policy_change",
+              "installer_inputs": inputs, "previous_files": {name: _sha(data) for name, data in original.items()},
+              "installed_files": {name: _sha(data) for name, data in updated.items()}}
+    for name, data in updated.items():
+        (root / name).parent.mkdir(parents=True, exist_ok=True)
+        (root / name).write_bytes(data)
+    (root / MANIFEST).write_text(json.dumps(result, indent=2, sort_keys=True) + "\n")
+    return result
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", required=True)
+    print(json.dumps(apply(parser.parse_args().source), indent=2, sort_keys=True))
