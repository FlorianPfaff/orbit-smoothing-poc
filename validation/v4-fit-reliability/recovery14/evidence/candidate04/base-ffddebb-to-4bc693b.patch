+#!/usr/bin/env python3
+"""Install exact fixed-dynamics nuisance work elimination after instrumentation.
+
+This is a separate default-off v4.1 candidate. It changes neither the full QR
+linearization nor cold checks, objective rows, line-search limits or thresholds.
+Run before native_dynamic_design_memory_v41 when bounded backing is selected.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+MARKER = "ORBIT_POC_NUISANCE_FIXED_DYNAMICS_V41"
+MANIFEST = "orbit-poc-nuisance-v41-extension.json"
+DYNAMIC = "source/gnss/gnssParametrization/gnssParametrizationLeoDynamicOrbits.cpp"
+DECLARATION = "source/gnss/gnssParametrization/gnssParametrizationLeoDynamicOrbits.h"
+PROCESSING = "source/gnss/gnssProcessingStep/gnssProcessingStep.cpp"
+HEADER = "source/misc/orbitPoc/nuisanceFixedDynamics.h"
+
+
+def _replace(text, old, new):
+    if text.count(old) != 1:
+        raise ValueError(f"Nuisance v4.1 anchor mismatch: {old[:100]}")
+    return text.replace(old, new, 1)
+
+
+def _dynamic(text):
+    if "ORBIT_POC_NUISANCE_PERFORMANCE_V1" not in text:
+        raise ValueError("Nuisance v4.1 requires nuisance performance instrumentation")
+    text = _replace(text, "            para->VelDesign.emplace_back(variationalEquation.VelDesign);", """            para->VelDesign.emplace_back(variationalEquation.VelDesign);
+            // ORBIT_POC_V41_FINITE_DESIGN_INGEST: immutable until parameter destruction.
+            if(orbitPocQr::enabled() && orbitPocNuisanceV41::enabled())
+            {
+              para->orbitPocPositionDesignCertificates.push_back(orbitPocNuisanceV41::certifyFinite(para->PosDesign.back()));
+              para->orbitPocVelocityDesignCertificates.push_back(orbitPocNuisanceV41::certifyFinite(para->VelDesign.back()));
+            }
+            else
+            {
+              para->orbitPocPositionDesignCertificates.push_back({});
+              para->orbitPocVelocityDesignCertificates.push_back({});
+            }""")
+    text = _replace(text, "orbitPocNuisancePerformance::dynamicDesign(para->PosDesign.at(arcNo).columns(),", "orbitPocNuisanceV41::dynamicDesign(para->PosDesign.at(arcNo).columns(),")
+    text = _replace(text,
+        "[&](){para->polynomial.at(arcNo).interpolateOffset({eqn.timeRecv}, para->PosDesign.at(arcNo).column(0,0), {eqn.receiver->timeRemainder(eqn.idEpoch)}, 3);}",
+        """[&](){if(orbitPocNuisanceV41::recoveringFixedDynamics())
+                  orbitPocNuisanceV41::requireCertificate(para->orbitPocPositionDesignCertificates.at(arcNo),para->PosDesign.at(arcNo));
+                para->polynomial.at(arcNo).interpolateOffset({eqn.timeRecv}, para->PosDesign.at(arcNo).column(0,0), {eqn.receiver->timeRemainder(eqn.idEpoch)}, 3);}""")
+    text = _replace(text, """          para->pos.at(arcNo) += para->PosDesign.at(arcNo) * dx;
+          para->vel.at(arcNo) += para->VelDesign.at(arcNo) * dx;""", """          // Skip only proven-zero products. Clock-driven position/velocity
+          // interpolation below is still mandatory, even for the zero replay.
+          if(orbitPocQr::enabled() && orbitPocNuisanceV41::enabled() && orbitPocNuisanceV41::exactZero(dx))
+          {
+            orbitPocNuisanceV41::requireCertificate(para->orbitPocPositionDesignCertificates.at(arcNo),para->PosDesign.at(arcNo));
+            orbitPocNuisanceV41::requireCertificate(para->orbitPocVelocityDesignCertificates.at(arcNo),para->VelDesign.at(arcNo));
+            // Keep the legacy zero additions, including signed-zero behavior.
+            para->pos.at(arcNo) += Vector(para->pos.at(arcNo).rows());
+            para->vel.at(arcNo) += Vector(para->vel.at(arcNo).rows());
+            orbitPocNuisanceV41::counters().skippedZeroProducts+=2;
+          }
+          else
+          {
+            para->pos.at(arcNo) += para->PosDesign.at(arcNo) * dx;
+            para->vel.at(arcNo) += para->VelDesign.at(arcNo) * dx;
+          }""")
+    return "// " + MARKER + "\n" + text
+
+
+def _declaration(text):
+    text = _replace(text, '#include "base/import.h"', '#include "base/import.h"\n#include "misc/orbitPoc/nuisanceFixedDynamics.h"')
+    text = _replace(text, "    std::vector<Matrix>            PosDesign, VelDesign;", """    std::vector<Matrix>            PosDesign, VelDesign;
+    std::vector<orbitPocNuisanceV41::FiniteDesignCertificate> orbitPocPositionDesignCertificates,orbitPocVelocityDesignCertificates;""")
+    return "// " + MARKER + "\n" + text
+
+
+def _processing(text):
+    if "ORBIT_POC_TRANSACTIONAL_NUISANCE_V31" not in text or "ORBIT_POC_NUISANCE_PERFORMANCE_V1" not in text:
+        raise ValueError("Nuisance v4.1 requires corrected transactional instrumented profiling")
+    start = """      Double maximumJointObservationInfluence=0;
+      GnssDesignMatrix A(normalEquationInfo);
+      for(UInt epoch:normalEquationInfo.idEpochs)"""
+    text = _replace(text, start, """      Double maximumJointObservationInfluence=0;
+      GnssDesignMatrix A(normalEquationInfo);
+      {
+      orbitPocNuisanceV41::RecoveryScope fixedDynamics(mode=="profile_step",normalEquationInfo.parameterNames(),x,
+        [](const ParameterName &name){return orbitPocQr::dynamic(name);});
+      for(UInt epoch:normalEquationInfo.idEpochs)""")
+    text = _replace(text, """              localUpdates.push_back({eqn.receiver->observation(trans,epoch),local,influence});
+            }
+      auto observationFingerprint=""", """              localUpdates.push_back({eqn.receiver->observation(trans,epoch),local,influence});
+            }
+      } // fixed physical coordinates apply only to conditional recovery
+      auto observationFingerprint=""")
+    anchor = '      orbitPocNuisancePerformance::writeSearch(stem+".nuisance_performance.json",search,rowBuildPerformance);'
+    text = _replace(text, anchor, anchor + '\n      orbitPocNuisanceV41::writeCounters(stem+".nuisance_fixed_dynamics.json");')
+    return '// ' + MARKER + '\n#include "misc/orbitPoc/nuisanceFixedDynamics.h"\n' + text
+
+
+def _digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def apply(root):
+    root = Path(root)
+    here = Path(__file__).resolve().parent
+    inputs = {name: _digest((here / name).read_bytes()) for name in ("native_nuisance_v41.py", "nuisanceFixedDynamics.h")}
+    manifest_path = root / MANIFEST
+    files = {DYNAMIC, DECLARATION, PROCESSING, HEADER}
+    if manifest_path.exists():
+        manifest = json.loads(manifest_path.read_text())
+        if manifest.get("installer_inputs") != inputs or set(manifest.get("installed_files", {})) != files:
+            raise ValueError("Installed nuisance v4.1 implementation differs")
+        for name, expected in manifest["installed_files"].items():
+            if _digest((root / name).read_bytes()) != expected:
+                raise ValueError(f"Installed nuisance v4.1 file changed: {name}")
+        return manifest
+    originals = {name: (root / name).read_bytes() for name in (DYNAMIC, DECLARATION, PROCESSING)}
+    if any(MARKER in value.decode() for value in originals.values()):
+        raise ValueError("Unattributed partial nuisance v4.1 installation")
+    if (root / HEADER).exists() and (root / HEADER).read_bytes() != (here / "nuisanceFixedDynamics.h").read_bytes():
+        raise ValueError("Unattributed nuisance v4.1 helper")
+    # All source anchors are checked before the first mutation.
+    updated = {DYNAMIC: _dynamic(originals[DYNAMIC].decode()).encode(),
+               DECLARATION: _declaration(originals[DECLARATION].decode()).encode(),
+               PROCESSING: _processing(originals[PROCESSING].decode()).encode(),
+               HEADER: (here / "nuisanceFixedDynamics.h").read_bytes()}
+    manifest = {"schema": "orbit-poc-nuisance-v41-extension-v1", "runtime_default": "0",
+                "runtime_environment": "ORBIT_POC_NUISANCE_FIXED_DYNAMICS", "runtime_values": ["0", "1"],
+                "scope": "exact_zero_dynamic_products_and_nuisance_only_conditional_recovery",
+                "full_rank_linearizations_and_covariance": "unchanged",
+                "cold_checks_and_correctness_thresholds": "unchanged",
+                "finite_design_policy": "immutable_ingestion_certificate_required_before_zero_product_shortcut",
+                "installer_inputs": inputs,
+                "previous_files": {name: _digest(value) for name, value in originals.items()},
+                "installed_files": {name: _digest(value) for name, value in updated.items()}}
+    for name, value in updated.items():
+        (root / name).write_bytes(value)
+    manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
+    return manifest
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", required=True)
+    print(json.dumps(apply(parser.parse_args().source), indent=2, sort_keys=True))
