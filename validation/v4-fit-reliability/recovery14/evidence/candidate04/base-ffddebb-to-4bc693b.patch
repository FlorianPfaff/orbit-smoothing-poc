+"""Strict installer checks and explicitly selected actual native storage tests.
+
+The native fixture links a completed pinned GROOPS build; it uses the actual
+Matrix, BLAS and corrected piecewise Polynomial. These are component gates,
+not evidence of full-fit convergence or statistical covariance authority.
+"""
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[1]
+EXT = ROOT / "groops/extension"
+FIXTURES = ROOT / "tests/fixtures/design_storage_v41"
+NATIVE = ROOT / "tests/fixtures/native_design_storage_v41.cpp"
+PINS = {
+    "dynamic.cpp": "b2d4690bbb19b432a993ec8739cf541c523450b3f1934e93765a8fbb254bea48",
+    "dynamic.h": "a7b2a53bd4f5ae9422dfd4afb30b34e763b149202ceaf2fa93d0a5ff4541e6ec",
+    "piecewise.h": "15b95511bd72feaa3ac567fab37636cf87a13d3e453b988a662e576925cc0b76",
+}
+
+
+def load(path, name):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+installer = load(EXT / "native_design_storage_v41.py", "storage_v41_installer")
+nuisance = load(EXT / "native_nuisance_v41.py", "storage_v41_nuisance_installer")
+linker = load(ROOT / "tests/test_native_cost_only_query.py", "storage_v41_native_linker")
+
+
+def tree(tmp_path):
+    root = tmp_path / "native"
+    for file, expected in PINS.items():
+        assert hashlib.sha256((FIXTURES / file).read_bytes()).hexdigest() == expected
+    values = {installer.DYNAMIC: nuisance._dynamic((FIXTURES / "dynamic.cpp").read_text()),
+              installer.DECLARATION: nuisance._declaration((FIXTURES / "dynamic.h").read_text()),
+              installer.POLYNOMIAL: (FIXTURES / "piecewise.h").read_text()}
+    for name, text in values.items():
+        path = root / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    return root
+
+
+def snapshot(root):
+    return {path.relative_to(root).as_posix(): path.read_bytes() for path in root.rglob("*") if path.is_file()}
+
+
+def test_storage_installer_exact_interpolation_body_and_idempotence(tmp_path):
+    root = tree(tmp_path)
+    original = (root / installer.POLYNOMIAL).read_text()
+    report = installer.apply(root)
+    actual = (root / installer.POLYNOMIAL).read_text().removeprefix("// " + installer.MARKER + "\n")
+    actual = actual.replace('#include "misc/orbitPoc/designRowsV41.h"\n', '')
+    first = actual.index("  // ORBIT_POC_DESIGN_STORAGE_DISPATCH_V41")
+    last = actual.index("\n};\n#endif", first)
+    actual = actual[:first] + actual[last + 1:]
+    for name in ("interpolate", "interpolateOffset"):
+        actual = actual.replace(f"template<class Rows> Matrix {name}(const std::vector<Time> &timesNew, const Rows &A,",
+                                f"Matrix {name}(const std::vector<Time> &timesNew, const_MatrixSliceRef A,")
+    assert actual == original
+    assert report["runtime_default"] == "memory"
+    assert report["cache_blocks_per_design"] == 2
+    assert "same_native_chronological" in report["operator_and_interpolation"]
+    before = snapshot(root)
+    assert installer.apply(root) == report
+    assert snapshot(root) == before
+
+
+@pytest.mark.parametrize("damage", ["init", "prior_order", "covariance", "interpolation", "partial", "header", "symlink"])
+def test_storage_installer_rejects_incomplete_sources_before_writes(tmp_path, damage):
+    root = tree(tmp_path)
+    dynamic = root / installer.DYNAMIC
+    if damage == "init":
+        dynamic.write_text(dynamic.read_text().replace("auto variationalEquation = file.integrateArc", "auto variationalEquation= file.integrateArc"))
+    elif damage == "prior_order":
+        dynamic.write_text((FIXTURES / "dynamic.cpp").read_text())
+    elif damage == "covariance":
+        dynamic.write_text(dynamic.read_text().replace("para->stateCovariance.push_back(rows);", "para->stateCovariance.emplace_back(rows);"))
+    elif damage == "interpolation":
+        path = root / installer.POLYNOMIAL
+        path.write_text(path.read_text().replace("const_MatrixSliceRef A,", "const Matrix &A,"))
+    elif damage == "partial":
+        dynamic.write_text("// " + installer.MARKER + "\n" + dynamic.read_text())
+    elif damage == "header":
+        (root / installer.HEADER).write_text("unattributed")
+    elif damage == "symlink":
+        target = tmp_path / "external.cpp"
+        dynamic.rename(target)
+        dynamic.symlink_to(target)
+    before = snapshot(root)
+    with pytest.raises(ValueError):
+        installer.apply(root)
+    assert snapshot(root) == before
+
+
+@pytest.mark.parametrize("name", [installer.DYNAMIC, installer.DECLARATION, installer.POLYNOMIAL, installer.HEADER, installer.MANIFEST])
+def test_storage_installer_detects_reentry_identity_drift(tmp_path, name):
+    root = tree(tmp_path)
+    installer.apply(root)
+    path = root / name
+    if name == installer.MANIFEST:
+        value = json.loads(path.read_text())
+        value["installer_inputs"]["designRowsV41.h"] = "0" * 64
+        path.write_text(json.dumps(value))
+    else:
+        path.write_text(path.read_text() + "\n// changed\n")
+    before = snapshot(root)
+    with pytest.raises(ValueError):
+        installer.apply(root)
+    assert snapshot(root) == before
+
+
+def test_storage_dynamic_hooks_have_no_trajectory_wide_covariance_products(tmp_path):
+    root = tree(tmp_path)
+    installer.apply(root)
+    actual = (root / installer.DYNAMIC).read_text()
+    assert "file.integrateArc(arc.times.front()" not in actual
+    assert "const Matrix &pos = para->PosDesign" not in actual
+    assert "const Matrix posCov = pos *" not in actual
+    assert "const Matrix velCov = vel *" not in actual
+    assert "storedCartesianCovariance" in actual and "storedObservationCovariance" in actual
+    assert "finiteValidated()" in actual
+    assert "referenceCovariance" not in actual
+
+
+@pytest.fixture(scope="module")
+def native_storage(tmp_path_factory):
+    keys = ["ORBIT_POC_STORAGE_NATIVE_" + name for name in ("SOURCE", "BUILD", "CXX")]
+    selected = [os.environ.get(key) for key in keys]
+    if not any(selected):
+        pytest.skip("select a completed v4.1 native build for actual storage/Polynomial tests")
+    assert all(selected), "all three native source/build/compiler selectors required"
+    source, build, compiler = map(Path, selected)
+    assert all(path.is_absolute() for path in (source, build, compiler))
+    native = source / "source"
+    cache = {}
+    for line in (build / "CMakeCache.txt").read_text().splitlines():
+        if not line.startswith(("//", "#")) and "=" in line:
+            key, value = line.split("=", 1)
+            cache[key.split(":", 1)[0]] = value
+    assert Path(cache["CMAKE_CXX_COMPILER"]).resolve() == compiler.resolve()
+    assert Path(cache["CMAKE_HOME_DIRECTORY"]).resolve() == native.resolve()
+    objects, libraries = linker._link_arguments((build / "build.ninja").read_text(), build)
+    inputs = [NATIVE, compiler, build / "build.ninja", build / "CMakeCache.txt",
+              native / "misc/orbitPoc/designRowsV41.h", native / "misc/orbitPoc/piecewisePolynomial.h",
+              *objects, *(Path(name) for name in libraries if Path(name).is_absolute())]
+    pins = [linker._pin(path) for path in inputs]
+    output = tmp_path_factory.mktemp("native-design-storage-v41")
+    binary = output / "storage"
+    command = [str(compiler), "-std=c++17", "-O2", "-I", str(native), str(NATIVE),
+               *map(str, objects), *libraries, "-o", str(binary)]
+    result = subprocess.run(command, cwd=output, env=linker._environment(), capture_output=True, text=True, timeout=180)
+    (output / "compile.log").write_text(result.stdout + result.stderr)
+    unchanged = all(linker._pin(Path(pin["path"])) == pin for pin in pins)
+    (output / "compile.json").write_text(json.dumps({"command": command, "returncode": result.returncode,
+        "inputs_unchanged": unchanged, "input_pins": pins, "binary": linker._pin(binary) if binary.exists() else None}, indent=2) + "\n")
+    assert unchanged
+    assert result.returncode == 0, result.stdout + result.stderr
+    return binary
+
+
+def run(binary, tmp_path, kind, block=7, extra=None, expected=0):
+    environment = linker._environment()
+    environment.update(ORBIT_POC_GNSS_DESIGN_STORAGE="disk", ORBIT_POC_GNSS_DESIGN_SCRATCH=str(tmp_path),
+                       ORBIT_POC_GNSS_DESIGN_BLOCK_EPOCHS=str(block), ORBIT_POC_NUMERICS_QR_PREFIX=str(tmp_path / "qr"))
+    environment.update(extra or {})
+    result = subprocess.run([str(binary), kind, str(block)], cwd=tmp_path, env=environment,
+                            capture_output=True, text=True, timeout=30)
+    (tmp_path / f"{kind}-{block}.log").write_text(result.stdout + result.stderr)
+    assert result.returncode == expected, result.stdout + result.stderr
+    assert not list(tmp_path.glob("orbit-design-*")), "owned scratch files must be immediately unlinked"
+    return json.loads(result.stdout) if expected == 0 else result.stderr
+
+
+@pytest.mark.parametrize("block", [1, 7, 13, 64, 256])
+@pytest.mark.parametrize("kind", ["rows", "products", "interpolation", "covariance"])
+def test_real_native_design_storage_equivalence(native_storage, tmp_path, block, kind):
+    report = run(native_storage, tmp_path, kind, block)
+    assert report["row_max_error"] == 0
+    assert report["interpolation_max_error"] == 0
+    assert report["covariance_relative_error"] < 1e-12
+    receipts = [json.loads(line) for line in (tmp_path / "qr.design_storage.jsonl").read_text().splitlines()]
+    assert all(row["sealed"] and row["finite_validated"] for row in receipts)
+    assert all(row["scratch_written_bytes"] == row["scratch_reserved_bytes"] for row in receipts)
+    assert all(row["cache_block_bound"] == 2 for row in receipts)
+
+
+@pytest.mark.parametrize("kind", ["lifecycle", "preseal_fork", "invalid", "short_read", "corruption", "allocation_failure"])
+def test_real_native_storage_lifecycle_and_io_fail_closed(native_storage, tmp_path, kind):
+    report = run(native_storage, tmp_path, kind)
+    assert list(report.values()) == [True]
+
+
+@pytest.mark.parametrize("value", ["0", "", "01", "-1", "+1", "4097", "1e2", " 64"])
+def test_native_storage_rejects_noncanonical_block_sizes(native_storage, tmp_path, value):
+    assert "canonical 1..4096" in run(native_storage, tmp_path, "parser", extra={"ORBIT_POC_GNSS_DESIGN_BLOCK_EPOCHS": value}, expected=3)
+
+
+@pytest.mark.parametrize("value", ["0", "1", "mmap", "", "DISK"])
+def test_native_storage_rejects_unknown_storage_modes(native_storage, tmp_path, value):
+    assert "must be memory or disk" in run(native_storage, tmp_path, "parser", extra={"ORBIT_POC_GNSS_DESIGN_STORAGE": value}, expected=3)
+
+
+@pytest.mark.parametrize("mode", ["missing", "regular_file", "symlink"])
+def test_native_storage_rejects_unusable_scratch_without_heap_fallback(native_storage, tmp_path, mode):
+    target = tmp_path / "scratch"
+    if mode == "regular_file":
+        target.write_text("not a directory")
+    elif mode == "symlink":
+        target.symlink_to(tmp_path, target_is_directory=True)
+    assert "cannot open scratch directory" in run(native_storage, tmp_path, "rows", extra={"ORBIT_POC_GNSS_DESIGN_SCRATCH": str(target)}, expected=3)
