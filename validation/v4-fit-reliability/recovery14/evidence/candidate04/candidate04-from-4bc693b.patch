+
+
+def _truth_check(value):
+    if isinstance(value, dict):
+        role = value.get("role")
+        if isinstance(role, str) and (role.lower() in TRUTH_ROLES or "truth" in role.lower() or "gnv1b" in role.lower()):
+            raise ValueError("Evaluation/reference artifact cannot enter estimation inputs")
+        if value.get("reference_inputs_used") is True:
+            raise ValueError("Reference-derived preparation cannot enter the fit mirror")
+        for key, child in value.items():
+            if key in {"truth_inputs", "evaluation_inputs", "comparison_orbit"} and child:
+                raise ValueError("Evaluation data present in fit metadata")
+            _truth_check(child)
+    elif isinstance(value, list):
+        for child in value:
+            _truth_check(child)
+
+
+def prepare(inventory, pin):
+    """Construct a bounded plan in memory, preserving uncopied provenance."""
+    destination = Path(inventory["destination"])
+    files = {x["original_path"]: x for x in inventory["files"]}
+    prefixes = inventory["path_prefixes"]
+    target = lambda old: str(destination / "mirror" / old.lstrip("/"))
+    generated = set(inventory["generated_paths"])
+    documents = {}
+    for old, item in files.items():
