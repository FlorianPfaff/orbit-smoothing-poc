+def strict_profile(profile):
+    classification = check.classify_profile(profile)
+    if (profile.get('threshold_m') != 1e-8 or type(profile.get('required_consecutive_small_updates')) is not int
+        or profile['required_consecutive_small_updates'] != 2 or profile.get('fixed_weights') is not True
+        or profile.get('dynamic_updates') is not False):
+        raise ValueError('Nuisance controls or fixed-state assertions changed')
+    if classification == 'floor_limited_progress_only':
+        if not check.valid_floor_receipt(profile):
+            raise ValueError('Numerical-floor status lacks its unchanged audit')
+        return classification
+    if classification != 'strict_nuisance_convergence':
+        raise ValueError('Missing strict nuisance convergence')
+    count, history = profile.get('iterations'), profile.get('history')
+    if (type(count) is not int or not 2 <= count <= 128 or not isinstance(history, list) or len(history) != count
+        or not all(isinstance(x, dict) for x in history) or profile.get('maximum_update_m') != history[-1].get('maximum_update_m')
+        or any(not check.analysis.finite_nonnegative(x.get('maximum_update_m')) or x['maximum_update_m'] >= 1e-8 for x in history[-2:])):
+        raise ValueError('Strict status lacks unchanged two-consecutive-update evidence')
+    return classification
