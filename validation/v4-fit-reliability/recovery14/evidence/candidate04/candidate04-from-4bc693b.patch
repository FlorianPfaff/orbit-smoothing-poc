+#!/usr/bin/env python3
+"""Read-only exact scientific checks for twelve explicitly bound v4.1 profiles.
+
+Every arm has the real cost-only/cache treatment enabled. This checker never
+rewrites receipts to impersonate the older cost-off/cost-on experiment.
+"""
+from __future__ import annotations
+import argparse
+from datetime import datetime, timezone
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+
+DEPENDENCY = Path(__file__).with_name('check_nuisance_cost_only_pair.py')
+_spec = importlib.util.spec_from_file_location('_v41_cost_helpers', DEPENDENCY)
+cost = importlib.util.module_from_spec(_spec)
+exec(compile(DEPENDENCY.read_bytes(), str(DEPENDENCY), 'exec'), cost.__dict__)
+base = cost.base
+TREATMENTS = {'memory_fixed0': (0, 'memory'), 'memory_fixed1': (1, 'memory'), 'disk64_fixed1': (1, 'disk')}
+# Each treatment pair occurs in both temporal orders twice across the four groups.
+GROUP_ORDER = [('pulses', 0, ('memory_fixed0', 'disk64_fixed1', 'memory_fixed1')),
+               ('log_drag_ou', 1, ('memory_fixed1', 'memory_fixed0', 'disk64_fixed1')),
+               ('pulses', 1, ('memory_fixed1', 'disk64_fixed1', 'memory_fixed0')),
+               ('log_drag_ou', 0, ('disk64_fixed1', 'memory_fixed0', 'memory_fixed1'))]
+FIXED_NATIVE = dict(cost.FIXED_NATIVE, ORBIT_POC_NUISANCE_COST_ONLY_DESIGN='1',
+                    ORBIT_POC_GNSS_DESIGN_BLOCK_EPOCHS='64')
+LIMITS = {'timeout_seconds': 7200, 'process_tree_rss_bytes': 8 * 1024**3,
+          'min_free_disk_bytes': 16 * 1024**3}
+SCHEMA = 'orbit-poc-v41-profile-pair-freeze-v1'
+
+
+def job_name(method, accumulation, treatment):
+    return f'{method}-accumulate{accumulation}-{treatment}'
+
+
+def expected_jobs():
+    return [(m, a, t) for m, a, order in GROUP_ORDER for t in order]
+
+
+def expected_pairs():
+    return [{'left': job_name(m, a, left), 'right': job_name(m, a, right), 'kind': kind}
+            for m, a, _ in GROUP_ORDER for left, right, kind in
+            [('memory_fixed0', 'memory_fixed1', 'fixed_dynamics'),
+             ('memory_fixed1', 'disk64_fixed1', 'storage')]]
+
+
+def environment(freeze, job):
+    root = Path(job['profile']).parent
+    flag, storage = TREATMENTS[job['treatment']]
+    return dict(freeze['environment_fixed'], ORBIT_POC_NUISANCE_FIXED_DYNAMICS=str(flag),
+                ORBIT_POC_GNSS_DESIGN_STORAGE=storage,
+                ORBIT_POC_GNSS_DESIGN_SCRATCH=str(root / 'scratch'),
+                ORBIT_POC_NUMERICS_QR_PREFIX=str(root / 'qr'))
+
+
+class Inventory:
+    def __init__(self):
+        self.pins, self.data = {}, {}
+
+    def read(self, path, expected=None):
+        path = str(path)
+        if not Path(path).is_absolute():
+            raise ValueError('All frozen file paths must be absolute')
+        if path not in self.data:
+            self.pins[path], self.data[path] = base.analysis.artifact(path)
+        if expected is not None and self.pins[path]['sha256'] != expected:
+            raise ValueError('Frozen hash mismatch: ' + path)
+        return self.data[path]
+
+    def pinned(self, pin):
+        data = self.read(pin['path'], pin['sha256'])
+        if 'bytes' in pin and len(data) != pin['bytes']:
+            raise ValueError('Frozen byte count mismatch: ' + pin['path'])
+        return data
+
+    def verify_again(self):
+        for path, pin in self.pins.items():
+            if base.analysis.artifact(path)[0] != pin:
+                raise ValueError('Input changed during checking: ' + path)
+
+
+def validate_freeze(freeze_path):
+    """Validate the entire inventory before execution or any result comparison."""
+    inventory = Inventory()
+    freeze = base.strict_json(inventory.read(freeze_path))
+    if (freeze.get('schema') != SCHEMA or freeze.get('cpu') != 0
+            or type(freeze.get('cpu')) is not int or freeze.get('one_numerical_thread') is not True
+            or freeze.get('limits') != LIMITS or freeze.get('whole_fit_verified') is not False):
+        raise ValueError('Invalid experiment schema, CPU, thread, scope or limits')
+    for key in ('native', 'runner', 'supervisor', 'python', 'taskset', 'build_result', 'build_manifest', 'source_preparation'):
+        inventory.pinned(freeze[key])
+    build_result = base.strict_json(inventory.pinned(freeze['build_result']))
+    build = base.strict_json(inventory.pinned(freeze['build_manifest']))
+    if (build_result.get('schema') != 'orbit-poc-v41-candidate-build-result-v1'
+            or build_result['execution'].get('status') != 'complete'
+            or build_result['execution'].get('returncode') != 0
+            or build_result.get('inputs_and_originals_unchanged') is not True
+            or build_result.get('boot_unchanged') is not True
+            or build_result.get('native') != freeze['native']
+            or build_result.get('build_manifest') != freeze['build_manifest']
+            or build_result.get('libraries') != freeze['libraries']
+            or build.get('executable_sha256') != freeze['native']['sha256']):
+        raise ValueError('Candidate build receipt does not bind this experiment')
+    inventory.pinned(build_result['build_plan'])
+    compiled = freeze['compiled_extension']
+    expected = build['reliability_v41_profile']['installer_inputs']
+    if not expected or set(compiled) != set(expected):
+        raise ValueError('Missing complete compiled extension snapshot')
+    for name, pin in compiled.items():
+        if pin['sha256'] != expected[name]:
+            raise ValueError('Snapshot differs from compiled installer input: ' + name)
+        inventory.pinned(pin)
+    # Checker and runtime inventories are distinct from the archived compiled source.
+    checker_paths = [Path(__file__), DEPENDENCY, cost.DEPENDENCY, base._ANALYZER]
+    if [x['path'] for x in freeze['checkers']] != [str(x) for x in checker_paths]:
+        raise ValueError('Unexpected scientific checker dependency inventory')
+    for pin in freeze['checkers']:
+        inventory.pinned(pin)
+    libraries = freeze['libraries']
+    if not libraries or len({p['path'] for p in libraries}) != len(libraries):
+        raise ValueError('Missing or duplicate runtime libraries')
+    for library in libraries:
+        inventory.pinned(library)
+    fixed = freeze['environment_fixed']
+    wanted_keys = {*cost.THREAD_KEYS, *FIXED_NATIVE, 'LD_LIBRARY_PATH', 'PYTHONDONTWRITEBYTECODE', 'PYTHONNOUSERSITE'}
+    if (set(fixed) != wanted_keys or any(fixed[k] != '1' for k in cost.THREAD_KEYS)
+            or any(fixed[k] != v for k, v in FIXED_NATIVE.items())
+            or fixed['PYTHONDONTWRITEBYTECODE'] != '1' or fixed['PYTHONNOUSERSITE'] != '1'
+            or fixed['LD_LIBRARY_PATH'] != build_result['runtime_environment']['LD_LIBRARY_PATH']):
+        raise ValueError('Unrecognized or changed native environment/threshold control')
+    prep = base.strict_json(inventory.pinned(freeze['source_preparation']))
+    if prep.get('schema') != 'orbit-poc-nuisance-pair-preparation-v1':
+        raise ValueError('Wrong original scientific preparation')
+    jobs = freeze['jobs']
+    if ([(j['method'], j['accumulate'], j['treatment']) for j in jobs] != expected_jobs()
+            or freeze.get('order') != [j['name'] for j in jobs]
+            or freeze.get('comparisons') != expected_pairs()):
+        raise ValueError('Changed twelve-profile order or eight-pair inventory')
+    roots = set()
+    for job in jobs:
+        m, a, treatment = job['method'], job['accumulate'], job['treatment']
+        if (type(a) is not int or job['name'] != job_name(m, a, treatment)
+                or type(job.get('cache')) is not int or job['cache'] != 1
+                or type(job.get('cost_only_design')) is not int or job['cost_only_design'] != 1):
+            raise ValueError('Invalid profile identity or true cache/cost-only treatment')
+        originals = [j for j in prep['jobs'] if (j['method'], j['accumulate'], j['cache']) == (m, a, 1)]
+        if len(originals) != 1:
+            raise ValueError('Original profile is not unique')
+        old = originals[0]
+        if (job['source_profile'] != {'path': old['profile'], 'sha256': old['profile_sha256']}
+                or cost.exact_inputs(job) != cost.exact_inputs(old)):
+            raise ValueError('Scientific input inventory changed')
+        for pin in job['input_files']:
+            inventory.pinned(pin)
+        original = inventory.pinned(job['source_profile'])
+        actual = inventory.read(job['profile'], job['profile_sha256'])
+        cost.verify_xml(original, actual, job['source_profile']['path'], job['profile'], a)
+        root = Path(job['profile']).parent
+        if str(root) in roots or root.name != job['name'] or root.parent != Path(freeze_path).parent:
+            raise ValueError('Output profile directory is not unique and isolated')
+        roots.add(str(root))
+        if root.is_symlink() or (root / 'scratch').is_symlink() or not (root / 'scratch').is_dir():
+            raise ValueError('Unsafe or missing scratch directory')
+    inventory.verify_again()
+    return freeze, inventory
+
+
+def measured_treatment(run, job, inventory):
+    root = Path(run['root'])
+    flag, storage = TREATMENTS[job['treatment']]
+    count = run['final_generation'] - 1
+    paths = sorted(root.glob('qr.*.nuisance_fixed_dynamics.json'))
+    wanted = {root / f'qr.{g}.nuisance_fixed_dynamics.json' for g in range(1, count + 1)} if flag else set()
+    if set(paths) != wanted:
+        raise ValueError('Fixed-dynamics measured sidecars do not demonstrate actual treatment')
+    previous = (0, 0)
+    for g in range(1, count + 1) if flag else ():
+        value = base.strict_json(inventory.read(root / f'qr.{g}.nuisance_fixed_dynamics.json'))
+        counters = (value.get('omitted_recovery_designs'), value.get('parent_skipped_zero_products'))
+        if (value.get('schema') != 'orbit-poc-nuisance-fixed-dynamics-v1'
+                or value.get('scope') != 'cumulative_parent_process_only_excludes_forked_trial_counters'
+                or any(type(x) is not int or x < old for x, old in zip(counters, previous))):
+            raise ValueError('Invalid fixed-dynamics measured counters')
+        previous = counters
+    if flag and previous[0] <= 0:
+        raise ValueError('Fixed-dynamics recovery design was never omitted')
+    disk = root / 'qr.design_storage.jsonl'
+    rows = []
+    if storage == 'memory':
+        if disk.exists():
+            raise ValueError('Disk storage evidence in memory treatment')
+    else:
+        rows = [base.strict_json(line) for line in inventory.read(disk).splitlines() if line]
+        if not rows:
+            raise ValueError('No measured disk storage evidence')
+        stores = set()
+        for row in rows:
+            dims = [row.get(k) for k in ('rows', 'columns', 'creator_pid', 'pid', 'device', 'inode')]
+            if (row.get('schema') != 'orbit-poc-design-storage-v41'
+                    or any(type(x) is not int or x <= 0 for x in dims)
+                    or row.get('stage') not in ('sealed', 'parameter_update', 'native_covariance', 'observation_covariance')
+                    or row.get('sealed') is not True or row.get('finite_validated') is not True
+                    or row.get('block_rows') != 192 or row.get('cache_block_bound') != 2
+                    or row.get('scratch_reserved_bytes') != row['rows'] * row['columns'] * 8
+                    or row.get('scratch_written_bytes') != row['scratch_reserved_bytes']
+                    or row.get('checksum_kind') != 'fnv1a64_integrity_not_provenance'):
+                raise ValueError('Invalid measured disk storage geometry, capacity or finite validation')
+            for key in ('read_bytes', 'block_loads', 'cache_hits', 'scratch_reserved_bytes', 'scratch_written_bytes'):
+                if type(row.get(key)) is not int or row[key] < 0:
+                    raise ValueError('Invalid disk counter: ' + key)
+            for key in ('write_wall_seconds', 'read_wall_seconds'):
+                if not base.analysis.finite_nonnegative(row.get(key)):
+                    raise ValueError('Invalid disk timing: ' + key)
+            if row['stage'] == 'sealed':
+                stores.add((row['creator_pid'], row['device'], row['inode']))
+        if len(stores) != 2:
+            raise ValueError('Disk treatment did not seal both position/velocity stores')
+        if any((row['creator_pid'], row['device'], row['inode']) not in stores for row in rows):
+            raise ValueError('Disk counter refers to an unsealed store')
+    if any((root / 'scratch').iterdir()):
+        raise ValueError('Scratch files remain after owned cleanup')
+    return {'fixed_dynamics': flag, 'storage': storage, 'fixed_dynamics_counters': list(previous),
+            'storage_records': len(rows), 'cost_only_metrics': cost.verify_metrics(run, 1),
+            'prior_rows': cost.verify_priors(run, job['method'])}
+
+
+def compare(left, right, *, freeze):
+    runs, issues, comparisons, observed = [], [], [], []
+    inventory = None
+    for label, path in [('left', left), ('right', right)]:
+        try:
+            run = base.inspect_run(path)
+            runs.append(run)
+            issues.extend({'side': label, **issue} for issue in run['issues'])
+            if run['profile_classification'] != 'strict_nuisance_convergence':
+                issues.append({'side': label, 'message': 'Strict nuisance convergence required; floor progress is not a pass'})
+        except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
+            runs.append(None)
+            issues.append({'side': label, 'message': str(exc)})
+    if all(runs):
+        for name in sorted(set(runs[0]['artifacts']) | set(runs[1]['artifacts'])):
+            a, b = (r['artifacts'].get(name) for r in runs)
+            equal = a is not None and b is not None and a == b
+            comparisons.append({'artifact': name, 'equal': equal,
+                                'left_sha256': hashlib.sha256(a).hexdigest() if a is not None else None,
+                                'right_sha256': hashlib.sha256(b).hexdigest() if b is not None else None})
+            if not equal:
+                issues.append({'message': 'Missing or changed scientific artifact', 'file': name})
+    try:
+        frozen, inventory = validate_freeze(Path(freeze))
+        selected = []
+        for run in runs:
+            if not run or not run['execution_verified']:
+                raise ValueError('No verified completed execution')
+            matches = [j for j in frozen['jobs'] if j['profile'] == str(Path(run['root']) / 'profile.xml')]
+            if len(matches) != 1:
+                raise ValueError('Run is not a unique frozen profile')
+            job = matches[0]; selected.append(job)
+            execution = run['execution']
+            flag, storage = TREATMENTS[job['treatment']]
+            for key, expected in [('cost_only_design', 1), ('cache', 1), ('blas_openmp_threads', 1),
+                                  ('accumulate_epoch_observations', job['accumulate']), ('fixed_dynamics', flag)]:
+                if type(execution.get(key)) is not int or execution[key] != expected:
+                    raise ValueError('Actual treatment mismatch: ' + key)
+            if (execution.get('storage') != storage or execution.get('environment') != environment(frozen, job)
+                    or execution.get('freeze_sha256') != inventory.pins[str(freeze)]['sha256']
+                    or execution.get('native_binary_sha256') != frozen['native']['sha256']
+                    or execution.get('config_sha256') != job['profile_sha256']
+                    or execution.get('command') != ['/usr/bin/taskset', '-c', '0', frozen['native']['path'], job['profile']]
+                    or execution.get('input_identity_after') != 'verified'):
+                raise ValueError('Runtime execution identity differs from frozen treatment')
+            observed.append(measured_treatment(run, job, inventory))
+        pair = {'left': selected[0]['name'], 'right': selected[1]['name']}
+        if not any(all(p[k] == v for k, v in pair.items()) for p in frozen['comparisons']):
+            raise ValueError('Pair is not one of eight predeclared scientific comparisons')
+        inventory.verify_again()
+    except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
+        issues.append({'message': str(exc)})
+    for run in filter(None, runs):
+        for path, pin in run['provenance'].items():
+            try:
+                if base.analysis.artifact(path)[0] != pin:
+                    raise ValueError('Scientific evidence changed during checking')
+            except (OSError, ValueError) as exc:
+                issues.append({'file': path, 'message': str(exc)})
+    equal = bool(comparisons) and all(c['equal'] for c in comparisons)
+    public = [{k: v for k, v in r.items() if k not in {'artifacts', 'values', 'performance_sidecars', 'provenance'}}
+              if r else None for r in runs]
+    return {'schema': 'orbit-poc-v41-profile-pair-check-v1', 'created_at': datetime.now(timezone.utc).isoformat(),
+            'passed': not issues and equal, 'artifact_equality': equal, 'comparisons': comparisons,
+            'scientific_comparison_count': len(comparisons), 'issues': issues, 'runs': public, 'measured_treatments': observed,
+            'inventory': list(inventory.pins.values()) if inventory else [],
+            'removed_fields': {'nuisance_line_search.trials[*]': list(base.STRIPPED_TRIAL_FIELDS)},
+            'whole_fit_verified': False, 'accepted_covariance': False, 'release_authority': False,
+            'scope': 'Strict fixed-trajectory nuisance profile equivalence only; no whole-fit or covariance claim.'}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('left', type=Path)
+    parser.add_argument('right', type=Path)
+    parser.add_argument('--freeze', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    result = compare(args.left, args.right, freeze=args.freeze)
+    with args.output.open('x') as stream:
+        json.dump(result, stream, indent=2, sort_keys=True, allow_nan=False)
+        stream.write('\n')
+    return 0 if result['passed'] else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
