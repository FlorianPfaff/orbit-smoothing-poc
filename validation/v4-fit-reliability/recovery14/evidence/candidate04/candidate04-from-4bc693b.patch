+
+def change_document(inventory, kind, mutate):
+    row = next(x for x in inventory["files"] if x["kind"] == kind)
+    value = stager.decode(Path(row["source_path"]).read_bytes())
+    mutate(value)
+    raw = stager.encoded(value)
+    row["bytes"] = len(raw)
+    row["sha256"] = sha(raw)
+    Path(row["source_path"]).write_bytes(raw)
+    # Follow incoming JSON artifact pins after intentional fixture edits.
+    for other in inventory["files"]:
+        if other["kind"] != "request" or other is row:
+            continue
+        request = stager.decode(Path(other["source_path"]).read_bytes())
+        for entry in request["estimation_inputs"]:
+            if entry["path"] == row["original_path"]:
+                entry.update(sha256=row["sha256"], bytes=row["bytes"])
+        raw = stager.encoded(request)
+        Path(other["source_path"]).write_bytes(raw)
+        other.update(bytes=len(raw), sha256=sha(raw))
