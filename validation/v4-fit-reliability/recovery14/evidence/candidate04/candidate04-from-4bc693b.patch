+import shutil
+
+import pytest
+
+ROOT = Path(__file__).parents[1]
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    exec(compile(path.read_bytes(), str(path), 'exec'), module.__dict__)
+    return module
+
+
+check = load('v41_profile_checker', ROOT / 'scripts/check_v41_profile_pair.py')
+fixtures = load('existing_cost_fixtures_v41', ROOT / 'tests/test_nuisance_cost_only_pair.py')
+write, pin, change = fixtures.write, fixtures.pin, fixtures.change
+RUNNER_PATH = ROOT / 'scripts/run_v41_profile_pairs.py'
+
+
+def campaign(tmp_path, floor=False):
+    """Create new, true cost-on fixture receipts for all three actual treatments."""
+    seed = tmp_path / 'seed'; seed.mkdir()
+    fixtures.campaign(seed, floor=floor)
+    oldfreeze = json.loads((seed / 'freeze.json').read_text())
+    output = tmp_path / 'profiles'; output.mkdir()
+    native, buildpath = Path(oldfreeze['native']['path']), Path(oldfreeze['build_manifest']['path'])
+    compiled = tmp_path / 'compiled/groops/extension'; compiled.mkdir(parents=True)
+    (compiled / 'designRowsV41.h').write_text('frozen native installer input\n')
+    builder = compiled.parent.parent / 'scripts/build_groops.py'; builder.parent.mkdir()
+    builder.write_text('frozen builder\n')
+    source_pins = {'designRowsV41.h': pin(compiled / 'designRowsV41.h'), 'scripts/build_groops.py': pin(builder)}
+    build = {'executable_sha256': pin(native)['sha256'], 'reliability_v41_profile': {
+        'installer_inputs': {name: p['sha256'] for name, p in source_pins.items()}}}
+    write(buildpath, build)
+    plan = write(tmp_path / 'build-plan.json', {'frozen': True})
+    buildresult = write(tmp_path / 'build-result.json', {
+        'schema': 'orbit-poc-v41-candidate-build-result-v1',
+        'execution': {'status': 'complete', 'returncode': 0}, 'boot_unchanged': True,
+        'inputs_and_originals_unchanged': True, 'native': pin(native),
+        'build_manifest': pin(buildpath), 'libraries': oldfreeze['libraries'], 'build_plan': pin(plan),
+        'runtime_environment': {'LD_LIBRARY_PATH': '/fixed/runtime'}})
+    fixed = dict(check.FIXED_NATIVE, **{k: '1' for k in check.cost.THREAD_KEYS},
+                 LD_LIBRARY_PATH='/fixed/runtime', PYTHONDONTWRITEBYTECODE='1', PYTHONNOUSERSITE='1')
+    freeze = {'schema': check.SCHEMA, 'cpu': 0, 'one_numerical_thread': True, 'limits': check.LIMITS,
+              'whole_fit_verified': False, 'native': pin(native), 'build_result': pin(buildresult),
+              'build_manifest': pin(buildpath), 'compiled_extension': source_pins,
+              'libraries': oldfreeze['libraries'], 'source_preparation': oldfreeze['source_preparation'],
+              'runner': oldfreeze['runner'], 'supervisor': oldfreeze['supervisor'],
+              'python': pin(native), 'taskset': pin(native),
+              'checkers': [pin(p) for p in (ROOT / 'scripts/check_v41_profile_pair.py', check.DEPENDENCY,
+                                          check.cost.DEPENDENCY, check.base._ANALYZER)],
+              'environment_fixed': fixed, 'jobs': [], 'comparisons': check.expected_pairs()}
+    for m, a, t in check.expected_jobs():
+        seedjob = next(j for j in oldfreeze['jobs'] if (j['method'], j['accumulate'], j['cost_only_design']) == (m, a, 1))
+        name = check.job_name(m, a, t)
+        root = output / name
+        shutil.copytree(Path(seedjob['profile']).parent, root)
+        (root / 'scratch').mkdir()
