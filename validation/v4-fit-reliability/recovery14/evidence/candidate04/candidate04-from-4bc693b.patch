+def run(freeze_path):
+    freeze_path=Path(freeze_path).absolute();freeze=validate_freeze(freeze_path);root=freeze_path.parent
+    original_freeze_pin=pin(freeze_path)
+    require(pin(sys.executable)['sha256']==freeze['python']['sha256'],'Runner interpreter differs from freeze')
+    for planned in freeze['jobs']:
+        directory=root/planned['name']
+        require(set(p.name for p in directory.iterdir())=={'request.json','scratch','row-spool'},'Existing attempt output; use a new freeze')
+        validate_owned_storage(freeze,planned)
+        require(all(not any((directory/name).iterdir()) for name in ('scratch','row-spool')),'Nonempty or unsafe scratch')
+    save(root/'run-started.json',{'freeze':pin(freeze_path),'admission':admission(root),
+                                 'started_at':datetime.now(timezone.utc).isoformat()})
+    supervisor=load_module('_wholefit_v41_supervisor',Path(freeze['source_root'])/'src/orbit_poc/segmented/supervisor.py')
+    outcomes=[];launched=set();failure=None
+    try:
+        for planned in freeze['jobs']:
+            verify(original_freeze_pin);validate_freeze(freeze_path)
+            directory=root/planned['name'];save(directory/'admission.json',admission(root))
+            env={k:v for k,v in os.environ.items() if k not in ('PYTHONPATH','PYTHONHOME') and not k.startswith(('ORBIT_POC_','LD_'))}
+            env.update(expected_environment(freeze,planned))
+            argv=planned_argv(freeze,planned,freeze_path)
+            launched.add(planned['name'])
+            measured=supervisor.run_owned(argv,python_executable=freeze['python']['path'],cwd=freeze['source_root'],env=env,
+                log_path=directory/'worker.log',receipt_path=directory/'supervisor.json',timeout_seconds=7200,
+                max_process_tree_rss_bytes=8*1024**3,min_free_disk_bytes=32*1024**3,working_directory=directory)
+            post_issue=None
+            try:
+                verify(original_freeze_pin);validate_freeze(freeze_path)
+            except Exception as exc:post_issue=repr(exc)
+            save(directory/'post-input-check.json',{'verified':post_issue is None,'error':post_issue,'freeze':pin(freeze_path)})
+            status=measured['status']
+            if status=='complete' and (measured['returncode']!=0 or not (directory/'worker-result.json').is_file()):status='failed'
+            record={'schema':'orbit-poc-v41-wholefit-execution-v1','name':planned['name'],'status':status,
+                'freeze':pin(freeze_path),'request':planned['request'],'supervisor':pin(directory/'supervisor.json'),
+                'harness_execution':measured,'post_input_identity_verified':post_issue is None,
+                'worker_result':pin(directory/'worker-result.json') if (directory/'worker-result.json').is_file() else None,
+                'effective_environment':pin(directory/'effective-environment.json') if (directory/'effective-environment.json').is_file() else None,
+                'worker_log':pin(directory/'worker.log'),'post_input_check':pin(directory/'post-input-check.json'),
+                'admission':pin(directory/'admission.json'),'whole_fit_acceptance':'requires_read_only_report',
+                'release_authority':False}
+            save(directory/'execution.json',record);outcomes.append({'name':planned['name'],'status':status,'execution':pin(directory/'execution.json')})
+            print(json.dumps({'job':planned['name'],'status':status,'seconds':measured['elapsed_seconds']}),flush=True)
+            require(post_issue is None and measured.get('owned_process_group_cleaned') is True
+                and measured.get('cleanup',{}).get('verified') is True
+                and measured['cleanup'].get('empty_tree_certificate')=='kernel_ECHILD',
+                'Post-fit identity or owned cleanup failed; further launches refused')
+    except BaseException as exc:failure=repr(exc)
+    by_name={x['name']:x for x in outcomes}
+    save(root/'execution-summary.json',{'schema':'orbit-poc-v41-wholefit-execution-summary-v1','freeze':pin(freeze_path),
+        'error':failure,'attempts':[by_name.get(j['name'],{'name':j['name'],
+         'status':'interrupted_or_unattributed' if j['name'] in launched else 'not_executed'}) for j in freeze['jobs']],
+        'all_planned_attempts_returned':len(outcomes)==2,'release_authority':False,'benchmark68_complete':False})
+    return 1 if failure else 0
