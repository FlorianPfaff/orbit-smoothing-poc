+def xml_closure(tmp_path):
+    inputs=[]
+    for number in (1,2):
+        path=tmp_path/f'G{number}.dat';path.write_text('measurement')
+        inputs.append({'original_path':f'/original/G{number}.dat','staged_path':str(path),'kind':'data'})
+    path=tmp_path/'profile.xml';expression=str(tmp_path/'G{prn}.dat')
+    path.write_text('<root><inputfileObservation>'+expression+'</inputfileObservation></root>')
+    row={'original_path':'/original/profile.xml','staged_path':str(path),'kind':'xml',
+         'xml_replacements':{'/original/G{prn}.dat':expression}}
+    return {'files':inputs+[row],'generated_paths':[], 'xml_input_references':[{
+        'xml':'/original/profile.xml','tag':'inputfileObservation','expression':'/original/G{prn}.dat',
+        'inputs':['/original/G1.dat','/original/G2.dat']}]}
+
