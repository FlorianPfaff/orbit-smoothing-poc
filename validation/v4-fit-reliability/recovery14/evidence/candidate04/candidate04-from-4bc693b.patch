+        path.write_bytes(raw)
+        row = {"original_path": old + "/" + name, "source_path": str(path), "bytes": len(raw), "sha256": sha(raw), "kind": kind}
+        rows.append(row)
+        return {"path": row["original_path"], "sha256": row["sha256"], "bytes": row["bytes"]}
+
+    observation = add("data/obs.dat", "data", b"original observation bytes\x00\x01")
+    xml = add("estimate.xml", "xml", b'<groops>\n  <inputfileObservations>/frozen/v4/data/obs.dat</inputfileObservations>\n  <inputfileVariational>/frozen/v4/generated/variational.dat</inputfileVariational>\n  <outputfile>/frozen/v4/output/fit.txt</outputfile>\n</groops>\n')
+    prep = {"estimation_inputs": [{**observation, "role": "gnss_observations"}],
