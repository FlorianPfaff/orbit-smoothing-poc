+def input_node(node):
+    return node.tag.startswith('inputfile') or (node.tag == 'filename' and node.attrib.get('label') == 'orbitPocCanonicalAttitude')
+
+def output_node(node):
+    return node.tag.startswith('outputfile') or (node.tag == 'filename' and node.attrib.get('label') == 'tmpDir')
