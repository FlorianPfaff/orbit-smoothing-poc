+#!/usr/bin/env python3
+"""Prepare or explicitly execute an isolated twelve-profile v4.1 experiment.
+
+Importing or preparing never launches native work. Run refuses existing execution
+artifacts; interrupted work is retained and requires a separately frozen attempt.
+"""
+from pathlib import Path
+import argparse
+import datetime
+import hashlib
+import importlib.util
+import json
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+B = Path('/home/emper/orbit-v4.1')
+R = Path(__file__).resolve().parents[1]
+SOURCE = Path('/home/emper/orbit-nuisance-performance/paired01/preparation.json')
+CHECKER = R / 'scripts/check_v41_profile_pair.py'
+PYTHON = Path('/mnt/c/users/emper/documents/codex/2026-10-13/i-x20/work/numerics-v3.1/python/bin/python')
+COMPILED = B / 'source-candidate01/groops/extension'
+BUILD_RESULT = B / 'control/build-result01.json'
+_spec = importlib.util.spec_from_file_location('_profile_pairs_checker', CHECKER)
+check = importlib.util.module_from_spec(_spec)
+exec(compile(CHECKER.read_bytes(), str(CHECKER), 'exec'), check.__dict__)
+
+
+def sha(path):
+    result = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            result.update(block)
+    return result.hexdigest()
+
+
+def pin(path):
+    return {'path': str(path), 'sha256': sha(path), 'bytes': Path(path).stat().st_size}
+
+
+def save(path, value):
+    with Path(path).open('x') as stream:
+        json.dump(value, stream, indent=2, sort_keys=True, allow_nan=False)
+        stream.write('\n')
+        stream.flush()
+        os.fsync(stream.fileno())
+
+
+def verify(pins):
+    for item in pins:
+        if sha(item['path']) != item['sha256']:
+            raise ValueError('Changed frozen input: ' + item['path'])
+
+
+def admission():
+    for path in Path('/proc').glob('[0-9]*'):
+        try:
+            name = (path / 'comm').read_text().strip()
+            if name.startswith('groops') or name in ('cc1plus', 'f951', 'ninja', 'segmented_qr'):
+                raise RuntimeError('Competing native workload: ' + str(path) + ' ' + name)
+        except (FileNotFoundError, ProcessLookupError):
+            pass
+    return {'host': os.uname().nodename, 'boot_id': Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+            'cpu': 0, 'scope': 'cooperative current-host check, not exclusive CPU reservation'}
+
+
+def prepare(output, *, build_result=BUILD_RESULT, compiled=COMPILED, source=SOURCE):
+    output = Path(output).absolute()
+    if output.exists() or output.is_symlink() or output.parent.resolve() != output.parent:
+        raise ValueError('Output must be a new directory with a real existing parent')
+    build = check.base.strict_json(Path(build_result).read_bytes())
+    if (build['execution']['status'] != 'complete' or build['execution']['returncode'] != 0
+            or not build['inputs_and_originals_unchanged'] or not build['boot_unchanged']):
+        raise ValueError('No completed identity-preserving candidate build')
+    verify([build['native'], build['build_manifest'], build['build_plan'], *build['libraries']])
+    manifest = check.base.strict_json(Path(build['build_manifest']['path']).read_bytes())
+    compiled_inputs = {}
+    for name, expected in manifest['reliability_v41_profile']['installer_inputs'].items():
+        snapshot_path = compiled.parent.parent / name if name == 'scripts/build_groops.py' else compiled / name
+        item = pin(snapshot_path)
+        if item['sha256'] != expected:
+            raise ValueError('Archived source does not match compiled installer: ' + name)
+        compiled_inputs[name] = item
+    preparation = check.base.strict_json(source.read_bytes())
+    # Finish read-only source validation before creating the attempt directory.
+    originals = {}
+    for method, accumulate, _ in check.GROUP_ORDER:
+        matches = [j for j in preparation['jobs'] if
+                   (j['method'], j['accumulate'], j['cache']) == (method, accumulate, 1)]
+        if len(matches) != 1:
+            raise ValueError('Original scientific fixture is not unique')
+        old = matches[0]
+        verify([{'path': old['profile'], 'sha256': old['profile_sha256']}, old['source_profile'], *old['input_files']])
+        originals[method, accumulate] = old
+    output.mkdir()
+    jobs = []
+    try:
+        for method, accumulate, treatment in check.expected_jobs():
+            old = originals[method, accumulate]
+            name = check.job_name(method, accumulate, treatment)
+            root = output / name
+            root.mkdir()
+            (root / 'scratch').mkdir(mode=0o700)
+            original = Path(old['profile']).read_bytes()
+            actual = original.replace(str(Path(old['profile']).parent).encode(), str(root).encode())
+            profile = root / 'profile.xml'
+            check.cost.verify_xml(original, actual, old['profile'], profile, accumulate)
+            for node in ET.fromstring(actual).iter():
+                if not node.text or not (node.tag.startswith('outputfile') or
+                                         node.tag == 'filename' and node.attrib.get('label') == 'tmpDir'):
+                    continue
+                path = Path(node.text)
+                if not path.is_absolute() or not path.is_relative_to(root) or '..' in path.parts:
+                    raise ValueError('External or unsafe native output: ' + node.text)
+                (path if node.tag == 'filename' else path.parent).mkdir(parents=True, exist_ok=True)
+            with profile.open('xb') as stream:
+                stream.write(actual)
+            jobs.append({'name': name, 'method': method, 'accumulate': accumulate, 'treatment': treatment,
+                         'cache': 1, 'cost_only_design': 1, 'profile': str(profile), 'profile_sha256': sha(profile),
+                         'source_profile': {'path': old['profile'], 'sha256': old['profile_sha256']},
+                         'input_files': [{'path': p['path'], 'sha256': p['sha256']} for p in old['input_files']]})
+        fixed = dict(check.FIXED_NATIVE, **{key: '1' for key in check.cost.THREAD_KEYS},
+                     PYTHONDONTWRITEBYTECODE='1', PYTHONNOUSERSITE='1', **build['runtime_environment'])
+        freeze = {'schema': check.SCHEMA, 'created_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                  'native': build['native'], 'build_manifest': build['build_manifest'], 'build_result': pin(build_result),
+                  'libraries': build['libraries'], 'compiled_extension': compiled_inputs,
+                  'source_preparation': pin(source), 'runner': pin(Path(__file__)),
+                  'supervisor': pin(R / 'src/orbit_poc/segmented/supervisor.py'),
+                  'python': pin(PYTHON), 'taskset': pin(Path('/usr/bin/taskset')),
+                  'checkers': [pin(p) for p in (CHECKER, check.DEPENDENCY, check.cost.DEPENDENCY, check.base._ANALYZER)],
+                  'jobs': jobs, 'order': [j['name'] for j in jobs], 'comparisons': check.expected_pairs(),
+                  'environment_fixed': fixed, 'limits': check.LIMITS, 'cpu': 0,
+                  'one_numerical_thread': True, 'whole_fit_verified': False,
+                  'scope': 'Fixed-trajectory nuisance equivalence; thresholds and cold checks unchanged.'}
+        save(output / 'freeze.json', freeze)
+        check.validate_freeze(output / 'freeze.json')
+        save(output / 'prepared.json', {'status': 'prepared_not_executed', 'freeze': pin(output / 'freeze.json'),
+                                       'profiles': 12, 'comparisons': 8})
+    except BaseException as exc:
+        save(output / 'preparation-failure.json', {'status': 'failed', 'error': repr(exc), 'partial_outputs_retained': True})
+        raise
+    return output / 'freeze.json'
+
+
+def run(freeze_path):
+    freeze_path = Path(freeze_path).absolute()
+    freeze, inventory = check.validate_freeze(freeze_path)
+    inventory.data.clear()  # Keep source bytes outside the timed native process tree.
+    if (Path(__file__).absolute() != Path(freeze['runner']['path'])
+            or sha(sys.executable) != freeze['python']['sha256']):
+        raise ValueError('Runner or executing Python differs from the frozen runtime')
+    root = freeze_path.parent
+    for job in freeze['jobs']:
+        directory = Path(job['profile']).parent
+        if any(directory.glob('qr.*')) or any((directory / name).exists() for name in
+               ('profile.execution.json', 'profile.log', 'supervisor.json', 'admission.json')):
+            raise ValueError('Run refuses existing execution artifacts: ' + str(directory))
+        if any((directory / 'scratch').iterdir()):
+            raise ValueError('Scratch is not empty before launch')
+    # Claim only this attempt, never kill unrelated jobs or modify old experiments.
+    save(root / 'run-started.json', {'freeze': pin(freeze_path), 'admission': admission(),
+                                   'started_at': datetime.datetime.now(datetime.timezone.utc).isoformat()})
+    sys.path.insert(0, str(R / 'src'))
+    from orbit_poc.segmented.supervisor import run_owned
+    results = []
+    launched = set()
+    error = None
+    try:
+        for job in freeze['jobs']:
+            inventory.verify_again()
+            directory = Path(job['profile']).parent
+            save(directory / 'admission.json', admission())
+            recorded_env = check.environment(freeze, job)
+            env = {k: v for k, v in os.environ.items() if not k.startswith('ORBIT_POC_') and k not in ('PYTHONPATH', 'PYTHONHOME')}
+            env.update(recorded_env)
+            argv = ['/usr/bin/taskset', '-c', '0', freeze['native']['path'], job['profile']]
+            launched.add(job['name'])
+            result = run_owned(argv, python_executable=freeze['python']['path'], cwd=directory, env=env,
+                               log_path=directory / 'profile.log', receipt_path=directory / 'supervisor.json',
+                               timeout_seconds=7200, max_process_tree_rss_bytes=8 * 1024**3,
+                               min_free_disk_bytes=16 * 1024**3, working_directory=directory)
+            identity = 'verified'
+            try:
+                inventory.verify_again()
+            except Exception:
+                identity = 'changed'
+            flag, storage = check.TREATMENTS[job['treatment']]
+            record = {'environment': recorded_env, 'command': argv, 'config_sha256': job['profile_sha256'],
+                      'native_binary_sha256': freeze['native']['sha256'], 'elapsed_seconds': result['elapsed_seconds'],
+                      'returncode': result['returncode'], 'timed_out': result['status'] == 'timeout', 'status': result['status'],
+                      'peak_rss_bytes': result['peak_process_tree_rss_bytes'], 'blas_openmp_threads': 1,
+                      'cache': 1, 'cost_only_design': 1, 'fixed_dynamics': flag, 'storage': storage,
+                      'accumulate_epoch_observations': job['accumulate'],
+                      'owned_process_group_cleaned': result['owned_process_group_cleaned'],
+                      'supervisor_sha256': sha(directory / 'supervisor.json'),
+                      'input_identity_after': identity, 'freeze_sha256': sha(freeze_path)}
+            save(directory / 'profile.execution.json', record)
+            results.append({'job': job['name'], **record})
+            print(json.dumps({'job': job['name'], 'status': result['status'], 'seconds': result['elapsed_seconds']}), flush=True)
+            if (identity != 'verified' or not result['owned_process_group_cleaned']
+                    or not result['cleanup']['verified'] or result['cleanup'].get('empty_tree_certificate') != 'kernel_ECHILD'):
+                raise RuntimeError('Identity or owned cleanup not verified; further launches prohibited')
+    except BaseException as exc:
+        error = repr(exc)
+    by_name = {r['job']: r for r in results}
+    report = {'schema': 'orbit-poc-v41-profile-attempts-v1', 'error': error,
+              'all_planned_attempts_executed': len(results) == 12,
+              'attempts': [by_name.get(j['name'], {'job': j['name'], 'status': 'interrupted_or_unattributed' if j['name'] in launched else 'not_executed'}) for j in freeze['jobs']],
+              'whole_fit_verified': False, 'accepted_covariance': False, 'release_authority': False}
+    save(root / 'result.json', report)
+    pairs = []
+    for pair in freeze['comparisons']:
+        item = check.compare(root / pair['left'], root / pair['right'], freeze=freeze_path)
+        path = root / (pair['left'] + '--' + pair['right'] + '.comparison.json')
+        save(path, item)
+        pairs.append({**pair, 'passed': item['passed'], 'report': pin(path)})
+    save(root / 'comparison-summary.json', {'pairs': pairs, 'passed': all(p['passed'] for p in pairs),
+                                          'whole_fit_verified': False, 'accepted_covariance': False, 'release_authority': False})
+    return 0 if error is None and all(p['passed'] for p in pairs) else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest='command', required=True)
+    prep = sub.add_parser('prepare')
+    prep.add_argument('--output', type=Path, default=B / 'profile-pairs01')
+    execute = sub.add_parser('run')
+    execute.add_argument('--freeze', type=Path, required=True)
+    args = parser.parse_args()
+    if args.command == 'prepare':
+        print(prepare(args.output))
+        return 0
+    return run(args.freeze)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
