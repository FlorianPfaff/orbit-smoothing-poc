+def admission(root):
+    import psutil
+    require(0 in os.sched_getaffinity(0),'CPU0 is not available')
+    require(psutil.virtual_memory().available>=LIMITS['minimum_available_bytes'],'Insufficient available memory')
+    require(shutil.disk_usage(root).free>=LIMITS['min_free_disk_bytes'],'Insufficient free output space')
+    conflicts=[]
+    for p in psutil.process_iter(['pid','name']):
+        try:
+            name=p.info['name'] or ''
+            if p.pid!=os.getpid() and (name.startswith('groops') or name in ('cc1plus','f951','ninja','segmented_qr','orbit-poc-segmented-qr')):
+                conflicts.append({'pid':p.pid,'name':name})
+        except (psutil.NoSuchProcess,psutil.AccessDenied):continue
+    require(not conflicts,'Competing native workload: '+str(conflicts))
+    return {'hostname':os.uname().nodename,'boot_id':Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+            'cpu':0,'conflicting_processes':conflicts,'filesystem':disk_filesystem(root),
+            'free_output_bytes':shutil.disk_usage(root).free,'available_memory_bytes':psutil.virtual_memory().available,
+            'scope':'Cooperative current-host check; no exclusive reservation claim.'}
