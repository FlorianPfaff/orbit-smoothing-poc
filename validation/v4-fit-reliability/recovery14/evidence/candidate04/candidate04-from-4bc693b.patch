+def rebind(staged, experiment, source_hash, native, protocol_hash):
+    value=copy.deepcopy(staged)
+    value.update(id=experiment+'--'+staged['id'],split='v41_reliability_regression',source_hash=source_hash,
+        protocol_hash=protocol_hash,segmented_manifest_hash=protocol_hash,expected_native_binary_sha256=native['sha256'])
+    value['backend'].update(groops_executable=native['path'],diagnostic_native={'path':native['path'],'sha256':native['sha256']})
+    value['input_manifest_hash']=canonical(value['estimation_inputs'])
+    value['job_sha256']=canonical({k:v for k,v in value.items() if k!='job_sha256'})
+    require(all(value[k]==staged[k] for k in JOB_FIELDS-REBIND_FIELDS),'Unpermitted scientific change during rebinding')
+    return value
+
+
+def staged_requests(spec):
+    manifest=read(verify(spec['staging_manifest']));plan=read(verify(spec['staging_plan']));audit=read(verify(spec['staging_audit']))
+    require(manifest.get('schema')=='orbit-poc-v41-input-staging-result-v1'
+        and manifest.get('status')=='prepared_inputs_only' and manifest.get('launch_ready') is False
+        and manifest.get('native_execution') is False,'Staging receipt grants no valid input authority')
+    require(manifest['plan_sha256']==spec['staging_plan']['sha256'] and plan['status']=='ready_to_stage'
+        and not plan['missing_execution_inputs'],'Staging closure is incomplete')
+    require(audit.get('passed') is True and audit['plan']['sha256']==spec['staging_plan']['sha256']
+        and audit['manifest']['sha256']==spec['staging_manifest']['sha256'],'Independent staging audit is absent or mismatched')
+    require(set(manifest['completed_files'])=={r['original_path'] for r in plan['files']},'Incomplete staging receipt')
+    # The entire mirror is pinned, including every wildcard-visible native file.
+    for row in plan['files']:
+        verify({'path':row['staged_path'],'sha256':row['staged_sha256'],'bytes':row['staged_bytes']})
+        verify({'path':row['original_copy'],'sha256':row['sha256'],'bytes':row['bytes']})
+    verify_staged_xml(plan)
+    jobs=[]
+    for case in CASES:
+        suffix='/run/attempts/'+case+'/request.json'
+        matches=[r for r in plan['files'] if r['kind']=='request' and r['original_path'].endswith(suffix)]
+        require(len(matches)==1,'Missing exact executable attempt request: '+case)
+        row=matches[0];original=read(row['original_copy']);staged=read(row['staged_path'])
+        original_contract(original);original_contract(staged)
+        restored=copy.deepcopy(staged)
+        for edit in reversed(plan['json_edit_journals'][row['original_path']]):
+            cursor=restored
+            for key in edit['path'][:-1]:cursor=cursor[key]
+            require(cursor[edit['path'][-1]]==edit['after'],'Invalid staging inverse edit')
+            cursor[edit['path'][-1]]=edit['before']
+        require(restored==original,'Staging changed the original scientific request')
+        require(all(original[k]==staged[k] for k in JOB_FIELDS-{'estimation_inputs','input_manifest_hash','job_sha256'}),
+                'Staging changed fields outside remapped inputs')
+        blind_closure(staged,plan)
+        jobs.append({'case_id':case,'original':pin(row['original_copy']),'staged':pin(row['staged_path']),
+                     'original_path':row['original_path'],'staged_value':staged})
+    return plan,jobs
+
