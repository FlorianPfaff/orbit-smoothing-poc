+def expected_environment(freeze,planned):
+    root=Path(freeze['root'])/planned['name']
+    return {**freeze['environment'],'ORBIT_POC_GNSS_DESIGN_SCRATCH':str(root/'scratch'),
+            'ORBIT_POC_NUMERICS_SPOOL_DIRECTORY':str(root/'row-spool')}
