+    if not isinstance(generated, list) or len(generated) > MAX_FILES or not all(isinstance(x, str) for x in generated) or len(set(generated)) != len(generated):
+        raise ValueError("Invalid generated-path inventory")
+    for name in generated:
+        absolute(name)
+        if name in originals or not any(within(name, p) for p in prefixes):
+            raise ValueError("Generated path conflicts with captured inputs or prefixes")
