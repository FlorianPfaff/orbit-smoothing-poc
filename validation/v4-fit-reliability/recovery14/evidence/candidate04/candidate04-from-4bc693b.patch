+                'status': 'interrupted_or_unattributed' if j['name'] in launched else 'not_executed'}) for j in freeze['jobs']]
+    passed = failure is None and all(x['passed'] for x in attempts)
+    save(root / 'result.json', {'schema': 'orbit-poc-v41-regression-profile-result-v1', 'freeze': pin(freeze_path),
+                              'attempts': attempts, 'passed': passed, 'error': failure,
+                              'whole_fit_verified': False, 'accepted_covariance': False, 'release_authority': False})
+    return 0 if passed else 1
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest='command', required=True)
+    p = sub.add_parser('prepare'); p.add_argument('--output', type=Path, required=True)
+    p.add_argument('--staged', type=Path, default=B / 'inputs/regressions01')
+    p = sub.add_parser('run'); p.add_argument('--freeze', type=Path, required=True)
+    args = parser.parse_args(argv)
+    if args.command == 'prepare':
+        print(prepare(args.output, args.staged)); return 0
+    return run(args.freeze)
+
+if __name__ == '__main__':
+    raise SystemExit(main())
