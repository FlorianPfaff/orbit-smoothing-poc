+def pin(path, *, data=False):
+    path = Path(path).absolute()
+    if data:
+        stage.no_symlinks(str(path), file=True)
+    before = identity(path)
+    value = {'path': str(path), 'sha256': stage.digest(path), 'bytes': before[2]}
+    if identity(path) != before:
+        raise ValueError('File changed during hashing: ' + str(path))
+    return value
