+def terminal_binding(evidence, freeze, planned, freeze_path):
+    """Bind actual resource supervision and effective treatment, including failures."""
+    root=Path(freeze['root'])/planned['name'];receipt=evidence.json(root/'execution.json')
+    started=evidence.json(Path(freeze['root'])/'run-started.json')
+    require(started.get('freeze')==pin(freeze_path),'Run-start identity differs from the prepared freeze')
+    if (Path(freeze['root'])/'execution-summary.json').exists():
+        summary=evidence.json(Path(freeze['root'])/'execution-summary.json')
+        require(summary.get('freeze')==pin(freeze_path) and [x.get('name') for x in summary.get('attempts',[])]==list(CASES),
+            'Execution summary differs from the frozen experiment')
+    require(receipt.get('schema')=='orbit-poc-v41-wholefit-execution-v1' and receipt.get('name')==planned['name']
+        and receipt.get('release_authority') is False and receipt.get('whole_fit_acceptance')=='requires_read_only_report',
+        'Unknown terminal receipt or invalid authority')
+    require(receipt['freeze']==pin(freeze_path) and receipt['request']==planned['request'],'Terminal receipt attribution differs')
+    for key,name in [('supervisor','supervisor.json'),('post_input_check','post-input-check.json'),
+                     ('admission','admission.json'),('worker_log','worker.log'),
+                     ('effective_environment','effective-environment.json'),('worker_result','worker-result.json')]:
+        item=receipt.get(key);path=root/name
+        if item is None:
+            require(key in ('effective_environment','worker_result') and not path.exists(),'Unpinned existing execution evidence: '+key)
+        else:
+            require(Path(item['path'])==path,'Execution evidence leaves the isolated attempt: '+key);evidence.verify(item)
+    sup=evidence.json(root/'supervisor.json');require(sup==receipt['harness_execution'],'Supervisor receipt differs')
+    require(sup.get('schema')=='orbit-poc-segmented-supervision-v1'
+        and sup.get('status') in {'complete','failed','timeout','memory_limit','disk_limit','interrupted'}
+        and type(sup.get('returncode')) is int,'Unknown/nonterminal supervisor outcome')
+    require(sup.get('owned_process_group_cleaned') is True and sup.get('cleanup',{}).get('verified') is True
+        and sup['cleanup'].get('empty_tree_certificate')=='kernel_ECHILD','Terminal worker ownership is not closed')
+    plan=evidence.json(root/'supervisor.plan.json');admitted=evidence.json(root/'admission.json')
+    require(sup.get('plan_sha256')==evidence.fingerprint(root/'supervisor.plan.json')['sha256'],'Supervisor plan differs')
+    argv=planned_argv(freeze,planned,freeze_path)
+    helper=freeze['source_inventory']['files']['src/orbit_poc/segmented/supervisor.py']
+    require(sup.get('argv')==argv and plan.get('argv')==argv,'Executed command differs from frozen worker')
+    require(sup.get('helper_sha256')==helper and plan.get('helper_sha256')==helper,'Unpinned supervision implementation')
+    require(plan.get('schema')=='orbit-poc-segmented-supervision-plan-v1' and plan.get('timeout_seconds')==7200
+        and plan.get('max_process_tree_rss_bytes')==8*1024**3 and plan.get('min_free_disk_bytes')==32*1024**3
+        and plan.get('cwd')==freeze['source_root'] and plan.get('working_directory')==str(root)
+        and plan.get('log_path')==str(root/'worker.log') and plan.get('receipt_path')==str(root/'supervisor.json'),
+        'Supervised resources, working roots or output paths changed')
+    require(admitted.get('boot_id') and plan.get('boot_id')==admitted['boot_id'] and sup.get('boot_id')==admitted['boot_id']
+        and admitted.get('cpu')==0 and admitted.get('conflicting_processes')==[], 'Wrong host admission or changed boot')
+    require(type(sup.get('elapsed_seconds')) in (int,float) and math.isfinite(sup['elapsed_seconds'])
+        and sup['elapsed_seconds']>=0 and type(sup.get('peak_process_tree_rss_bytes')) is int
+        and sup['peak_process_tree_rss_bytes']>=0,'Invalid measured resource counters')
+    post=evidence.json(root/'post-input-check.json')
+    require(receipt.get('post_input_identity_verified') is True and post.get('verified') is True
+        and post.get('error') is None and post.get('freeze')==pin(freeze_path),'Post-fit input verification failed')
+    env=evidence.json(root/'effective-environment.json') if receipt.get('effective_environment') else None
+    if env is not None:
+        require(env.get('schema')=='orbit-poc-v41-wholefit-environment-v1'
+            and env.get('environment')==expected_environment(freeze,planned)
+            and env.get('freeze_sha256')==pin(freeze_path)['sha256'] and env.get('request')==planned['request']
+            and env.get('source_root')==freeze['source_root'] and env.get('boot_id')==admitted['boot_id']
+            and env.get('cpu_affinity')==[0] and type(env.get('pid')) is int
+            and env['pid']==sup.get('worker',{}).get('pid'),'Effective worker treatment differs')
+    worker_result=evidence.json(root/'worker-result.json') if receipt.get('worker_result') else None
+    status=sup['status']
+    if status=='complete' and (sup['returncode']!=0 or worker_result is None):status='failed'
+    require(receipt.get('status')==status,'Terminal outcome upgraded or altered')
+    if status=='complete':require(env is not None,'Completed worker has no effective treatment receipt')
+    return receipt,sup,worker_result
