+def build_identity(pin_record):
+    build=read(verify(pin_record));execution=build.get('execution',{})
+    require(build.get('schema')=='orbit-poc-v41-candidate-build-result-v1' and execution.get('status')=='complete'
+        and execution.get('returncode')==0 and build.get('inputs_and_originals_unchanged') is True
+        and build.get('boot_unchanged') is True,'Candidate build did not complete with preserved identity')
+    verify(build['native']);manifest=read(verify(build['build_manifest']));verify(build['build_plan'])
+    require(manifest.get('executable_sha256')==build['native']['sha256'] and 'reliability_v41_profile' in manifest,
+            'Build does not bind the v4.1 native executable')
+    require(build['libraries'] and len({p['path'] for p in build['libraries']})==len(build['libraries']),'Invalid native library inventory')
+    for library in build['libraries']:verify(library)
+    require(set(build.get('runtime_environment',{}))=={'LD_LIBRARY_PATH'}
+        and isinstance(build['runtime_environment']['LD_LIBRARY_PATH'],str), 'Unknown native runtime controls')
+    require(build.get('patched_source'),'Missing compiled source identity')
+    profile=manifest['reliability_v41_profile'];compiled=profile.get('patched_source',{})
+    require(profile.get('schema')=='orbit-poc-reliability-v41-build-profile-v1'
+        and compiled.get('files')==build['patched_source'] and compiled.get('sha256')==canonical(build['patched_source']),
+        'Compiled source snapshot does not match the build receipt')
+    required_receipts={'orbit-poc-extension.json','orbit-poc-segmented-extension.json',
+        'orbit-poc-wide-tangent-extension.json','orbit-poc-nuisance-performance-extension.json',
+        'orbit-poc-variational-memory-extension.json','orbit-poc-nuisance-v41-extension.json',
+        'orbit-poc-design-storage-v41-extension.json'}
+    require(set(profile.get('overlay_receipts',{}))==required_receipts,'Missing required native features')
+    receipts={}
+    for name,digest in profile['overlay_receipts'].items():
+        receipts[name]=read(verify({'path':str(Path(build['source_root'])/name),'sha256':digest}))
+    variational=receipts['orbit-poc-variational-memory-extension.json']
+    require(variational==manifest.get('variational_memory_extension')
+        and variational.get('schema')=='orbit-poc-variational-memory-install-v1'
+        and variational.get('environment')=='ORBIT_POC_VARIATIONAL_BLOCK_EPOCHS'
+        and variational.get('models_thresholds_and_native_operator')=='unchanged',
+        'Build lacks the bounded variational closure implementation')
+    require(receipts['orbit-poc-nuisance-v41-extension.json'].get('schema')=='orbit-poc-nuisance-v41-extension-v1'
+        and receipts['orbit-poc-design-storage-v41-extension.json'].get('schema')=='orbit-poc-design-storage-v41-install-v1',
+        'Build lacks fixed-dynamics/disk-storage features')
+    for name,digest in build['patched_source'].items():
+        require(not Path(name).is_absolute() and '..' not in Path(name).parts,'Escaping compiled source identity')
+        verify({'path':str(Path(build['source_root'])/name),'sha256':digest})
+    return build
+
