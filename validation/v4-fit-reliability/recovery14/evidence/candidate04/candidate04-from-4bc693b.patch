+def row_support(path):
+    digest, count = hashlib.sha256(), 0
+    with Path(path).open() as stream:
+        if stream.readline() != 'row\tepoch\tsource\trhs\tcolumns\n':
+            raise ValueError('Unrecognized weighted-row provenance')
+        for line in stream:
+            fields = line.rstrip('\n').split('\t')
+            if len(fields) != 5 or fields[0] != str(count) or not math.isfinite(float(fields[3])):
+                raise ValueError('Malformed weighted-row provenance')
+            digest.update(('\t'.join([*fields[:3], fields[4]]) + '\n').encode()); count += 1
+    if not count:
+        raise ValueError('Empty weighted-row support')
+    return digest.hexdigest(), count
+
+
+def search_evidence(search, performance, fixed, previous_fixed, expected_signature):
+    zero = search.get('zero_update_replay', {})
+    if (type(zero.get('status')) is not int or zero['status'] != 0 or zero.get('actual_reduction') != 0
+        or zero.get('maximum_update_m') != 0 or not check.analysis.finite_nonnegative(zero.get('cost'))):
+        raise ValueError('Mandatory zero/cold replay failed or missing')
+    check.analysis.validate_performance(performance, search)
+    signatures = [x.get('observation_signature') for x in search.get('trials', []) if x.get('status') == 0]
+    if (not signatures or any(not isinstance(x, str) or not x.isdigit() for x in signatures)
+        or len(set(signatures)) != 1 or expected_signature is not None and signatures[0] != expected_signature):
+        raise ValueError('Fixed observations/weights fingerprint changed or missing')
+    if (fixed.get('schema') != 'orbit-poc-nuisance-fixed-dynamics-v1'
+        or fixed.get('scope') != 'cumulative_parent_process_only_excludes_forked_trial_counters'):
+        raise ValueError('Missing fixed-dynamics counter authority')
+    for key in ('omitted_recovery_designs', 'parent_skipped_zero_products'):
+        if type(fixed.get(key)) is not int or fixed[key] <= 0 or fixed[key] < previous_fixed.get(key, 0):
+            raise ValueError('Invalid/decreasing fixed-dynamics counters')
+    parent = performance['parent_row_build']
+    if fixed['omitted_recovery_designs'] - previous_fixed.get('omitted_recovery_designs', 0) != parent['observation_design_calls']:
+        raise ValueError('Recovery omission counters disagree with measured GNSS support')
+    for child, row in [(False, parent), (True, performance['zero_update_replay']['row_build']),
+                       *[(True, x['row_build']) for x in performance['ordinary_trials'] if x['status'] == 0]]:
+        if (row.get('available') is not True or row.get('completed') is not True or row.get('cost_only') is not child
+            or row.get('cost_only_design') is not True or row.get('interpolation_cache') is not True):
+            raise ValueError('Actual native treatment differs from frozen environment')
+        if not child and row.get('omitted_dynamic_designs') != 0:
+            raise ValueError('Full row build omitted dynamic derivatives')
+        if child and (row.get('omitted_dynamic_designs', 0) <= 0 or row.get('interpolation_calls') != 0):
+            raise ValueError('Cost-only treatment was not exercised')
+    return signatures[0]
+
+
+def inspect_result(root, execution):
+    root = Path(root)
+    issues, artifacts = [], []
+    classification, final, storage = 'invalid_or_unfinished_profile', None, []
+    support, observation_signature, previous_fixed = None, None, {}
+    try:
+        profile = read(root / 'qr.profile.json')
+        classification = strict_profile(profile)
+        final = profile['iterations'] + 1
+        present = {int(m[1]) for p in root.glob('qr.*') if (m := re.fullmatch(r'qr\.(\d+)\.factor\.json', p.name))}
+        if present != set(range(1, final + 1)):
+            raise ValueError('Scientific generations are missing, extra or noncontiguous')
+        for generation in range(1, final + 1):
+            for suffix in check.REQUIRED_FACTOR:
+                artifacts.append(pin(root / f'qr.{generation}.{suffix}', data=True))
+            generation_support = row_support(root / f'qr.{generation}.rows.tsv')
+            if support is not None and support != generation_support:
+                raise ValueError('Weighted-row support or prior/parameter ownership changed')
+            support = generation_support
+            if generation < final:
+                search = read(root / f'qr.{generation}.nuisance_line_search.json')
+                artifacts.append(pin(root / f'qr.{generation}.nuisance_line_search.json', data=True))
+                artifacts.append(pin(root / f'qr.{generation}.receiver_times.tsv', data=True))
+                perf = root / f'qr.{generation}.nuisance_performance.json'
+                fixed_path = root / f'qr.{generation}.nuisance_fixed_dynamics.json'
+                fixed = read(fixed_path)
+                observation_signature = search_evidence(search, read(perf), fixed, previous_fixed, observation_signature)
+                previous_fixed = fixed
+                artifacts.extend([pin(perf, data=True), pin(fixed_path, data=True)])
+            elif (root / f'qr.{generation}.nuisance_line_search.json').exists():
+                raise ValueError('Final factor is not a fresh linearization')
+        diagnostics, factor = read(root / f'qr.{final}.diagnostics.json'), read(root / f'qr.{final}.factor.json')
+        if diagnostics.get('rank_status') != 'full' or type(diagnostics.get('lambda')) is bool or diagnostics.get('lambda') != 0:
+            raise ValueError('Final factor lacks undamped full-rank certificate')
+        n = factor.get('rows')
+        if n != factor.get('columns'):
+            raise ValueError('Final factor is not square')
+        matrix_finite(root / f'qr.{final}.R.bin', n, n)
+        matrix_finite(root / f'qr.{final}.rhs.bin', n, 1)
+    except (OSError, ValueError, KeyError, TypeError, AttributeError) as exc:
+        issues.append(str(exc))
+    # Retain counters even on a timeout or native failure; do not load row spools.
+    for path in sorted(root.glob('qr*.design_storage.jsonl')):
+        try:
+            artifacts.append(pin(path, data=True))
+            with path.open() as inp:
+                for line in inp:
+                    if len(line) > 65536:
+                        raise ValueError('Oversized storage metric')
+                    value = check.strict_json(line)
+                    if value.get('schema') != 'orbit-poc-design-storage-v41' or value.get('sealed') is not True or value.get('finite_validated') is not True:
+                        raise ValueError('Unsealed or unvalidated storage metric')
+                    storage.append(value)
+        except (OSError, ValueError) as exc:
+            issues.append(str(exc))
+    for path in sorted(root.glob('qr.*.nuisance_fixed_dynamics.json')):
+        artifacts.append(pin(path, data=True))
+    if not storage:
+        issues.append('No actual disk-storage ingestion/counter evidence')
+    scratch_clean = (root / 'scratch').is_dir() and not any((root / 'scratch').iterdir())
+    if not scratch_clean:
+        issues.append('Scratch names remain after owned process cleanup')
+    cleanup = execution.get('owned_process_group_cleaned') is True and execution.get('cleanup', {}).get('verified') is True and execution['cleanup'].get('empty_tree_certificate') == 'kernel_ECHILD'
+    terminal = execution.get('status') == 'complete' and type(execution.get('returncode')) is int and execution['returncode'] == 0
+    if not cleanup or not terminal or execution.get('input_identity_after') != 'verified':
+        issues.append('Native completion, identity preservation or owned cleanup was not verified')
+    return {'classification': classification, 'passed': classification == 'strict_nuisance_convergence' and not issues,
+            'issues': issues, 'final_generation': final, 'storage_metrics': storage, 'scratch_names_clean': scratch_clean,
+            'scratch_descriptor_cleanup': 'kernel_ECHILD owned-tree certificate' if cleanup else 'unverified',
+            'row_support': support, 'observation_and_weight_signature': observation_signature,
+            'artifacts': artifacts, 'whole_fit_verified': False, 'accepted_covariance': False, 'release_authority': False}
