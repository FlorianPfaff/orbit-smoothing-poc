+def report(freeze_path,output):
+    freeze_path=Path(freeze_path).absolute();freeze=validate_freeze(freeze_path);output=safe_new(output)
+    checker=load_module('_wholefit_v41_scientific_checks',verify(freeze['checker_dependencies'][0]))
+    attempts=[]
+    for planned in freeze['jobs']:
+        try:attempts.append(inspect_terminal(freeze,planned,freeze_path,checker))
+        except (OSError,ValueError,KeyError,TypeError) as exc:
+            attempts.append({'name':planned['name'],'status':'invalid_or_unverified_evidence','whole_fit_complete':False,
+                             'accepted_covariance':False,'issues':[repr(exc)]})
+    validate_freeze(freeze_path)
+    output.mkdir();summary={'schema':'orbit-poc-v41-wholefit-report-v1','freeze':pin(freeze_path),'attempts':attempts,
+        'all_two_regressions_strictly_complete':all(x['whole_fit_complete'] for x in attempts),
+        'release_authority':False,'benchmark68_complete':False,
+        'input_isolation':ISOLATION,
+        'scope':'Two outcome-selected dense regressions only; strict final nuisance, undamped rank and covariance gates remain required. No equivalence/speedup or full release claim.'}
+    save(output/'summary.json',summary)
+    import html
+    rows=''.join('<tr>'+''.join('<td>'+html.escape(str(x.get(k,'')))+'</td>' for k in
+                  ('name','status','whole_fit_complete','accepted_covariance'))+'</tr>' for x in attempts)
