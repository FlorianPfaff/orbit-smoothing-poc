+"""Pending candidate03 native gates; run only with an explicit new binary.
+
+Never compiled/launched by the implementation task. These compare the actual
+native compact and full-constrained factors on identical original weighted rows.
+GNSS whole-profile and independent GTSAM gates remain separately required.
+"""
+import errno
+import json
+import os
+from pathlib import Path
+import resource
+import signal
+import subprocess
+import xml.etree.ElementTree as ET
+
+import numpy as np
+import pytest
+
+
+@pytest.fixture
+def candidate03_native():
+    binary = os.environ.get('ORBIT_POC_V41_CONDITIONAL_NATIVE')
+    if not binary:
+        pytest.skip('Explicit candidate03 binary required; pure tests do not validate native equivalence')
+    return binary
+
+
+def run_fixture(binary, root, a, b, *, compact=True, locals=2, mask='1010', group=False,
+                block=17, covariance=False, nuisance_only=True, damping=0., file_limit=None):
+    root.mkdir(); spool = root / 'row-spool'; spool.mkdir()
+    matrix = np.column_stack((a, b))
+    np.savetxt(root / 'rows.txt', matrix, fmt='%.17g', comments='',
+               header=f'groops matrix version=20200123\nMatrix( {len(a)} x {matrix.shape[1]} )')
+    tree = ET.Element('groops'); program = ET.SubElement(ET.SubElement(tree, 'program'), 'OrbitPocQrSolve')
+    fields = {'inputfileRows': root / 'rows.txt', 'outputfileSolution': root / 'solution.txt',
+              'outputPrefix': root / 'qr', 'localColumns': locals, 'dynamicColumns': mask.count('1'),
+              'nuisanceOnly': int(nuisance_only), 'lambda': damping, 'ionosphereColumn': int(group),
+              'jointEpochLocals': 1, 'conditionalNuisanceFixtureV41': int(compact),
+              'conditionalDynamicMaskV41': mask}
+    if covariance: fields['outputfileCovariance'] = root / 'covariance.txt'
+    for name, value in fields.items(): ET.SubElement(program, name).text = str(value)
+    ET.ElementTree(tree).write(root / 'run.xml', encoding='utf-8', xml_declaration=True)
+    env = {**os.environ, 'OPENBLAS_NUM_THREADS': '1', 'OMP_NUM_THREADS': '1',
+           'ORBIT_POC_NUISANCE_CONDITIONAL_QR': '0', 'ORBIT_POC_NUMERICS_MODE': 'step',
+           'ORBIT_POC_NUMERICS_QR_BLOCK_ROWS': str(block),
+           'ORBIT_POC_NUMERICS_SPOOL_DIRECTORY': str(spool)}
+    def limit():
+        signal.signal(signal.SIGXFSZ, signal.SIG_IGN)
+        resource.setrlimit(resource.RLIMIT_FSIZE, (file_limit, file_limit))
+    result = subprocess.run([binary, str(root / 'run.xml')], capture_output=True, text=True,
+                            env=env, timeout=120, preexec_fn=limit if file_limit else None)
+    (root / 'native.log').write_text(result.stdout + result.stderr)
+    return result
+
+
+@pytest.mark.parametrize('block', [1, 17, 1000])
+@pytest.mark.parametrize('group', [False, True])
+def test_native_identical_original_rows_local_group_priors_and_noncontiguous_map(candidate03_native, tmp_path, block, group):
+    rng = np.random.default_rng(9123)
+    a = rng.normal(size=(56, 6 + int(group))); b = rng.normal(size=56)
+    # Fixed physical-prior rows are nonzero and contribute cost with d=0.
+    a[-8:] = 0; offset = int(group)
+    a[-8:-4, offset + 2] = [1., 3., -2., .5]
+    a[-8:-4, offset + 4] = [2., -.3, 4., -1.]
+    b[-8:] = [4., -7., 2., 1., 8., -9., 6., 3.]
+    answers = []
+    for compact in (False, True):
+        root = tmp_path / str(compact)
+        result = run_fixture(candidate03_native, root, a, b, compact=compact, group=group, block=block)
+        assert result.returncode == 0, result.stdout + result.stderr
+        answers.append(np.loadtxt(root / 'solution.txt', skiprows=2).reshape(-1))
+        profile = json.loads((root / 'qr.1.profile.json').read_text())
+        residual = b - a @ answers[-1]
+        assert profile['direct_cost'] == pytest.approx(.5 * b @ b, rel=1e-12)
+        assert profile['linearized_profile_cost'] == pytest.approx(.5 * residual @ residual, rel=1e-10)
+        assert profile['nuisance_predicted_reduction'] == pytest.approx(.5 * (b @ b - residual @ residual), rel=1e-10)
+        if compact:
+            metadata = json.loads((root / 'qr.1.conditional_factor.json').read_text())
+            assert metadata['retained_global_indices'] == [3, 5]
+            assert metadata['full_parameter_count'] == 6
+            assert metadata['full_rank_certificate'] is False
+            assert not list(root.glob('qr.*.factor.json'))
+    nuisance = [i for i in range(a.shape[1]) if i not in (offset + 2, offset + 4)]
+    q, r = np.linalg.qr(a[:, nuisance], mode='reduced')
+    reference = np.linalg.solve(r, q.T @ b)
+    inverse = np.linalg.solve(r, np.eye(len(nuisance)))
+    sigma = np.sqrt(np.diag(inverse @ inverse.T))
+    for answer in answers:
+        assert np.array_equal(answer[[offset + 2, offset + 4]], np.zeros(2))
+        np.testing.assert_allclose((answer[nuisance] - reference) / sigma, 0., atol=1e-7)
+
+
+def test_native_empty_retained_nuisance_set(candidate03_native, tmp_path):
+    rng = np.random.default_rng(999); a = rng.normal(size=(40, 6)); b = rng.normal(size=40)
+    result = run_fixture(candidate03_native, tmp_path / 'run', a, b, mask='1111')
+    assert result.returncode == 0, result.stdout + result.stderr
+    answer = np.loadtxt(tmp_path / 'run/solution.txt', skiprows=2).reshape(-1)
+    q, r = np.linalg.qr(a[:, :2], mode='reduced')
+    np.testing.assert_allclose(answer[:2], np.linalg.solve(r, q.T @ b), atol=1e-12)
+    assert np.array_equal(answer[2:], np.zeros(4))
+
+
+def test_native_original_row_gtsam42_qr_oracle(candidate03_native, tmp_path):
+    import importlib.metadata
+    import gtsam
+    assert importlib.metadata.version('gtsam') == '4.2'
+    rng = np.random.default_rng(381); a = rng.normal(size=(48, 6)); b = rng.normal(size=48)
+    a[-5:] = 0; a[-5:-2, 2] = [1., 2., -3.]; a[-5:-2, 4] = [.5, -1., 4.]
+    b[-5:] = [3., -7., 2., 8., -9.]
+    nuisance = [0, 1, 3, 5]; scale = 1 / np.linalg.norm(a[:, nuisance], axis=0)
+    factor = gtsam.JacobianFactor(0, a[:, nuisance] * scale, b, gtsam.noiseModel.Unit.Create(len(b)))
+    order = gtsam.Ordering(); order.push_back(0)
+    conditional, _ = factor.eliminate(order)  # JacobianFactor QR, not normal equations.
+    values = conditional.solve(gtsam.VectorValues())
+    reference = values.at(0) * scale
+    root = conditional.R() / conditional.get_model().sigmas()[:, None]
+    inverse = np.linalg.solve(root, np.eye(len(nuisance)))
+    sigma = np.sqrt(np.diag(inverse @ inverse.T)) * scale
+    for compact in (False, True):
+        output = tmp_path / str(compact)
+        result = run_fixture(candidate03_native, output, a, b, compact=compact)
+        assert result.returncode == 0, result.stdout + result.stderr
+        answer = np.loadtxt(output / 'solution.txt', skiprows=2).reshape(-1)
+        np.testing.assert_allclose((answer[nuisance] - reference) / sigma, 0., atol=1e-7)
+        profile = json.loads((output / 'qr.1.profile.json').read_text())
+        assert profile['linearized_profile_cost'] == pytest.approx(factor.error(values), rel=1e-10)
+
+
+@pytest.mark.parametrize('guard', ['physical', 'damping', 'covariance'])
+def test_native_conditional_factor_refuses_full_authority(candidate03_native, tmp_path, guard):
+    rng = np.random.default_rng(32); a = rng.normal(size=(40, 6)); b = rng.normal(size=40)
+    result = run_fixture(candidate03_native, tmp_path / 'run', a, b,
+                         nuisance_only=guard != 'physical', damping=1. if guard == 'damping' else 0.,
+                         covariance=guard == 'covariance')
