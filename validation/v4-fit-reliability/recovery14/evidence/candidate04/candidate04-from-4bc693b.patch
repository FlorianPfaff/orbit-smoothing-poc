+def forbid_reference_metadata(value):
+    if isinstance(value,dict):
+        role=value.get('role')
+        require(not isinstance(role,str) or not any(x in role.lower() for x in ('truth','gnv1b','reference_orbit','slr_validation')),
+                'Evaluation/reference artifact cannot enter estimation metadata')
+        require(value.get('reference_inputs_used') is not True,'Reference-derived preparation')
+        for key,child in value.items():
+            require(key not in {'truth_inputs','evaluation_inputs','calibration_inputs','comparison_orbit','truth','reference_orbit','slr_validation'} or not child,
+                    'Evaluation data present in fit metadata')
+            forbid_reference_metadata(child)
+    elif isinstance(value,list):
+        for child in value:forbid_reference_metadata(child)
+
+
+def verify_staged_xml(plan):
+    """Reconstruct actual XML dependencies and exact wildcard-visible membership."""
+    rows={r['original_path']:r for r in plan['files']};generated=set(plan.get('generated_paths',[]))
+    references=plan.get('xml_input_references',[])
+    require(isinstance(references,list),'Missing staged XML reference inventory')
+    for row in plan['files']:
+        if row['kind']!='xml':continue
+        raw=Path(row['staged_path']).read_bytes()
+        require(len(raw)<=32*1024**2 and b'<!DOCTYPE' not in raw.upper() and b'<!ENTITY' not in raw.upper(),
+                'Unsafe staged XML')
+        nodes=ET.fromstring(raw);actual=[]
+        for node in nodes.iter():
+            value=(node.text or '').strip()
+            if not value:continue
+            if node.tag.startswith('inputfile') or node.tag=='filename' and node.attrib.get('label')=='orbitPocCanonicalAttitude':
+                require(value.startswith('/') and '..' not in Path(value).parts,'Unsupported staged XML input path')
+                actual.append((node.tag,value))
+        expected=[]
+        for ref in references:
+            if ref['xml']!=row['original_path']:continue
+            expression=row.get('xml_replacements',{}).get(ref['expression'],ref['expression'])
+            expected.append((ref['tag'],expression));captured=set();pending=set()
+            require(isinstance(ref['inputs'],list) and ref['inputs'],'Empty XML dependency expansion')
+            for original in ref['inputs']:
+                require(not re.search(r'(^|[/_.-])(truth|gnv1b|reference_orbit)([/_.-]|$)',original,re.I),
+                        'Evaluation reference in native XML')
+                if original in rows:captured.add(rows[original]['staged_path'])
+                else:
+                    require(original in generated,'Uncaptured XML dependency')
+                    # Only declared physical recomputation outputs may be absent before fitting.
+                    prefix=Path(plan['destination'])/'mirror';pending.add(str(prefix/original.lstrip('/')))
+            pattern=re.sub(r'\{[^{}]+\}','*',expression)
+            found={str(Path(p)) for p in glob.glob(pattern)}
+            require(captured<=found and found<=captured|pending,'XML dependency or wildcard membership differs')
+        require(Counter(actual)==Counter(expected),'Actual XML inputs differ from the frozen closure ledger')
+    require(all(r['xml'] in rows and rows[r['xml']]['kind']=='xml' for r in references),'Unknown XML reference owner')
+
+
+def blind_closure(job, plan):
+    forbid_reference_metadata(job['estimation_inputs'])
+    rows={r['staged_path']:r for r in plan['files']};inputs=job['estimation_inputs']
+    require(isinstance(inputs,list) and inputs,'Empty estimation inputs')
+    require(all(isinstance(i,dict) and {'path','sha256','role'}<=set(i) for i in inputs), 'Malformed estimation input')
+    require(len({i['path'] for i in inputs})==len(inputs),'Duplicate estimation input')
+    require({'gnss_observations','gnss_orbits','gnss_clocks','bootstrap_orbit'}<={r.get('role') for r in inputs},'Missing blind GNSS inputs')
+    for item in inputs:
+        require(item.get('role') in ROLES,'Forbidden estimation role')
+        require(not Path(item['path']).name.lower().startswith(('truth','gnv','reference_orbit')),'Truth input prohibited')
+        row=rows.get(item['path']);require(row is not None and row['staged_sha256']==item['sha256'],'Input not in staged mirror')
+        verify({'path':item['path'],'sha256':item['sha256']})
+        if item['role']=='bootstrap_orbit':
+            require(item.get('provenance',item.get('metadata',{}).get('provenance'))=='gnss_only','Bootstrap is not GNSS-only')
+    preps=[i for i in inputs if i['role']=='force_auxiliary' and i.get('metadata',{}).get('kind')=='native_preparation']
+    require(len(preps)==1,'Exactly one blind native preparation required')
+    prep=read(preps[0]['path']);forbid_reference_metadata(prep)
+    require(not any(k in prep for k in ('evaluation_inputs','calibration_inputs','truth','reference_orbit','slr_validation')),
+            'Evaluation paths leaked into the native fitting manifest')
+    require(prep.get('estimation_only') is not False, 'Preparation is not blind estimation input')
+    require(prep['metadata'].get('bootstrap_provenance')=='gnss_only' and prep['metadata'].get('reference_inputs_used') is False,'Preparation reference leakage')
+    for key in ('force_model_hash','measurement_model_hash','preprocessing_hash','mask_hash'):
+        require(prep[key]==job[key],'Prepared model identity changed')
+    for record in prep['native_artifacts']:
+        require(record['path'] in rows and rows[record['path']]['staged_sha256']==record['sha256'],'Unstaged native artifact')
+        verify({'path':record['path'],'sha256':record['sha256']})
+    root=Path(prep['native_data_inventory']['root']);expected=set()
+    require(root.is_absolute() and root.is_dir() and not root.is_symlink(), 'Unsafe native data root')
+    for entry in prep['native_data_inventory']['entries']:
+        require(isinstance(entry['relative'],str) and not Path(entry['relative']).is_absolute()
+            and '..' not in Path(entry['relative']).parts, 'Escaping native data entry')
+        name=str(root/entry['relative']);require(entry.get('resolved')==name and entry.get('link_target') is None,'Unsafe native data entry')
+        require(Path(name).is_relative_to(root),'Escaping native data entry')
+        require(entry['kind'] in ('file','directory'),'Unknown native data entry')
+        if entry['kind']=='file':
+            expected.add(name);verify({'path':name,'sha256':entry['sha256']})
+    actual={str(p) for p in root.rglob('*') if p.is_file()}
+    require(actual==expected and not any(p.is_symlink() for p in root.rglob('*')),'Native wildcard membership changed')
+    return prep
+
