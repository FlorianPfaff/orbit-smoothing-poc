+
+
+def full_factor():
+    return ({'schema': 'orbit-poc-qr-factor-v1', 'rows': 4, 'columns': 4,
+             'local_global_indices': [0, 1], 'retained_global_indices': [2, 3, 4, 5]},
+            {'schema': 'orbit-poc-native-qr-v1', 'rank_status': 'full', 'rank': 4,
