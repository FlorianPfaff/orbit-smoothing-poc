+def closure(profile, rows, templates):
+    """Close inputs, including XML data dependencies; expand only pinned PRNs."""
+    seen, refs = set(), []
+    first = xml_tree(Path(rows[profile]['original_copy']).read_bytes())
+    lists = [n.text.strip() for n in first.iter() if n.tag == 'inputfileTransmitterList']
+    if len(lists) != 1 or lists[0] not in rows:
+        raise ValueError('Expected one pinned transmitter list')
+    prns = Path(rows[lists[0]]['original_copy']).read_text().split()
+    if not prns or len(set(prns)) != len(prns) or any(re.fullmatch('G[0-9]{2}', x) is None for x in prns):
+        raise ValueError('Unsupported transmitter list')
+    def visit(name):
+        if name in seen:
+            return
+        if name not in rows:
+            raise ValueError('Uncaptured execution dependency: ' + name)
+        seen.add(name)
+        if not name.endswith('.xml'):
+            return
+        for node in xml_tree(Path(rows[name]['original_copy']).read_bytes()).iter():
+            if not input_node(node) or not (node.text or '').strip():
+                continue
+            value = node.text.strip()
+            if '{prn}' in value:
+                if value.replace('{prn}', '').find('{') != -1:
+                    raise ValueError('Unsupported nested input expression')
+                members = [value.replace('{prn}', p) for p in prns]
+                if set(templates.get(value, [])) != set(members):
+                    raise ValueError('PRN expansion differs from pinned transmitter list')
+            else:
+                stage.absolute(value)
+                if any(c in value for c in '{}*?'):
+                    raise ValueError('Unsupported execution input expression: ' + value)
+                members = [value]
+            refs.append({'xml': name, 'tag': node.tag, 'expression': value, 'members': members})
+            for member in members:
+                visit(member)
+    visit(profile)
+    return sorted(seen), refs
