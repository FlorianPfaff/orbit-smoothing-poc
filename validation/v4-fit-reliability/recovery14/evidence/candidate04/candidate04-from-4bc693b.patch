+            raise ValueError("Symlink path is not an input authority: " + str(item))
+    if file and not stat.S_ISREG(path.lstat().st_mode):
+        raise ValueError("Input is not a regular file: " + str(path))
+
+
+def _identity(path):
+    s = Path(path).stat()
+    return (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns, s.st_ctime_ns)
+
+
+def _check_source(item):
+    no_symlinks(item["source_path"], file=True)
