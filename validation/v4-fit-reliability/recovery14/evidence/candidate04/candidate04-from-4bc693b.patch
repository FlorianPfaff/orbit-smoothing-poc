+def audit_staging(root, inventory):
+    """Replay the staging transformations and verify actual staged bytes independently."""
+    root = Path(root).absolute()
+    receipt_pin = inventory.add(root / 'manifest.json', data=True)
+    receipt = read(root / 'manifest.json')
+    if (receipt.get('schema') != 'orbit-poc-v41-input-staging-result-v1' or receipt.get('status') != 'prepared_inputs_only'
+        or receipt.get('launch_ready') is not False or receipt.get('native_execution') is not False
+        or receipt.get('original_sources_unchanged') is not True):
+        raise ValueError('Staging is not a complete input-only receipt')
+    plan_pin = inventory.add(root / 'plan.json', receipt['plan_sha256'], data=True)
+    plan = read(root / 'plan.json')
+    inv_pin = inventory.add(plan['inventory']['path'], plan['inventory']['sha256'], data=True)
+    inv = read(inv_pin['path'])
+    if inv.get('schema') != stage.SCHEMA or inv.get('destination') != str(root):
+        raise ValueError('Staging inventory identity mismatch')
+    inv.setdefault('xml_templates', {}); inv.setdefault('generated_paths', [])
+    expected_plan, transformed = stage.prepare(inv, inv_pin)
+    if expected_plan != plan or plan['status'] != 'ready_to_stage' or plan['missing_execution_inputs']:
+        raise ValueError('Staged plan does not reconstruct from the pinned original inputs')
+    if receipt['completed_files'] != [x['original_path'] for x in plan['files']]:
+        raise ValueError('Staging receipt is missing or reorders copied files')
+    rows = {}
+    for item in plan['files']:
+        old = item['original_path']
+        if old in rows:
+            raise ValueError('Duplicate staged original')
+        rows[old] = item
+        for path, digest in ((item['source_path'], item['sha256']), (item['original_copy'], item['sha256']),
+                             (item['staged_path'], item['staged_sha256'])):
+            actual = inventory.add(path, digest, data=True)
+            size = item['staged_bytes'] if path == item['staged_path'] else item['bytes']
+            if actual['bytes'] != size:
