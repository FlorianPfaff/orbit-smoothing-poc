+def prepare(spec_path):
+    spec=load_spec(spec_path);output=safe_new(spec['output_dir'])
+    plan, originals=staged_requests(spec);build=build_identity(spec['build_result'])
+    sources=inventory_source(spec['source_root']);packages=discover_python_packages(verify(spec['python']))
+    runtime=output/'runtime-source';harness=pin(Path(__file__))
+    output.mkdir()
+    try:
+        runtime.mkdir()
+        for name,expected in sources['files'].items():
+            source=Path(spec['source_root'])/name;destination=runtime/name;destination.parent.mkdir(parents=True,exist_ok=True)
+            require(pin(source)['sha256']==expected,'Source changed before snapshot')
+            with source.open('rb') as inp,destination.open('xb') as out:shutil.copyfileobj(inp,out)
+            require(pin(destination)['sha256']==expected,'Runtime source copy differs')
+            destination.chmod(0o444)
+        require(inventory_source(runtime)==sources,'Snapshot membership or identity changed')
+        worker=worker_text(runtime)
+        environment={**{k:'1' for k in THREAD_KEYS},**FIXED_NATIVE,**build['runtime_environment'],
+                     'PYTHONDONTWRITEBYTECODE':'1','PYTHONNOUSERSITE':'1'}
+        declaration={'schema':'orbit-poc-v41-wholefit-declaration-v1','experiment_id':spec['experiment_id'],
+            'original_requests':[j['original'] for j in originals],'staged_requests':[j['staged'] for j in originals],
+            'source_sha256':sources['sha256'],'native':build['native'],'environment':environment,'limits':LIMITS,
+            'order':list(CASES),'input_isolation':ISOLATION,
+            'scratch_storage':{'filesystem':disk_filesystem(output),'minimum_free_bytes':LIMITS['min_free_disk_bytes'],
+                'row_spool_policy':'unlinked_mkstemp','allowed_native_override':'owned fit subtree on same disk filesystem',
+                'accounting_scope':'completed factor row_spool_bytes plus sealed design stores; no inferred live unlinked-file peak'},
+            'scope':'Two outcome-selected regressions; separate from frozen68, no release authority.'}
+        protocol=canonical(declaration);jobs=[]
+        for original in originals:
+            case=original['case_id'];name=case;directory=output/name;directory.mkdir();(directory/'scratch').mkdir(mode=0o700);(directory/'row-spool').mkdir(mode=0o700)
+            job=rebind(original['staged_value'],spec['experiment_id'],sources['sha256'],build['native'],protocol)
+            request=directory/'request.json';save(request,job)
+            jobs.append({'name':name,'case_id':case,'request':pin(request),'original_request':original['original'],
+                         'original_path':original['original_path'],'staged_request':original['staged'],
+                         'changed_fields':[k for k in sorted(JOB_FIELDS) if job[k]!=original['staged_value'][k]]})
+        checker=ROOT/'scripts/analyze_nuisance_wholefit.py'
+        freeze={'schema':FREEZE_SCHEMA,'experiment_id':spec['experiment_id'],'root':str(output),'spec':pin(spec_path),
+            'source_root':str(runtime),'source_inventory':sources,'python':spec['python'],'python_packages':packages,
+            'harness':harness,'build_result':spec['build_result'],'native':build['native'],'libraries':build['libraries'],
+            'staging_manifest':spec['staging_manifest'],'staging_plan':spec['staging_plan'],'staging_audit':spec['staging_audit'],
+            'declaration':declaration,'protocol_hash':protocol,'worker_sha256':hashlib.sha256(worker.encode()).hexdigest(),
+            'environment':environment,'limits':LIMITS,'jobs':jobs,'order':list(CASES),
+            'checker_dependencies':[pin(ROOT/'scripts'/name) for name in CHECKER_NAMES],
+            'created_at':datetime.now(timezone.utc).isoformat(),'release_authority':False,
+            'python_dependency_scope':'Interpreter plus complete numpy/scipy/psutil packages and their bundled libraries; standard-library/OS closure beyond pinned native dependencies is not certified.'}
+        save(output/'freeze.json',freeze)
+        validate_freeze(output/'freeze.json', prepared=False)
+        save(output/'prepared.json',{'status':'prepared_not_executed','freeze':pin(output/'freeze.json'),'attempts':2,
+                                    'release_authority':False,'benchmark68_complete':False})
+        return output/'freeze.json'
+    except BaseException as exc:
+        save(output/'preparation-failure.json',{'status':'failed','error':repr(exc),'partial_outputs_retained':True})
+        raise
