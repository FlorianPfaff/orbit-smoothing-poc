+def row_spool_evidence(evidence, freeze, planned):
+    root=Path(freeze['root'])/planned['name'];rows=[];issues=[]
+    expected=freeze['declaration']['scratch_storage']['filesystem']
+    for path in sorted(root.rglob('qr.*.factor.json')):
+        try:
+            value=evidence.json(path);directory=Path(value.get('spool_directory',''))
+            require(directory.is_absolute() and directory.is_relative_to(root) and directory.name=='row-spool'
+                and value.get('spool_policy')=='unlinked_mkstemp' and disk_filesystem(directory)==expected,
+                'Native QR spool is outside its owned disk-backed subtree')
+            size=value.get('row_spool_bytes')
+            diagnostic=evidence.json(path.with_name(path.name.removesuffix('.factor.json')+'.diagnostics.json'))
+            reduced=diagnostic.get('reduced_rows');columns=value.get('columns')
+            require(type(size) is int and size>=0 and type(reduced) is int and reduced>=0
+                and type(columns) is int and columns>0 and size==reduced*(columns+1)*8,
+                'Missing/invalid completed row spool accounting')
+            rows.append({'factor':str(path),'spool_directory':str(directory),'row_spool_bytes':size})
+        except (OSError,ValueError,KeyError,TypeError) as exc:issues.append({'path':str(path),'error':repr(exc)})
+    directories=[p for p in root.rglob('row-spool')]
+    for directory in directories:
+        if directory.is_symlink() or not directory.is_dir() or any(directory.iterdir()):
+            issues.append({'path':str(directory),'error':'Unclean or unsafe owned row spool'})
+    return {'completed_factor_spools':rows,'sum_completed_row_spool_bytes':sum(x['row_spool_bytes'] for x in rows),
+            'maximum_completed_row_spool_bytes':max((x['row_spool_bytes'] for x in rows),default=None),
+            'issues':issues,'scope':'Completed native factor accounting only; interrupted unlinked spool peak is unavailable.',
+            'disk_reserve_bytes':LIMITS['min_free_disk_bytes'],'disk_filesystem':expected}
+
+
+def inspect_terminal(freeze,planned,freeze_path,checker):
+    root=Path(freeze['root'])/planned['name'];result={'name':planned['name'],'status':'missing',
+        'whole_fit_complete':False,'accepted_covariance':False,'issues':[],'native_logs':[]}
+    if not (root/'execution.json').exists():
+        if (root/'admission.json').exists():result['status']='started_without_terminal_receipt'
+        return result
+    evidence=checker.Evidence()
+    try:
+        receipt,sup,worker_result=terminal_binding(evidence,freeze,planned,freeze_path)
+        result.update(status=receipt['status'],supervisor_status=sup['status'],wall_seconds=sup['elapsed_seconds'],
+                      peak_process_tree_rss_bytes=sup['peak_process_tree_rss_bytes'])
+        # Actual native failure logs are retained; row spools are streamed, never loaded into RAM.
+        for log in sorted(root.rglob('*.log')):
+            item=evidence.fingerprint(log)
+            with log.open('rb') as stream:
+                stream.seek(max(0,log.stat().st_size-8192));item['tail']=stream.read().decode(errors='replace')
+            result['native_logs'].append(item)
+        result['row_storage']=row_spool_evidence(evidence,freeze,planned)
+        if sup['status']!='complete' or sup['returncode']!=0 or worker_result is None:return result
+        result['status']=worker_result.get('status','failed');result['numerical_status']=worker_result.get('numerical_status')
+        complete=worker_result.get('status')=='complete'
+        released=checker.factor_release_inventory(evidence,root);points={}
+        for directory in sorted(root.iterdir()):
+            if directory.is_dir() and checker.POINT.fullmatch(directory.name):
+                try:points[directory.name]=checker.inspect_point(evidence,root,directory,1,released,allow_partial=not complete)
+                except (OSError,ValueError,KeyError,TypeError) as exc:
+                    if complete:raise
+                    points[directory.name]={'classification':'incomplete_or_unverified','issues':[repr(exc)]}
+        result['points']={k:{field:v.get(field) for field in ('classification','profile_complete','fresh_undamped_full_rank',
+            'issues','incomplete_records','profile_elapsed_seconds')} for k,v in points.items()}
+        if not complete:
+            require(worker_result.get('converged') is False and worker_result.get('covariance_valid') is False,
+                    'Failed fit claims convergence/covariance')
+            result['error']=worker_result.get('error');return result
+        job=read(planned['request']['path'])
+        pinned={str(Path(freeze['source_root'])/name):digest for name,digest in freeze['source_inventory']['files'].items()}
+        checker.validate_success(evidence,worker_result,job,root,points,
+                                 {'source_root':freeze['source_root'],'python':freeze['python']},pinned)
+        require(not result['row_storage']['issues'] and result['row_storage']['completed_factor_spools'],
+                'Successful fit lacks verified disk-backed QR row-spool evidence')
+        result['measured_treatment']=measured_native_treatment(evidence,root,points)
+        result.update(whole_fit_complete=True,accepted_covariance=True)
+        return result
+    finally:
+        evidence.unchanged();result['evidence']=evidence.inventory()
+
