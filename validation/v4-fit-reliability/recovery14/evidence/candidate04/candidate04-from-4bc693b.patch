+    if not isinstance(templates, dict) or len(templates) > MAX_FILES:
+        raise ValueError("Invalid XML template inventory")
+    for pattern, names in templates.items():
+        absolute(pattern)
+        if not any(within(pattern, p) for p in prefixes) or not isinstance(names, list) or not 1 <= len(names) <= 1024:
+            raise ValueError("Invalid XML template expansion")
