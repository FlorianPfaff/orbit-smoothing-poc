+def validate_freeze(path, *, prepared=True):
+    freeze=read(path);root=Path(path).absolute().parent
+    require(set(freeze)=={'schema','experiment_id','root','spec','source_root','source_inventory','python',
+        'python_packages','harness','build_result','native','libraries','staging_manifest','staging_plan','staging_audit',
+        'declaration','protocol_hash','worker_sha256','environment','limits','jobs','order','checker_dependencies',
+        'created_at','release_authority','python_dependency_scope'}, 'Unknown or missing frozen controls')
+    require(root.resolve()==root and not root.is_symlink(), 'Unsafe whole-fit output root')
+    require(freeze.get('schema')==FREEZE_SCHEMA and freeze.get('root')==str(root) and freeze.get('limits')==LIMITS,
+            'Wrong whole-fit freeze schema, location or resources')
+    if prepared:
+        seal=read(root/'prepared.json')
+        require(set(seal)=={'status','freeze','attempts','release_authority','benchmark68_complete'}
+            and seal['status']=='prepared_not_executed' and seal['freeze']==pin(path) and seal['attempts']==2
+            and seal['release_authority'] is False and seal['benchmark68_complete'] is False, 'Prepared freeze identity changed')
+    require(freeze.get('release_authority') is False and freeze.get('order')==list(CASES),'Scope/order changed')
+    require(verify(freeze['harness']).resolve()==Path(__file__).resolve(),'Executing harness differs from frozen source')
+    spec=load_spec(verify(freeze['spec']))
+    require(spec['experiment_id']==freeze['experiment_id'] and spec['output_dir']==str(root),'Spec identity differs')
+    for name in ('staging_manifest','staging_plan','staging_audit','build_result','python'):
+        require(freeze[name]==spec[name],'Frozen spec pin changed: '+name)
+    plan, originals=staged_requests(spec);build=build_identity(freeze['build_result'])
+    require(freeze['native']==build['native'] and freeze['libraries']==build['libraries'],'Candidate runtime changed')
+    require(Path(freeze['source_root'])==root/'runtime-source' and not Path(freeze['source_root']).is_symlink(),
+        'Runtime source must be the isolated snapshot')
+    require(inventory_source(freeze['source_root'])==freeze['source_inventory'],'Runtime source changed after freeze')
+    require({str(p.relative_to(freeze['source_root'])) for p in Path(freeze['source_root']).rglob('*') if p.is_file()}
+        ==set(freeze['source_inventory']['files']), 'Unexpected file in isolated Python runtime')
+    require(hashlib.sha256(worker_text(freeze['source_root']).encode()).hexdigest()==freeze['worker_sha256'],'Protocol worker changed')
+    require({'numpy','scipy','psutil'}<=set(freeze['python_packages']),'Missing third-party Python runtime pins')
+    require(set(freeze['python_packages'])<={'numpy','scipy','psutil','numpy.libs','scipy.libs','psutil.libs',
+        'numpy.lib','scipy.lib','psutil.lib'},'Unknown Python dependency inventory')
+    for package in freeze['python_packages'].values():
+        require(package_files(package['root'])==package['files'],'Python package membership/bytes changed')
+    expected_checkers=[ROOT/'scripts'/name for name in CHECKER_NAMES]
+    require([x['path'] for x in freeze['checker_dependencies']]==list(map(str,expected_checkers)),
+        'Unknown or incomplete scientific checker closure')
+    for p in freeze['checker_dependencies']:verify(p)
+    wanted={**{k:'1' for k in THREAD_KEYS},**FIXED_NATIVE,**build['runtime_environment'],
+            'PYTHONDONTWRITEBYTECODE':'1','PYTHONNOUSERSITE':'1'}
+    require(freeze['environment']==wanted,'Unknown/changed runtime controls, warm start or thread setting')
+    declaration=freeze['declaration']
+    require(canonical(declaration)==freeze['protocol_hash'] and declaration['limits']==LIMITS
+        and declaration['environment']==wanted and declaration['native']==build['native']
+        and declaration['source_sha256']==freeze['source_inventory']['sha256']
+        and declaration['order']==list(CASES) and declaration['experiment_id']==freeze['experiment_id']
+        and declaration.get('input_isolation')==ISOLATION
+        and declaration.get('scratch_storage')=={'filesystem':disk_filesystem(root),
+            'minimum_free_bytes':LIMITS['min_free_disk_bytes'],'row_spool_policy':'unlinked_mkstemp',
+            'allowed_native_override':'owned fit subtree on same disk filesystem',
+            'accounting_scope':'completed factor row_spool_bytes plus sealed design stores; no inferred live unlinked-file peak'},
+        'Experimental protocol attribution changed')
+    require(len(freeze['jobs'])==2 and [j['case_id'] for j in freeze['jobs']]==list(CASES),'Missing/extra planned attempts')
+    require(declaration['original_requests']==[j['original'] for j in originals]
+        and declaration['staged_requests']==[j['staged'] for j in originals],'Original request attribution changed')
+    for planned, original in zip(freeze['jobs'],originals):
+        require(planned['name']==planned['case_id'] and planned['original_request']==original['original']
+            and planned['staged_request']==original['staged'] and planned['original_path']==original['original_path'],
+            'Planned attempt is not its original input')
+        require(Path(planned['request']['path'])==root/planned['name']/'request.json'
+            and not (root/planned['name']).is_symlink() and not Path(planned['request']['path']).is_symlink(),
+            'Request leaves isolated attempt')
+        validate_owned_storage(freeze,planned)
+        job=read(verify(planned['request']))
+        expected=rebind(original['staged_value'],freeze['experiment_id'],freeze['source_inventory']['sha256'],
+                        freeze['native'],freeze['protocol_hash'])
+        require(job==expected,'Rebound request changed scientific settings or runtime attribution')
+        require(planned['changed_fields']==[k for k in sorted(JOB_FIELDS) if job[k]!=original['staged_value'][k]],
+                'Request rebind ledger changed')
+    return freeze
