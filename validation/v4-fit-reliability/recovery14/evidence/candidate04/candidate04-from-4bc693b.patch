+def worker(freeze_path,expected_hash,name):
+    verify({'path':str(freeze_path),'sha256':expected_hash});freeze=validate_freeze(freeze_path)
+    require(pin(sys.executable)['sha256']==freeze['python']['sha256'],'Worker interpreter changed')
+    # The tracked harness directory is not an unpinned Python import root for the fit.
+    sys.path[:]=[p for p in sys.path if Path(p or os.getcwd()).resolve()!=Path(__file__).resolve().parent]
+    for dependency_name in ('numpy','scipy','psutil'):
+        dependency=importlib.util.find_spec(dependency_name)
+        require(dependency and dependency.submodule_search_locations
+            and str(Path(next(iter(dependency.submodule_search_locations))).resolve())==freeze['python_packages'][dependency_name]['root'],
+            'Effective Python dependency location differs: '+dependency_name)
+    selected=[j for j in freeze['jobs'] if j['name']==name];require(len(selected)==1,'Unknown frozen worker job')
+    planned=selected[0];validate_owned_storage(freeze,planned);env=expected_environment(freeze,planned)
+    native_env={k:v for k,v in os.environ.items() if k.startswith('ORBIT_POC_')}
+    require(native_env=={k:v for k,v in env.items() if k.startswith('ORBIT_POC_')},'Worker inherited unknown/changed native controls')
+    require(all(os.environ.get(k)==v for k,v in env.items()),'Effective worker environment differs')
+    require('PYTHONPATH' not in os.environ and 'PYTHONHOME' not in os.environ,'Unexpected Python path injection')
+    os.sched_setaffinity(0,{0});require(os.sched_getaffinity(0)=={0},'CPU affinity differs')
+    root=Path(freeze['root'])/name
+    save(root/'effective-environment.json',{'schema':'orbit-poc-v41-wholefit-environment-v1','environment':env,
+        'cpu_affinity':[0],'pid':os.getpid(),'boot_id':Path('/proc/sys/kernel/random/boot_id').read_text().strip(),
+        'freeze_sha256':expected_hash,'request':planned['request'],'source_root':freeze['source_root']})
+    verify({'path':str(freeze_path),'sha256':expected_hash})
+    original_argv=sys.argv
+    sys.argv=['unchanged_protocol_worker',freeze['source_root'],planned['request']['path'],str(root/'worker-result.json'),'[0]']
+    try:exec(compile(worker_text(freeze['source_root']),'frozen-protocol-WORKER','exec'),{'__name__':'__main__'})
+    finally:sys.argv=original_argv
+    return 0
+
