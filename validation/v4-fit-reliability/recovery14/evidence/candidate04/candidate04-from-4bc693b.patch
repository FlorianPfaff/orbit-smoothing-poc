+        receipt = {"schema": "orbit-poc-v41-input-staging-result-v1", "status": "prepared_inputs_only",
+                   "launch_ready": False, "native_execution": False, "completed_files": completed,
+                   "original_sources_unchanged": True, "plan_sha256": digest(root / "plan.json"),
+                   "required_next_step": "Bind and verify candidate source, executable, dependencies, full execution closure and admission in a separate immutable launch manifest."}
+        _write_new(root / "manifest.json", encoded(receipt))
+        return receipt
+    except BaseException as error:
+        _write_new(root / "failure.json", encoded({"schema": "orbit-poc-v41-input-staging-failure-v1", "status": "failed",
+                                                   "launch_ready": False, "completed_files": completed,
+                                                   "error_type": type(error).__name__, "error": str(error),
+                                                   "partial_outputs_retained": True}))
+        raise
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("operation", choices=("plan", "stage"))
+    parser.add_argument("--inventory", type=Path, required=True)
+    args = parser.parse_args(argv)
+    inventory, pin = load_inventory(args.inventory)
+    plan, transformed = prepare(inventory, pin)
+    if args.operation == "stage":
+        print(json.dumps(stage(inventory, pin, plan, transformed), sort_keys=True))
+    else:
+        print(json.dumps(plan, indent=2, sort_keys=True))
+    return 0 if not plan["missing_execution_inputs"] else 2
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except (ValueError, OSError) as error:
+        print(str(error), file=sys.stderr)
+        raise SystemExit(1)
