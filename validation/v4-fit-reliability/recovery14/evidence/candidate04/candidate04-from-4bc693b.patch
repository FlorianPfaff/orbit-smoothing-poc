+
+
+def encoded(value):
+    return (json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n").encode()
+
+
+def digest(path):
+    h = hashlib.sha256()
+    with Path(path).open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def absolute(value):
+    if not isinstance(value, str) or not value.startswith("/") or any(c in value for c in "\x00\n\r"):
+        raise ValueError("Expected an absolute POSIX path")
+    path = PurePosixPath(value)
+    if value != str(path) or ".." in path.parts or str(path) == "/":
+        raise ValueError("Noncanonical or unsafe path: " + value)
+    return value
+
+
+def within(path, parent):
+    return path == parent or path.startswith(parent + "/")
