+def load_spec(path):
+    spec=read(path)
+    require(isinstance(spec,dict) and set(spec)==SPEC_FIELDS and spec['schema']==SCHEMA,'Unknown or missing whole-fit spec options')
+    require(isinstance(spec['experiment_id'],str) and re.fullmatch(r'v41-[a-z0-9-]{1,64}',spec['experiment_id']),
+            'A separate v41 experiment identity is required')
+    for name in ('staging_manifest','staging_plan','staging_audit','build_result','python'):verify(spec[name])
+    require(Path(spec['source_root']).is_absolute() and Path(spec['source_root']).is_dir(),'Missing runtime source root')
+    return spec
+
