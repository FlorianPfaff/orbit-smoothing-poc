+                {"kind": "file", "relative": "obs.dat", "resolved": observation["path"], "link_target": None, "bytes": observation["bytes"], "sha256": observation["sha256"]},
+                {"kind": "directory", "relative": "empty", "resolved": old + "/data/empty", "link_target": None}]},
+            "historical_source": {"path": old + "/historical/not-copied.json", "sha256": "e" * 64},
+            "case": {"truth_model": "tudat_independent"}}
+    prepared = add("native_preparation.json", "preparation", prep)
+    request = {"stage": "synthetic", "method": "groops_pulses", "parameters": {"sigma_velocity_m_s": 1e-4},
