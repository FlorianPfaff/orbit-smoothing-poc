+    def add(self, path, expected=None, *, data=False):
+        key = str(Path(path).absolute())
+        if key not in self.items:
+            self.items[key] = {**pin(key, data=data), **({'no_symlinks': True} if data else {})}
+        item = self.items[key]
+        if expected is not None and item['sha256'] != expected:
+            raise ValueError('Frozen input digest differs: ' + key)
+        return {k: item[k] for k in ('path', 'sha256', 'bytes')}
