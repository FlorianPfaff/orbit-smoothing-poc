+def matrix_finite(path, rows, columns):
+    """Validate native binary64 matrix with bounded memory, including the header."""
+    path = Path(path)
+    if type(rows) is not int or type(columns) is not int or rows <= 0 or columns <= 0 or path.stat().st_size != 16 + rows * columns * 8:
+        raise ValueError('Matrix dimensions or size mismatch')
+    with path.open('rb') as stream:
+        if struct.unpack('<QQ', stream.read(16)) != (rows, columns):
+            raise ValueError('Matrix header mismatch')
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            if any(not math.isfinite(x[0]) for x in struct.iter_unpack('<d', block)):
+                raise ValueError('Nonfinite matrix value')
+
