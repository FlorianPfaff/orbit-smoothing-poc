+def measured_native_treatment(evidence, root, points):
+    """Validate actual disk/fixed-dynamics measurements, not just requested flags."""
+    summaries=[]
+    for name,point in points.items():
+        if not point.get('profile_complete'):continue
+        directory=Path(root)/name;generation=point.get('final_generation')
+        require(type(generation) is int and generation>=2,'No final native generation for treatment audit')
+        expected={directory/f'qr.{g}.nuisance_fixed_dynamics.json' for g in range(1,generation)}
+        require(set(directory.glob('qr.*.nuisance_fixed_dynamics.json'))==expected,'Fixed-dynamics evidence is incomplete')
+        previous=(0,0)
+        for g in range(1,generation):
+            fixed=evidence.json(directory/f'qr.{g}.nuisance_fixed_dynamics.json')
+            counts=tuple(fixed.get(k) for k in ('omitted_recovery_designs','parent_skipped_zero_products'))
+            require(fixed.get('schema')=='orbit-poc-nuisance-fixed-dynamics-v1'
+                and fixed.get('scope')=='cumulative_parent_process_only_excludes_forked_trial_counters'
+                and all(type(v) is int and v>=old for v,old in zip(counts,previous)), 'Invalid fixed-dynamics counters')
+            previous=counts
+        require(previous[0]>0,'Fixed-dynamics design was never omitted')
+        records=[]
+        for line in evidence.data(directory/'qr.design_storage.jsonl',limit=32*1024**2).splitlines():
+            if line:records.append(strict_json(line))
+        require(records,'No measured disk storage evidence');stores=set()
+        for row in records:
+            require(row.get('schema')=='orbit-poc-design-storage-v41' and all(type(row.get(k)) is int and row[k]>0
+                for k in ('rows','columns','creator_pid','pid','device','inode')),'Invalid disk storage geometry')
+            require(row.get('stage') in ('sealed','parameter_update','native_covariance','observation_covariance')
+                and row.get('sealed') is True and row.get('finite_validated') is True
+                and row.get('block_rows')==192 and row.get('cache_block_bound')==2
+                and row.get('scratch_reserved_bytes')==row['rows']*row['columns']*8
+                and row.get('scratch_written_bytes')==row['scratch_reserved_bytes']
+                and row.get('checksum_kind')=='fnv1a64_integrity_not_provenance','Invalid disk storage capacity/treatment')
+            require(all(type(row.get(k)) is int and row[k]>=0 for k in ('read_bytes','block_loads','cache_hits',
+                'scratch_reserved_bytes','scratch_written_bytes')), 'Invalid disk storage counter')
+            require(all(type(row.get(k)) in (int,float) and math.isfinite(row[k]) and row[k]>=0
+                for k in ('write_wall_seconds','read_wall_seconds')), 'Invalid disk storage timing')
+            if row['stage']=='sealed':stores.add((row['creator_pid'],row['device'],row['inode']))
+        require(len(stores)==2 and all((r['creator_pid'],r['device'],r['inode']) in stores for r in records),
+                'Disk treatment lacks two sealed position/velocity stores')
+        require(any(r['stage']=='parameter_update' and r['read_bytes']>0 and r['block_loads']>0 for r in records),
+                'Disk treatment has no measured parameter-update reads')
+        for g in range(1,generation):
+            search=evidence.json(directory/f'qr.{g}.nuisance_line_search.json');zero=search.get('zero_update_replay',{})
+            require(type(zero.get('status')) is int and zero['status']==0
+                and all(type(zero.get(k)) in (int,float) and math.isfinite(zero[k]) and zero[k]==0
+                        for k in ('actual_reduction','maximum_update_m'))
+                and type(zero.get('cost')) in (int,float) and math.isfinite(zero['cost'])
+                and zero['cost']==search.get('objective_before') and zero.get('error')=='',
+                'Mandatory cold zero replay did not reproduce the exact accepted objective')
+        sidecars=[evidence.json(directory/f'qr.{g}.nuisance_performance.json') for g in range(1,generation)]
+        cost=load_module('_wholefit_v41_cost_metrics',ROOT/'scripts/check_nuisance_cost_only_pair.py')
+        metrics=cost.verify_metrics({'performance_sidecars':sidecars,'final_generation':generation},1)
+        summaries.append({'point':name,'fixed_dynamics_counters':previous,'storage_records':len(records),
+                          'cost_only_metrics':metrics})
+    require(summaries,'No complete native treatment evidence')
+    require(not any((Path(root)/'scratch').iterdir()),'Scratch files remain after cleanup')
+    return summaries
+
