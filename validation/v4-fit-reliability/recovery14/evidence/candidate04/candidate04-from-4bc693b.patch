+            raise ValueError('Existing execution or scratch artifacts: ' + str(directory))
+    save(root / 'run-started.json', {'freeze': pin(freeze_path), 'admission': admission(), 'started_at': now()})
+    sys.path.insert(0, str(R / 'src'))
