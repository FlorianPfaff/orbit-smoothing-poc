+    hours=72 if method=='groops_pulses' else 48
+    require(job['method']==method and job['segmented_profile']=='dense_corrected'
+            and job['numerics_profile']=='qr_lm_staged_jacobian','Original method/profile changed')
+    require(canonical(job['parameters'])==canonical(PARAMETERS[method]),'Unknown or modified physical parameters')
+    require(canonical(job['numerical_controls'])==canonical(CONTROLS),'Changed numerical controls/thresholds')
+    expected={'atmosphere':'quiet','cadence':30.,'coverage':'normal','duration_hours':hours,
+        'epoch':'2024-05-10T00:00:00','mask':{'cadence_seconds':30,'duration_seconds':hours*3600,
+        'intervals_seconds':[],'time_scale':'UTC'},'orbit':'leo500','seed':610000,
+        'truth_model':'tudat_independent_central_j2_exponential_gnss'}
+    require(canonical(job['case'])==canonical(expected),'Changed original case, mask or initialization regime')
+    require(job['mask_hash']==canonical(job['case']['mask']),'Changed mask identity')
+    require(job['input_manifest_hash']==canonical(job['estimation_inputs']),'Changed original input identity')
+    require(job['job_sha256']==canonical({k:v for k,v in job.items() if k!='job_sha256'}),'Changed original job identity')
+    backend=job['backend']
+    require(set(backend)=={'command_timeout_seconds','diagnostic_native','groops_executable','retain_native_diagnostics',
+                          'segmented_solver','segmented_solver_executable'},'Unknown original runtime control')
+    require(backend['command_timeout_seconds']==7200. and backend['retain_native_diagnostics'] is True
+        and backend['segmented_solver'] is None and backend['segmented_solver_executable'] is None,'Changed dense runtime semantics')
+
