+def remap_outputs(raw, old_root, new_root):
+    """Only output/tmp complete text nodes may change; input bytes stay identical."""
+    tree = xml_tree(raw)
+    replacements = {}
+    for node in tree.iter():
+        value = (node.text or '').strip()
+        if output_node(node) and value:
+            path = Path(value)
+            stage.absolute(value)
+            if not path.is_relative_to(old_root):
+                raise ValueError('Output escapes its staged point root')
+            replacements[value] = str(new_root / path.relative_to(old_root))
+    if not replacements:
+        raise ValueError('No output paths to remap')
+    result = raw
+    for before, after in sorted(replacements.items(), key=lambda x: -len(x[0])):
+        result = re.sub(rb'(>\s*)' + re.escape(before.encode()) + rb'(\s*<)', lambda m: m[1] + after.encode() + m[2], result)
+    original, changed = list(tree.iter()), list(xml_tree(result).iter())
+    if len(original) != len(changed):
+        raise ValueError('XML structure changed')
+    for a, b in zip(original, changed):
+        expected = replacements.get((a.text or '').strip()) if output_node(a) else None
+        if a.tag != b.tag or a.attrib != b.attrib or a.tail != b.tail or (a.text != b.text and (expected is None or b.text.strip() != expected)):
+            raise ValueError('Input/scientific XML changed during output remapping')
+    steps = list(xml_tree(result).iter('orbitPocNumerics'))
+    if len(steps) != 1 or float(steps[0].findtext('nuisanceConvergenceThreshold', '1e-8')) != 1e-8 or int(steps[0].findtext('maximumNuisanceIterations', '128')) != 128:
+        raise ValueError('Changed nuisance controls')
+    return result, replacements
