+    results, launched, failure = {}, set(), None
+    try:
+        for job in freeze['jobs']:
+            verify(freeze['inventory'])
+            directory = Path(job['profile']).parent
+            save(directory / 'admission.json', admission())
+            env = {**runtime['environment_fixed'], 'ORBIT_POC_GNSS_DESIGN_SCRATCH': str(directory / 'scratch'),
+                   'ORBIT_POC_NUMERICS_QR_PREFIX': str(directory / 'qr')}
+            argv = [runtime['taskset']['path'], '-c', '0', runtime['native']['path'], job['profile']]
+            save(directory / 'launch.json', {'environment': env, 'argv': argv, 'freeze': pin(freeze_path), 'started_at': now()})
+            launched.add(job['name'])
+            record = run_owned(argv, python_executable=runtime['python']['path'], cwd=directory, env=env,
+                               log_path=directory / 'profile.log', receipt_path=directory / 'supervisor.json',
+                               timeout_seconds=7200, max_process_tree_rss_bytes=8 * 1024**3,
+                               min_free_disk_bytes=16 * 1024**3, working_directory=directory)
+            record = {**record, 'input_identity_after': 'verified', 'environment': env,
+                      'freeze_sha256': pin(freeze_path)['sha256'], 'supervisor': pin(directory / 'supervisor.json')}
+            try:
+                verify(freeze['inventory'])
+            except Exception as exc:
+                record['input_identity_after'] = 'changed'; record['identity_error'] = str(exc)
+            save(directory / 'profile.execution.json', record)
+            outcome = inspect_result(directory, record)
+            save(directory / 'validation.json', outcome)
+            results[job['name']] = {'name': job['name'], 'status': record['status'], 'returncode': record['returncode'],
+                                   'validation': pin(directory / 'validation.json'), 'passed': outcome['passed'],
+                                   'classification': outcome['classification'], 'elapsed_seconds': record['elapsed_seconds'],
+                                   'peak_process_tree_rss_bytes': record['peak_process_tree_rss_bytes']}
+            print(json.dumps(results[job['name']]), flush=True)
+            if record['input_identity_after'] != 'verified' or record.get('owned_process_group_cleaned') is not True or record.get('cleanup', {}).get('empty_tree_certificate') != 'kernel_ECHILD':
+                raise RuntimeError('Identity or cleanup failed; subsequent launch prohibited')
+    except BaseException as exc:
