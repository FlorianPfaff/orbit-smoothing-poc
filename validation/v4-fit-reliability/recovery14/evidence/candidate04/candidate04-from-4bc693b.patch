+def admission():
+    if 0 not in os.sched_getaffinity(0):
+        raise RuntimeError('CPU0 is unavailable')
+    for path in Path('/proc').glob('[0-9]*'):
+        try:
+            name = (path / 'comm').read_text().strip()
+            if name.startswith('groops') or name in ('cc1plus', 'f951', 'ninja', 'segmented_qr'):
+                raise RuntimeError('Competing native workload: ' + str(path) + ' ' + name)
+        except (FileNotFoundError, ProcessLookupError):
+            pass
