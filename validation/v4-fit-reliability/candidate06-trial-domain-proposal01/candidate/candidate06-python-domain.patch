+def reference_domain_failure_evidence(log, execution, previous_states, *, derivative_profile, gm):
+    """Recognize only the archived synthetic fitted-reference domain failure.
+
+    This is not a generic native-error classifier. The caller must be closing a
+    freshly generated trajectory and retain its preceding successful closure.
+    Even this typed failure is fatal outside candidate evaluation in minimize.
+    """
+    if (derivative_profile != "synthetic_complete_v1" or not isinstance(execution, dict)
+            or type(execution.get("returncode")) is not int or execution["returncode"] != 1
+            or execution.get("timed_out") is not False or previous_states is None
+            or type(gm) not in (int, float) or not np.isfinite(gm) or gm <= 0):
+        return None
+    lines = [line.strip() for line in re.sub(r"\x1b\[[0-9;]*m", "", log).splitlines() if line.strip()]
+    if (lines[-2:] != ["Nonfinite equinoctial reference input", "=== Finished GROOPS with error ==="]
+            or lines.count("****** Error ******") != 1
+            or "--- PreprocessingVariationalEquation ---" not in lines
+            or not any("preprocessingVariationalEquation.cpp:" in line and "(computeArc)" in line
+                       for line in lines)):
+        return None
+    states = np.asarray(previous_states, dtype=float)
+    if states.ndim != 2 or states.shape[1] != 6 or len(states) < 2 or not np.isfinite(states).all():
+        return None
+    with np.errstate(over="ignore", divide="ignore", invalid="ignore"):
+        radius = np.linalg.norm(states[:, :3], axis=1)
+        speed = np.linalg.norm(states[:, 3:], axis=1)
+        energy = .5 * speed**2 - gm / radius
+    if (not np.isfinite([radius, speed, energy]).all() or np.any(radius <= 0)
+            or not np.any(energy >= 0)):
+        return None
+    return {"schema": "orbit-poc-physical-trial-domain-v1",
+            "domain": "synthetic_fitted_elliptic_reference",
+            "terminal_native_error": "Nonfinite equinoctial reference input",
+            "preceding_closure_finite": True, "samples": len(states), "gm_m3_s2": gm,
+            "nonelliptic_osculating_samples": int(np.count_nonzero(energy >= 0)),
+            "minimum_radius_m": float(radius.min()), "maximum_radius_m": float(radius.max()),
+            "maximum_speed_m_s": float(speed.max()),
+            "maximum_specific_orbital_energy_m2_s2": float(energy.max()),
+            "recoverable_only_during_trial": True,
+            "fitted_element_attribution": "not exported by native executable"}
 
 
