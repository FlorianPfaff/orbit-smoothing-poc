  "pitfalls_and_unlogged_guarantees": [
    {
      "id": "runtime_flags_inherited",
      "finding": "run_native inherits os.environ. Conditional nuisance defaults OFF; backend.evaluate does not set it. Freeze the audited runtime flags explicitly and reject or sanitize unreviewed ORBIT_POC_* variables; set single-thread library variables explicitly. Profile execution receipts do not contain the full inherited environment."
    },
    {
      "id": "initialization_not_recomputed_from_raw",
      "finding": "This fit reuses the exact preserved GNSS-only prepared/nominally closed orbit; it does not rerun code_bootstrap from raw retained observations. The preparation lineage is therefore essential. No point029 is used by NativeModel.initial_state."
    },
    {
      "id": "cold_not_zero_nuisance",
      "finding": "All physical disturbance coordinates start at zero. GNSS preprocessing creates nuisance starting values; cold means no imported fitted nuisance state, not zero every clock or ambiguity. Each evaluate call uses a private native directory and new GNSS process."
    },
    {
      "id": "fresh_finish_metrics_not_aggregate",
      "finding": "Final-covariance undamped correction metrics and gradient are checked in finish, but only earlier confirmation metrics appear in iterations.json. Recover final metrics from proposal-retention.json and independently recompute gradient/step from the final factor."
    },
    {
      "id": "covariance_files_before_acceptance",
      "finding": "Native computeCovarianceMatrix/writeResults occurs inside evaluate(covariance=True), before Python stale-covariance, PD and remaining-wall checks. Failed or timed-out fits may leave covariance files and even fit.npz; only complete terminal acceptance plus fresh evidence authorizes use."
    },
    {
      "id": "rank_and_no_nuisance_floor_not_global_stationarity",
      "finding": "Full rank and strict fixed-orbit nuisance convergence alone do not imply orbital convergence. Require fresh undamped physical correction and gradient checks; small damped proposals or budgets never count."
    },
    {
      "id": "representation_floor_not_all_step_gate",
      "finding": "For strict nuisance profiles, LM accepts positive actual reduction and gain ratio>1e-4 even if objective_reduction_numerically_resolved=false. That field is diagnostic; do not claim every accepted step exceeds the empirical physical repeat floor. Additional inexact-nuisance restrictions apply only to floor-limited profiles."
    },
    {
      "id": "resource_ownership_external",
      "finding": "run_native samples only its native parent and kills that direct process on timeout. Full process-tree RSS, child cleanup, current-boot ownership and serial admission are properties the new external supervisor must verify, not guarantees of backend.fit_job."
    },
    {
      "id": "forbidden_paths_not_security_sandbox",
      "finding": "fit_job rejects top-level truth/reference keys and preparation validates hashes, but these Python checks are not filesystem isolation. The approved blind namespace must still deny truth/reference/donor access and preserve original inputs read-only."
    }
  ],
