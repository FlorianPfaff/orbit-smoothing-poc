    "--- frozen extension\n",
    "+++ installed native\n",
    "@@ -251,5 +251,34 @@\n",
    "     out<<(synthetic ? \"[]\" : \"[\\\"thermal_history_sensitivities\\\",\\\"non_gravity_non_drag_force_gradients\\\",\\\"atmospheric_event_time_derivatives\\\"]\");",
